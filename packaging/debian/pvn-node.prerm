#!/bin/sh
set -eu

fail_removal() {
    echo "PVN package removal refused: $*" >&2
    echo "See /usr/share/doc/pvn-node/operations.md (Node removal)." >&2
    exit 1
}

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    # These checks are deliberately independent of pmxcfs. Losing or removing
    # the shared file must never turn an unsafe uninstall into a permitted one.
    [ ! -e /etc/pvn/node-enabled ] ||
        fail_removal "remove /etc/pvn/node-enabled after stopping the local PVN stack"
    [ ! -e /etc/pvn/central/enabled ] ||
        fail_removal "remove the central activation marker after leaving all Raft clusters"

    command -v systemctl >/dev/null 2>&1 ||
        fail_removal "systemctl is unavailable, so service state cannot be checked"
    systemctl show --property=Version --value >/dev/null 2>&1 ||
        fail_removal "the systemd manager is unavailable, so service state cannot be checked"

    for target in pvn-node.target pvn-central.target; do
        enable_state=$(systemctl is-enabled "$target" 2>/dev/null || true)
        case "$enable_state" in
            enabled|enabled-runtime|linked|linked-runtime|alias)
                fail_removal "disable $target before uninstalling"
                ;;
        esac
    done

    for unit in \
        pvn-node.target pvn-node-ready.service pvn-central.target \
        pvn-manager.service pvn-agent.service pvn-ovn-host-config.service \
        pvn-control-db.service pvn-ovn-db-listeners.service \
        pvn-ovn-northd-ready.service \
        ovn-controller.service ovn-ovsdb-server-nb.service \
        ovn-ovsdb-server-sb.service ovn-northd.service
    do
        active_state=$(systemctl is-active "$unit" 2>/dev/null || true)
        case "$active_state" in
            active|activating|reloading|deactivating)
                fail_removal "stop $unit before uninstalling"
                ;;
        esac
    done

    command -v ovs-vsctl >/dev/null 2>&1 ||
        fail_removal "ovs-vsctl is unavailable, so local bindings cannot be checked"
    if ! managed_interfaces=$(ovs-vsctl --timeout=10 --data=bare \
        --no-heading --columns=name find Interface \
        external_ids:managed-by=pvn 2>/dev/null); then
        fail_removal "OVS is unavailable, so local bindings cannot be checked"
    fi
    [ -z "$managed_interfaces" ] ||
        fail_removal "managed OVS interfaces remain: $managed_interfaces"

    if [ -x /usr/lib/pvn/pvn-compute-inject ] || \
        [ -x /usr/lib/pvn/pvn-api-inject ] || [ -x /usr/lib/pvn/pvn-ui-inject ]; then
        [ -x /usr/lib/pvn/pvn-pve-refresh ] || \
            fail_removal "PVE daemon refresh helper is unavailable"
        /usr/lib/pvn/pvn-pve-refresh --check
    fi
    [ ! -x /usr/lib/pvn/pvn-compute-inject ] || /usr/lib/pvn/pvn-compute-inject remove
    [ ! -x /usr/lib/pvn/pvn-api-inject ] || /usr/lib/pvn/pvn-api-inject remove
    [ ! -x /usr/lib/pvn/pvn-ui-inject ] || /usr/lib/pvn/pvn-ui-inject remove
    [ ! -x /usr/lib/pvn/pvn-pve-refresh ] || /usr/lib/pvn/pvn-pve-refresh
    systemctl disable --now pvn-central.target pvn-node.target >/dev/null 2>&1 || true
    systemctl stop pvn-node-ready.service pvn-agent.service pvn-manager.service pvn-ovn-host-config.service pvn-control-db.service pvn-ovn-db-listeners.service pvn-ovn-northd-ready.service ovn-controller.service >/dev/null 2>&1 || true
fi

exit 0
