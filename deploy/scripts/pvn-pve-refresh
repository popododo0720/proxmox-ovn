#!/bin/sh
set -eu

case "$#:${1:-}" in
    0:) check_only=false ;;
    1:--check) check_only=true ;;
    *) echo "usage: pvn-pve-refresh [--check]" >&2; exit 2 ;;
esac

proc_root=${PVN_PVE_REFRESH_PROC_ROOT:-/proc}

capture_active_generation() {
    unit=$1
    label=$2
    state=$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)
    [ "$state" = active ] || {
        echo "$label is not active and cannot be safely refreshed: ${state:-unknown}" >&2
        return 1
    }
    pid=$(systemctl show --property=MainPID --value "$unit") || return 1
    generation=$(systemctl show --property=ExecMainStartTimestampMonotonic --value \
        "$unit") || return 1
    case "$pid:$generation" in
        *[!0-9:]*|0:*|*:0|'':*)
            echo "$label has no stable process generation" >&2
            return 1
            ;;
    esac
    printf '%s:%s\n' "$pid" "$generation"
}

split_generation() {
    value=$1
    old_ifs=$IFS
    IFS=:
    set -- $value
    IFS=$old_ifs
    [ "$#" -eq 2 ] || return 1
    printf '%s\n%s\n' "$1" "$2"
}

capture_worker_generations() {
    master_pid=$1
    children_file="$proc_root/$master_pid/task/$master_pid/children"
    [ -r "$children_file" ] || return 1
    children=$(cat "$children_file") || return 1
    [ -n "$children" ] || return 1

    generations=
    for child_pid in $children; do
        case "$child_pid" in
            *[!0-9]*|0|'') continue ;;
        esac
        stat=$(cat "$proc_root/$child_pid/stat" 2>/dev/null) || continue
        # The comm field is parenthesized and may contain spaces. Strip it
        # before selecting ppid (field 4) and starttime (field 22).
        stat=${stat##*) }
        set -- $stat
        [ "$#" -ge 20 ] || continue
        [ "$2" = "$master_pid" ] || continue
        shift 19
        starttime=$1
        case "$starttime" in
            *[!0-9]*|0|'') continue ;;
        esac
        identity=$child_pid:$starttime
        if [ -n "$generations" ]; then
            generations="$generations
$identity"
        else
            generations=$identity
        fi
    done
    [ -n "$generations" ] || return 1
    printf '%s\n' "$generations"
}

worker_generation_count() {
    generations=$1
    count=0
    for unused in $generations; do
        count=$((count + 1))
    done
    printf '%s\n' "$count"
}

verify_new_generation() {
    unit=$1
    label=$2
    before_pid=$3
    before_generation=$4
    attempt=1
    while [ "$attempt" -le 20 ]; do
        state=$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)
        if [ "$state" = active ]; then
            after_pid=$(systemctl show --property=MainPID --value "$unit" 2>/dev/null || true)
            after_generation=$(systemctl show \
                --property=ExecMainStartTimestampMonotonic --value "$unit" 2>/dev/null || true)
            case "$after_pid:$after_generation" in
                *[!0-9:]*|0:*|*:0|'':*) ;;
                *)
                    if [ "$after_pid" != "$before_pid" ] && \
                        [ "$after_generation" -gt "$before_generation" ]; then
                        return 0
                    fi
                    ;;
            esac
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -le 20 ] && sleep 0.25
    done
    echo "$label did not enter a new active process generation" >&2
    return 1
}

verify_new_worker_generation() {
    unit=$1
    label=$2
    before_workers=$3
    before_count=$(worker_generation_count "$before_workers")
    attempt=1
    while [ "$attempt" -le 40 ]; do
        state=$(systemctl show --property=ActiveState --value "$unit" 2>/dev/null || true)
        if [ "$state" = active ]; then
            after_pid=$(systemctl show --property=MainPID --value "$unit" 2>/dev/null || true)
            case "$after_pid" in
                *[!0-9]*|0|'') ;;
                *)
                    after_workers=$(capture_worker_generations "$after_pid" 2>/dev/null || true)
                    new_count=0
                    for after_worker in $after_workers; do
                        existed=false
                        for before_worker in $before_workers; do
                            if [ "$after_worker" = "$before_worker" ]; then
                                existed=true
                                break
                            fi
                        done
                        [ "$existed" = true ] || new_count=$((new_count + 1))
                    done
                    if [ "$new_count" -ge "$before_count" ]; then
                        return 0
                    fi
                    ;;
            esac
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -le 40 ] && sleep 0.25
    done
    echo "$label did not enter a complete new active worker generation" >&2
    return 1
}

# Finish every read-only safety check before changing even one daemon
# generation. This prevents an inquorate or transitional HA node from ending
# with only part of the PVE worker set using the new lifecycle hooks.
pvedaemon_before=$(capture_active_generation pvedaemon.service pvedaemon)
pveproxy_before=$(capture_active_generation pveproxy.service pveproxy)
set -- $(split_generation "$pvedaemon_before")
pvedaemon_pid_before=$1
pvedaemon_workers_before=$(capture_worker_generations "$pvedaemon_pid_before") || {
    echo "pvedaemon has no stable active worker generation" >&2
    exit 1
}
set -- $(split_generation "$pveproxy_before")
pveproxy_pid_before=$1
pveproxy_workers_before=$(capture_worker_generations "$pveproxy_pid_before") || {
    echo "pveproxy has no stable active worker generation" >&2
    exit 1
}

lrm_state=$(systemctl show --property=ActiveState --value pve-ha-lrm.service 2>/dev/null || true)
lrm_refresh=false
lrm_before=
case "$lrm_state" in
    inactive) ;;
    active)
        pvecm_status=$(pvecm status 2>&1) || {
            echo "cannot prove PVE quorum before refreshing pve-ha-lrm: $pvecm_status" >&2
            exit 1
        }
        printf '%s\n' "$pvecm_status" | grep -Eq '^Quorate:[[:space:]]+Yes$' || {
            echo "refusing to refresh pve-ha-lrm without quorum" >&2
            exit 1
        }
        lrm_before=$(capture_active_generation pve-ha-lrm.service pve-ha-lrm)
        lrm_refresh=true
        ;;
    *)
        echo "pve-ha-lrm is not in a safely restartable state: ${lrm_state:-unknown}" >&2
        exit 1
        ;;
esac

[ "$check_only" = false ] || exit 0

if [ "$lrm_refresh" = true ]; then
    # HA is the start authority, so put it on the new fail-closed hook
    # generation before exposing the new API/UI workers.
    set -- $(split_generation "$lrm_before")
    lrm_pid_before=$1
    lrm_generation_before=$2
    systemctl restart pve-ha-lrm.service
    verify_new_generation pve-ha-lrm.service pve-ha-lrm \
        "$lrm_pid_before" "$lrm_generation_before"
fi

systemctl reload pvedaemon.service
verify_new_worker_generation pvedaemon.service pvedaemon \
    "$pvedaemon_workers_before"

systemctl reload pveproxy.service
verify_new_worker_generation pveproxy.service pveproxy \
    "$pveproxy_workers_before"
