# Package-stage inventory for the requested PVE cluster. pvn-cluster-install
# parses this file; it never sources it. Exactly one PVN_TARGET_NODES assignment
# is supported, and it must contain every PVE cluster member once.
#
# These are root SSH management destinations only. Pass a verified private key
# separately with --identity; password authentication is never used.
PVN_TARGET_NODES="192.168.0.78 192.168.0.80 192.168.0.126"

# Geneve/control addresses, MTU, routes, provider bridges, physical uplinks,
# VLAN policy, and gateways intentionally do not belong in this inventory.
# Discover and configure them in the later topology phase. The cluster
# installer never creates a bridge or auto-wires a provider uplink.
