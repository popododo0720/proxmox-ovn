# Local settings. Install as /etc/pvn/node.env on each PVE node.
# Values must not contain shell quoting; systemd parses this file directly.
PVN_NODE_NAME=pve-a
PVN_ENCAP_IP=10.0.1.11
PVN_NODE_ROLES=compute,gateway,central
# Reserved loopback readiness endpoint; keep these values unchanged.
PVN_HEALTH_LISTEN=127.0.0.1:9476
PVN_AGENT_HEALTH_URL=http://127.0.0.1:9476/healthz
