#!/usr/bin/python3
"""Fail-closed, rolling pvn-node package updater for a native PVE cluster."""

from __future__ import annotations

import argparse
import dataclasses
import fcntl
import hashlib
import ipaddress
import json
import os
import pathlib
import re
import secrets
import signal
import stat
import subprocess
import sys
import time
from typing import Iterable


PROGRAM = "pvn-cluster-update"
MEMBERS_PATH = pathlib.Path(os.environ.get("PVN_PVE_MEMBERS_FILE", "/etc/pve/.members"))
COROSYNC_PATH = pathlib.Path(os.environ.get("PVN_PVE_COROSYNC_CONF", "/etc/pve/corosync.conf"))
NODES_DIR = pathlib.Path(os.environ.get("PVN_PVE_NODES_DIR", "/etc/pve/nodes"))
IDENTITY = pathlib.Path(os.environ.get("PVN_PVE_IDENTITY", "/root/.ssh/id_rsa"))
PVECM = os.environ.get("PVN_PVECM_BIN", "pvecm")
SSH = os.environ.get("PVN_SSH_BIN", "ssh")
SCP = os.environ.get("PVN_SCP_BIN", "scp")
CP = os.environ.get("PVN_CP_BIN", "cp")
LOCAL_SH = os.environ.get("PVN_LOCAL_SH_BIN", "sh")
DPKG = os.environ.get("PVN_DPKG_BIN", "dpkg")
DPKG_DEB = os.environ.get("PVN_DPKG_DEB_BIN", "dpkg-deb")
SHA256SUM = os.environ.get("PVN_SHA256SUM_BIN", "sha256sum")
LEASE = os.environ.get("PVN_CLUSTER_LEASE_BIN", "/usr/lib/pvn/pvn-cluster-lease")
LOCK_PATH = pathlib.Path(os.environ.get("PVN_UPDATE_LOCK_FILE", "/run/lock/pvn-cluster-update.lock"))

SAFE_NAME = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?")
SAFE_VERSION = re.compile(r"[A-Za-z0-9.+:~_-]+")
SAFE_ARCH = re.compile(r"[A-Za-z0-9_-]+")
SAFE_SHA = re.compile(r"[0-9a-f]{64}")
PROJECTLESS_SCHEMA_FIRST_VERSION = "0.3.0"


class UpdateError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise UpdateError(message)


def command(
    arguments: list[str],
    *,
    input_text: str | None = None,
    check: bool = True,
    quiet: bool = False,
) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    try:
        result = subprocess.run(
            arguments,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            env=environment,
        )
    except OSError as error:
        fail(f"cannot execute {arguments[0]}: {error}")
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        fail(f"command failed ({arguments[0]}): {detail[-4000:]}")
    if not quiet and result.stderr:
        sys.stderr.write(result.stderr)
    return result


def secure_regular(path: pathlib.Path, label: str, mode_mask: int = 0o022) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        fail(f"cannot inspect {label}: {error}")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        fail(f"{label} must be a regular non-symlink file")
    if metadata.st_uid != 0:
        fail(f"{label} must be owned by root")
    if stat.S_IMODE(metadata.st_mode) & mode_mask:
        fail(f"{label} has unsafe write permissions")
    return metadata


def safe_name(value: object, label: str) -> str:
    if not isinstance(value, str) or not SAFE_NAME.fullmatch(value) or value in {".", ".."}:
        fail(f"{label} is unsafe or empty")
    return value


def safe_integer(value: object, label: str, minimum: int = 0) -> int:
    if type(value) is not int or value < minimum:
        fail(f"{label} is not a valid integer")
    return value


@dataclasses.dataclass(frozen=True)
class Node:
    node_id: int
    name: str
    address: str
    local: bool


@dataclasses.dataclass(frozen=True)
class Snapshot:
    mode: str
    deployment: str
    config_version: int
    local_name: str
    nodes: tuple[Node, ...]
    fingerprint: str


@dataclasses.dataclass(frozen=True)
class Probe:
    node: Node
    version: str
    architecture: str
    node_state: str
    central_state: str
    central_mode: str
    central_pids: str
    central_pending: str
    northd_role: str


@dataclasses.dataclass(frozen=True)
class EmbeddedCorosyncSnapshot:
    """Canonical all-node Corosync state proven without the installed pvnctl."""

    canonical: str
    package_version: str
    config_sha256: str | None
    config_version: int | None


def membership_fingerprint(mode: str, deployment: str, version: int, nodes: Iterable[Node]) -> str:
    records = [
        {"id": node.node_id, "ip": node.address, "name": node.name, "online": 1}
        for node in sorted(nodes, key=lambda item: (item.node_id, item.name))
    ]
    payload = {
        "cluster": deployment,
        "config_version": version,
        "mode": mode,
        "node_count": len(records),
        "nodes": records,
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def parse_status(output: str, pattern: str, label: str) -> str:
    matches = re.findall(pattern, output, re.MULTILINE)
    if len(matches) != 1:
        fail(f"pvecm status has an invalid {label} field")
    return matches[0]


def validate_host_pin(node: Node) -> None:
    path = NODES_DIR / node.name / "ssh_known_hosts"
    secure_regular(path, str(path))
    try:
        lines = [
            line.strip()
            for line in path.read_text(encoding="ascii").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except (OSError, UnicodeError) as error:
        fail(f"cannot read {path}: {error}")
    if not lines:
        fail(f"{path} contains no pinned host key")
    for line in lines:
        fields = line.split()
        if len(fields) < 3 or fields[0] != node.name:
            fail(f"{path} does not exclusively pin alias {node.name}")


def discover() -> Snapshot:
    secure_regular(MEMBERS_PATH, str(MEMBERS_PATH))
    try:
        data = json.loads(MEMBERS_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot parse {MEMBERS_PATH}: {error}")
    if not isinstance(data, dict):
        fail(".members root must be an object")
    local_name = safe_name(data.get("nodename"), ".members nodename")
    cluster = data.get("cluster")
    nodelist = data.get("nodelist")

    if isinstance(cluster, dict) and cluster.get("name"):
        secure_regular(COROSYNC_PATH, str(COROSYNC_PATH))
        mode = "cluster"
        deployment = safe_name(cluster.get("name"), "cluster name")
        config_version = safe_integer(cluster.get("version"), "cluster config version")
        node_count = safe_integer(cluster.get("nodes"), "cluster node count", 1)
        if safe_integer(cluster.get("quorate"), "cluster quorum state") != 1:
            fail("PVE cluster is not quorate")
        if not isinstance(nodelist, dict) or len(nodelist) != node_count:
            fail(".members nodelist count does not match cluster.nodes")
        if local_name not in nodelist:
            fail("local node is missing from .members nodelist")
        nodes: list[Node] = []
        seen_ids: set[int] = set()
        for name, member in nodelist.items():
            name = safe_name(name, "PVE node name")
            if not isinstance(member, dict):
                fail(f"node {name} record is not an object")
            node_id = safe_integer(member.get("id"), f"node {name} id", 1)
            if node_id in seen_ids:
                fail(f"duplicate PVE node id {node_id}")
            seen_ids.add(node_id)
            if safe_integer(member.get("online"), f"node {name} online state") != 1:
                fail(f"PVE node {name} is offline")
            raw_address = member.get("ip")
            if not isinstance(raw_address, str):
                fail(f"node {name} has no management IP")
            try:
                address = str(ipaddress.ip_address(raw_address))
            except ValueError:
                fail(f"node {name} has an invalid management IP")
            nodes.append(Node(node_id, name, address, name == local_name))

        status_result = command([PVECM, "status"], quiet=True)
        status = status_result.stdout
        if parse_status(status, r"^Name:\s+(\S+)\s*$", "name") != deployment:
            fail("pvecm cluster name differs from .members")
        if int(parse_status(status, r"^Nodes:\s+(\d+)\s*$", "node count")) != node_count:
            fail("pvecm node count differs from .members")
        if parse_status(status, r"^Quorate:\s+(Yes|No)\s*$", "quorum") != "Yes":
            fail("pvecm reports a non-quorate cluster")

        live_result = command([PVECM, "nodes"], quiet=True)
        live_members: dict[str, int] = {}
        local_markers: list[str] = []
        for line in live_result.stdout.splitlines():
            match = re.fullmatch(
                r"\s*(\d+)\s+\d+\s+([A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)(\s+\(local\))?\s*",
                line,
            )
            if not match:
                continue
            name = match.group(2)
            if name in live_members:
                fail(f"pvecm nodes repeats node {name}")
            live_members[name] = int(match.group(1))
            if match.group(3):
                local_markers.append(name)
        expected = {node.name: node.node_id for node in nodes}
        if live_members != expected:
            fail("pvecm live membership differs from .members")
        if local_markers != [local_name]:
            fail("pvecm local node marker differs from .members nodename")
        for node in nodes:
            if not node.local:
                validate_host_pin(node)
    else:
        if COROSYNC_PATH.exists():
            fail("corosync.conf exists but .members has no cluster")
        mode = "standalone"
        deployment = f"standalone-{local_name}"
        config_version = 0
        if nodelist is None:
            nodes = [Node(0, local_name, "local", True)]
        else:
            if not isinstance(nodelist, dict) or set(nodelist) != {local_name}:
                fail("standalone .members must contain only the local node")
            member = nodelist[local_name]
            if not isinstance(member, dict):
                fail("standalone local node record is not an object")
            node_id = safe_integer(member.get("id", 0), "standalone node id")
            if safe_integer(member.get("online", 1), "standalone online state") != 1:
                fail("standalone local node is offline")
            address = member.get("ip", "local")
            if address != "local":
                if not isinstance(address, str):
                    fail("standalone node IP is invalid")
                try:
                    address = str(ipaddress.ip_address(address))
                except ValueError:
                    fail("standalone node IP is invalid")
            nodes = [Node(node_id, local_name, address, True)]
        if command([PVECM, "status"], check=False, quiet=True).returncode == 0:
            fail("pvecm status succeeded although .members reports standalone mode")

    nodes.sort(key=lambda item: (item.node_id, item.name))
    fingerprint = membership_fingerprint(mode, deployment, config_version, nodes)
    return Snapshot(mode, deployment, config_version, local_name, tuple(nodes), fingerprint)


def revalidate(expected: Snapshot) -> None:
    current = discover()
    if current != expected:
        fail("PVE membership or cluster configuration version changed during the update")


def validate_identity() -> None:
    metadata = secure_regular(IDENTITY, str(IDENTITY), mode_mask=0o077)
    if stat.S_IMODE(metadata.st_mode) not in {0o400, 0o600}:
        fail(f"PVE SSH identity mode must be 0400 or 0600: {IDENTITY}")


REMOTE_SCRIPT = r'''set -eu
export LC_ALL=C

remote_fail() {
    echo "PVN rolling update precondition failed: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || remote_fail "required command is unavailable: $1"
}

membership_record() {
    python3 - <<'PVN_MEMBERS'
import hashlib
import ipaddress
import json
import os
import pathlib
import re
import stat
import subprocess

def stop(message):
    print(f"PVN remote membership check failed: {message}", file=__import__('sys').stderr)
    raise SystemExit(1)

path = pathlib.Path(os.environ.get("PVN_PVE_MEMBERS_FILE", "/etc/pve/.members"))
try:
    metadata = path.lstat()
except OSError as error:
    stop(f"cannot inspect {path}: {error}")
if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
    stop(f"{path} is not a regular non-symlink file")
if metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022:
    stop(f"{path} has unsafe ownership or permissions")
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception as error:
    stop(f"cannot parse {path}: {error}")
safe = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?")
name = data.get("nodename")
if not isinstance(name, str) or not safe.fullmatch(name) or name in {".", ".."}:
    stop("unsafe nodename")
cluster = data.get("cluster")
nodelist = data.get("nodelist")
nodes = []
if isinstance(cluster, dict) and cluster.get("name"):
    mode = "cluster"
    deployment = cluster.get("name")
    version = cluster.get("version")
    count = cluster.get("nodes")
    if not isinstance(deployment, str) or not safe.fullmatch(deployment):
        stop("unsafe cluster name")
    if type(version) is not int or version < 0 or type(count) is not int or count < 1:
        stop("invalid cluster version or node count")
    if cluster.get("quorate") != 1 or not isinstance(nodelist, dict) or len(nodelist) != count:
        stop("cluster is not quorate or membership count is invalid")
    if name not in nodelist:
        stop("local node is absent from membership")
    seen = set()
    for node_name, member in nodelist.items():
        if not isinstance(node_name, str) or not safe.fullmatch(node_name) or not isinstance(member, dict):
            stop("unsafe node record")
        node_id = member.get("id")
        if type(node_id) is not int or node_id < 1 or node_id in seen or member.get("online") != 1:
            stop("invalid, duplicate, or offline node")
        seen.add(node_id)
        try:
            address = str(ipaddress.ip_address(member.get("ip")))
        except (TypeError, ValueError):
            stop("invalid node management IP")
        nodes.append({"id": node_id, "ip": address, "name": node_name, "online": 1})
    status = subprocess.run([os.environ.get("PVN_PVECM_BIN", "pvecm"), "status"], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if status.returncode != 0:
        stop("pvecm status failed")
    def field(pattern, label):
        values = re.findall(pattern, status.stdout, re.MULTILINE)
        if len(values) != 1:
            stop(f"pvecm status has invalid {label}")
        return values[0]
    if field(r"^Name:\s+(\S+)\s*$", "name") != deployment:
        stop("pvecm cluster name differs")
    if int(field(r"^Nodes:\s+(\d+)\s*$", "node count")) != count:
        stop("pvecm node count differs")
    if field(r"^Quorate:\s+(Yes|No)\s*$", "quorum") != "Yes":
        stop("pvecm reports non-quorate")
    local_id = nodelist[name].get("id")
else:
    mode = "standalone"
    deployment = f"standalone-{name}"
    version = 0
    if nodelist is None:
        local_id = 0
        address = "local"
    else:
        if not isinstance(nodelist, dict) or set(nodelist) != {name}:
            stop("invalid standalone membership")
        member = nodelist[name]
        if not isinstance(member, dict) or member.get("online", 1) != 1:
            stop("invalid standalone node")
        local_id = member.get("id", 0)
        address = member.get("ip", "local")
        if address != "local":
            try:
                address = str(ipaddress.ip_address(address))
            except (TypeError, ValueError):
                stop("invalid standalone IP")
    if type(local_id) is not int or local_id < 0:
        stop("invalid standalone node ID")
    count = 1
    nodes.append({"id": local_id, "ip": address, "name": name, "online": 1})
    status = subprocess.run([os.environ.get("PVN_PVECM_BIN", "pvecm"), "status"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if status.returncode == 0:
        stop("pvecm status succeeded in standalone mode")
nodes.sort(key=lambda item: (item["id"], item["name"]))
payload = {"cluster": deployment, "config_version": version, "mode": mode,
           "node_count": len(nodes), "nodes": nodes}
fingerprint = hashlib.sha256(json.dumps(payload, sort_keys=True,
                             separators=(",", ":")).encode()).hexdigest()
print("|".join((mode, deployment, str(version), str(count), name,
                str(local_id), fingerprint)))
PVN_MEMBERS
}

unit_active() {
    systemctl is-active "$1" 2>/dev/null || true
}

unit_enabled() {
    systemctl is-enabled "$1" 2>/dev/null || true
}

require_active() {
    [ "$(unit_active "$1")" = active ] || remote_fail "$1 is not active"
}

require_inactive() {
    pvn_state=$(unit_active "$1")
    case "$pvn_state" in inactive) ;; *) remote_fail "$1 must be inactive, found ${pvn_state:-unknown}" ;; esac
}

require_enabled() {
    pvn_state=$(unit_enabled "$1")
    case "$pvn_state" in enabled|enabled-runtime|linked|linked-runtime|alias) ;;
        *) remote_fail "$1 is active but not enabled" ;;
    esac
}

require_disabled() {
    pvn_state=$(unit_enabled "$1")
    case "$pvn_state" in disabled|masked|static|indirect) ;;
        *) remote_fail "$1 must not be enabled, found ${pvn_state:-unknown}" ;;
    esac
}

config_digest() {
    python3 - <<'PVN_CONFIG_DIGEST'
import hashlib
import os
import pathlib
import stat

digest = hashlib.sha256()
roots = [pathlib.Path("/etc/pvn"), pathlib.Path("/etc/pve/pvn/config.json")]
paths = []
for root in roots:
    if not root.exists() and not root.is_symlink():
        continue
    if root.is_dir() and not root.is_symlink():
        paths.extend(sorted(root.rglob("*"), key=lambda item: str(item)))
        paths.append(root)
    else:
        paths.append(root)
for path in sorted(set(paths), key=lambda item: str(item)):
    metadata = path.lstat()
    relative = str(path).encode()
    digest.update(len(relative).to_bytes(8, "big"))
    digest.update(relative)
    digest.update(str(stat.S_IMODE(metadata.st_mode)).encode())
    digest.update(str(metadata.st_uid).encode())
    digest.update(str(metadata.st_gid).encode())
    if stat.S_ISREG(metadata.st_mode):
        with path.open("rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
    elif stat.S_ISLNK(metadata.st_mode):
        digest.update(os.readlink(path).encode())
    elif not stat.S_ISDIR(metadata.st_mode):
        raise SystemExit(f"unsupported persistent configuration object: {path}")
print(digest.hexdigest())
PVN_CONFIG_DIGEST
}

central_restart_marker() {
    python3 - <<'PVN_CENTRAL_RESTART_MARKER'
import os
import pathlib
import stat

directory = pathlib.Path("/var/lib/pvn-node")
marker = directory / "central-restart-pending"
max_bytes = 256

def validate_directory(metadata):
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise SystemExit(f"{directory} must be a real directory")
    if metadata.st_uid != 0 or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700:
        raise SystemExit(f"{directory} must be root:root mode 0700")

def validate_marker(metadata):
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise SystemExit(f"{marker} must be a regular non-symlink file")
    if metadata.st_nlink != 1:
        raise SystemExit(f"{marker} must have exactly one hard link")
    if metadata.st_uid != 0 or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(f"{marker} must be root:root mode 0600")
    if metadata.st_size > max_bytes:
        raise SystemExit(f"{marker} exceeds {max_bytes} bytes")

try:
    directory_before = directory.lstat()
except FileNotFoundError:
    print("none")
    raise SystemExit(0)
except OSError as error:
    raise SystemExit(f"cannot inspect {directory}: {error}")
validate_directory(directory_before)
directory_identity = (directory_before.st_dev, directory_before.st_ino)
directory_flags = os.O_RDONLY | os.O_CLOEXEC
if hasattr(os, "O_DIRECTORY"):
    directory_flags |= os.O_DIRECTORY
if hasattr(os, "O_NOFOLLOW"):
    directory_flags |= os.O_NOFOLLOW
try:
    directory_descriptor = os.open(directory, directory_flags)
except OSError as error:
    raise SystemExit(f"cannot open {directory}: {error}")
try:
    directory_opened = os.fstat(directory_descriptor)
    validate_directory(directory_opened)
    if (directory_opened.st_dev, directory_opened.st_ino) != directory_identity:
        raise SystemExit(f"{directory} changed identity")
    try:
        marker_before = os.stat(
            marker.name,
            dir_fd=directory_descriptor,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        directory_after_missing = directory.lstat()
        validate_directory(directory_after_missing)
        if (directory_after_missing.st_dev, directory_after_missing.st_ino) != directory_identity:
            raise SystemExit(f"{directory} changed identity")
        print("none")
        raise SystemExit(0)
    except OSError as error:
        raise SystemExit(f"cannot inspect {marker}: {error}")
    validate_marker(marker_before)
    marker_identity = (marker_before.st_dev, marker_before.st_ino)
    marker_flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        marker_flags |= os.O_NOFOLLOW
    try:
        marker_descriptor = os.open(
            marker.name,
            marker_flags,
            dir_fd=directory_descriptor,
        )
    except OSError as error:
        raise SystemExit(f"cannot open {marker}: {error}")
    try:
        marker_opened = os.fstat(marker_descriptor)
        validate_marker(marker_opened)
        if (marker_opened.st_dev, marker_opened.st_ino) != marker_identity:
            raise SystemExit(f"{marker} changed identity")
        chunks = []
        size = 0
        while True:
            chunk = os.read(marker_descriptor, min(4096, max_bytes + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > max_bytes:
                raise SystemExit(f"{marker} exceeds {max_bytes} bytes")
        marker_after = os.stat(
            marker.name,
            dir_fd=directory_descriptor,
            follow_symlinks=False,
        )
        validate_marker(marker_after)
        if (marker_after.st_dev, marker_after.st_ino) != marker_identity:
            raise SystemExit(f"{marker} changed while being read")
    except OSError as error:
        raise SystemExit(f"cannot read {marker}: {error}")
    finally:
        os.close(marker_descriptor)
    path_after = marker.lstat()
    directory_after = directory.lstat()
    validate_marker(path_after)
    validate_directory(directory_after)
    if (path_after.st_dev, path_after.st_ino) != marker_identity:
        raise SystemExit(f"{marker} path changed identity")
    if (directory_after.st_dev, directory_after.st_ino) != directory_identity:
        raise SystemExit(f"{directory} changed identity")
finally:
    os.close(directory_descriptor)
try:
    raw = b"".join(chunks).decode("ascii")
except UnicodeError as error:
    raise SystemExit(f"cannot decode {marker}: {error}")
lines = raw.splitlines()
if len(lines) != 1 or raw != lines[0] + "\n":
    raise SystemExit(f"{marker} must contain exactly one version line")
version = lines[0]
allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.+:~_-")
if not version or any(character not in allowed for character in version):
    raise SystemExit(f"{marker} contains an unsafe version")
print(version)
PVN_CENTRAL_RESTART_MARKER
}

central_configured_mode() {
    python3 - <<'PVN_CENTRAL_CONFIGURED_MODE'
import grp
import pathlib
import re
import stat

key_pattern = re.compile(r"^[A-Z][A-Z0-9_]*$")
pvn_gid = grp.getgrnam("pvn").gr_gid

def environment(path_text):
    path = pathlib.Path(path_text)
    metadata = path.lstat()
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise SystemExit(f"{path} must be a regular non-symlink file")
    if metadata.st_uid != 0 or metadata.st_gid != pvn_gid or stat.S_IMODE(metadata.st_mode) != 0o640:
        raise SystemExit(f"{path} must be root:pvn mode 0640")
    try:
        lines = path.read_text(encoding="ascii").splitlines()
    except (OSError, UnicodeError) as error:
        raise SystemExit(f"cannot read {path}: {error}")
    values = {}
    for line in lines:
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise SystemExit(f"{path} contains an invalid environment line")
        key, value = line.split("=", 1)
        if not key_pattern.fullmatch(key) or key in values:
            raise SystemExit(f"{path} contains an invalid or duplicate key")
        values[key] = value
    return values

control = environment("/etc/pvn/central/control-db.env").get("PVN_CONTROL_MODE")
ovn = environment("/etc/pvn/central/ovn-central.env").get("PVN_OVN_BOOTSTRAP")
if control == "standalone" and ovn == "standalone":
    print("standalone")
elif control == "raft" and ovn in {"seed", "join"}:
    print("raft")
else:
    raise SystemExit(f"central mode drift: PVN_CONTROL_MODE={control!r}, PVN_OVN_BOOTSTRAP={ovn!r}")
PVN_CENTRAL_CONFIGURED_MODE
}

verify_central_database_file() {
    pvn_database=$1
    pvn_expected_name=$2
    pvn_expected_mode=$3
    [ -f "$pvn_database" ] && [ ! -L "$pvn_database" ] ||
        remote_fail "central database is missing or unsafe: $pvn_database"
    pvn_actual_name=$(/usr/bin/ovsdb-tool db-name "$pvn_database") ||
        remote_fail "cannot read central database identity: $pvn_database"
    [ "$pvn_actual_name" = "$pvn_expected_name" ] ||
        remote_fail "central database identity drift at $pvn_database"
    case "$pvn_expected_mode" in
        standalone)
            /usr/bin/ovsdb-tool db-is-standalone "$pvn_database" ||
                remote_fail "central database mode drift (expected standalone): $pvn_database"
            ;;
        raft)
            /usr/bin/ovsdb-tool db-is-clustered "$pvn_database" ||
                remote_fail "central database mode drift (expected Raft): $pvn_database"
            ;;
        *) remote_fail "unsupported central database mode: $pvn_expected_mode" ;;
    esac
}

standalone_database_health() {
    pvn_socket=$1
    pvn_expected_name=$2
    [ -S "$pvn_socket" ] && [ ! -L "$pvn_socket" ] ||
        remote_fail "standalone database socket is missing or unsafe: $pvn_socket"
    pvn_schema=$(/usr/bin/ovsdb-client --timeout=10 get-schema "unix:$pvn_socket" "$pvn_expected_name") ||
        remote_fail "standalone database is unavailable on $pvn_socket"
    printf '%s\n' "$pvn_schema" | python3 -c '
import json, sys
expected = sys.argv[1]
try:
    schema = json.load(sys.stdin)
except (OSError, ValueError) as error:
    raise SystemExit(f"invalid schema response for {expected}: {error}")
if schema.get("name") != expected or not isinstance(schema.get("tables"), dict):
    raise SystemExit(f"database identity drift: expected {expected!r}")
' "$pvn_expected_name" || remote_fail "standalone database identity check failed on $pvn_socket"
}

active_central_health() {
    pvn_central_mode=$(central_configured_mode) ||
        remote_fail "central mode configuration is missing, unsafe, or inconsistent"
    verify_central_database_file /var/lib/pvn/control-db/pvn_control.db PVN_Control "$pvn_central_mode"
    verify_central_database_file /var/lib/ovn/ovnnb_db.db OVN_Northbound "$pvn_central_mode"
    verify_central_database_file /var/lib/ovn/ovnsb_db.db OVN_Southbound "$pvn_central_mode"
    case "$pvn_central_mode" in
        raft)
            /usr/sbin/pvnctl central status >/dev/null ||
                remote_fail "local Raft health check failed"
            ;;
        standalone)
            standalone_database_health /run/pvn-control/pvn-control-db.sock PVN_Control
            standalone_database_health /run/ovn/ovnnb_db.sock OVN_Northbound
            standalone_database_health /run/ovn/ovnsb_db.sock OVN_Southbound
            ;;
        *) remote_fail "unsupported active central mode: $pvn_central_mode" ;;
    esac
    pvn_northd_status=$(/usr/bin/timeout 10 /usr/bin/ovn-appctl -t ovn-northd status) ||
        remote_fail "cannot read the local northd active/standby role"
    case "$pvn_northd_status" in
        'Status: active') pvn_northd_role=active ;;
        'Status: standby') pvn_northd_role=standby ;;
        *) remote_fail "local northd returned an invalid active/standby role" ;;
    esac
    # A newly unpacked helper must not force an implicit northd restart before
    # the package/schema repin.  While the durable marker is present the old
    # central PIDs are deliberately preserved; the quorum-safe restart runs
    # the systemd readiness gate.  Once no restart is pending, every probe
    # requires clustered NB/SB connectivity and exact cfg synchronization.
    if [ -x /usr/lib/pvn/pvn-ovn-northd ]; then
        pvn_northd_pending=$(central_restart_marker) ||
            remote_fail "central restart marker is unsafe"
        if [ "$pvn_northd_pending" = none ]; then
            /usr/lib/pvn/pvn-ovn-northd status >/dev/null ||
                remote_fail "northd clustered endpoint health check failed"
        fi
    fi
}

embedded_corosync_snapshot() {
    python3 - <<'PVN_EMBEDDED_COROSYNC'
import hashlib
import ipaddress
import json
import os
import pathlib
import re
import selectors
import stat
import subprocess
import sys
import time

MAX_FILE = 4 * 1024 * 1024
MAX_OUTPUT = 4 * 1024 * 1024
SAFE_NAME = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?")
SAFE_VERSION = re.compile(r"[A-Za-z0-9.+:~_-]+")
MEMBERS_PATH = pathlib.Path(
    os.environ.get("PVN_PVE_MEMBERS_FILE", "/etc/pve/.members")
)
COROSYNC_PATH = pathlib.Path(
    os.environ.get("PVN_PVE_COROSYNC_CONF", "/etc/pve/corosync.conf")
)
PVECM = os.environ.get("PVN_PVECM_BIN", "pvecm")
CFGTOOL = os.environ.get("PVN_COROSYNC_CFGTOOL_BIN", "corosync-cfgtool")
CMAPCTL = os.environ.get("PVN_COROSYNC_CMAPCTL_BIN", "corosync-cmapctl")
SYSTEMCTL = os.environ.get("PVN_SYSTEMCTL_BIN", "systemctl")
DPKG_QUERY = os.environ.get("PVN_DPKG_QUERY_BIN", "dpkg-query")


def stop(message):
    print(
        "PVN embedded Corosync preflight failed: " + str(message),
        file=sys.stderr,
    )
    raise SystemExit(1)


def run(arguments, *, check=True, timeout=20):
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    try:
        process = subprocess.Popen(
            arguments,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
        )
    except OSError as error:
        stop("cannot execute %s: %s" % (arguments[0], error))

    selector = selectors.DefaultSelector()
    buffers = {"stdout": [], "stderr": []}
    sizes = {"stdout": 0, "stderr": 0}
    deadline = time.monotonic() + timeout
    failure = None
    try:
        for label, pipe in (("stdout", process.stdout), ("stderr", process.stderr)):
            if pipe is None:
                stop("cannot capture %s from %s" % (label, arguments[0]))
            os.set_blocking(pipe.fileno(), False)
            selector.register(pipe, selectors.EVENT_READ, label)

        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                failure = "%s timed out" % arguments[0]
                break
            for key, _ in selector.select(min(remaining, 0.25)):
                label = key.data
                try:
                    chunk = os.read(key.fileobj.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                sizes[label] += len(chunk)
                if sizes[label] > MAX_OUTPUT:
                    failure = "%s returned unbounded %s" % (arguments[0], label)
                    break
                buffers[label].append(chunk)
            if failure is not None:
                break

        if failure is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                failure = "%s timed out" % arguments[0]
            else:
                try:
                    returncode = process.wait(timeout=remaining)
                except subprocess.TimeoutExpired:
                    failure = "%s timed out" % arguments[0]

        if failure is not None:
            if process.poll() is None:
                process.kill()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
            stop(failure)

        try:
            stdout = b"".join(buffers["stdout"]).decode("utf-8")
            stderr = b"".join(buffers["stderr"]).decode("utf-8")
        except UnicodeDecodeError:
            stop("%s returned non-UTF-8 output" % arguments[0])
        result = subprocess.CompletedProcess(arguments, returncode, stdout, stderr)
        if check and result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().replace("\n", "; ")
            stop("%s failed: %s" % (arguments[0], detail[-800:] or result.returncode))
        return result
    finally:
        selector.close()
        if process.poll() is None:
            process.kill()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
        for pipe in (process.stdout, process.stderr):
            if pipe is not None:
                pipe.close()


def secure_read(path, label, *, optional=False):
    try:
        path_metadata = path.lstat()
    except FileNotFoundError:
        if optional:
            return None
        stop("%s is missing" % label)
    except OSError as error:
        stop("cannot inspect %s: %s" % (label, error))
    if stat.S_ISLNK(path_metadata.st_mode) or not stat.S_ISREG(path_metadata.st_mode):
        stop("%s must be a regular non-symlink file" % label)
    if path_metadata.st_uid != 0 or stat.S_IMODE(path_metadata.st_mode) & 0o022 or \
            path_metadata.st_nlink != 1:
        stop("%s has unsafe ownership or permissions" % label)
    if path_metadata.st_size < 0 or path_metadata.st_size > MAX_FILE:
        stop("%s exceeds the bounded size" % label)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        stop("cannot securely open %s: %s" % (label, error))
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or \
                stat.S_IMODE(before.st_mode) & 0o022 or before.st_nlink != 1:
            stop("%s changed to an unsafe opened file" % label)
        chunks = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(65536, MAX_FILE + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > MAX_FILE:
                stop("%s exceeds the bounded size" % label)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    identity = lambda value: (
        value.st_dev,
        value.st_ino,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
        value.st_uid,
        value.st_gid,
        value.st_nlink,
        stat.S_IMODE(value.st_mode),
    )
    if identity(before) != identity(after) or before.st_dev != path_metadata.st_dev or \
            before.st_ino != path_metadata.st_ino:
        stop("%s changed while it was read" % label)
    return b"".join(chunks)


def safe_name(value, label):
    if not isinstance(value, str) or not SAFE_NAME.fullmatch(value) or value in {".", ".."}:
        stop("%s is unsafe" % label)
    return value


def canonical_ipv4(value, label):
    try:
        address = ipaddress.ip_address(value)
    except (TypeError, ValueError):
        stop("%s is not an IPv4 address" % label)
    if not isinstance(address, ipaddress.IPv4Address) or address.is_unspecified or address.is_multicast:
        stop("%s is not a usable IPv4 address" % label)
    result = str(address)
    if result != value:
        stop("%s is not canonical" % label)
    return result


def package_version():
    status = run([DPKG_QUERY, "-W", "-f=${db:Status-Status}", "corosync"]).stdout.strip()
    if status != "installed":
        stop("corosync package is not completely installed")
    version = run([DPKG_QUERY, "-W", "-f=${Version}", "corosync"]).stdout.strip()
    if not SAFE_VERSION.fullmatch(version):
        stop("corosync package version is unsafe")
    return version


members_raw = secure_read(MEMBERS_PATH, "/etc/pve/.members")
try:
    members_document = json.loads(members_raw.decode("utf-8"))
except (UnicodeError, json.JSONDecodeError) as error:
    stop("cannot parse /etc/pve/.members: %s" % error)
if not isinstance(members_document, dict):
    stop("/etc/pve/.members root must be an object")
local_name = safe_name(members_document.get("nodename"), "local nodename")
view_version = members_document.get("version")
if type(view_version) is not int or view_version < 0:
    stop("membership view version is invalid")
cluster = members_document.get("cluster")
nodelist = members_document.get("nodelist")
nodes = []

if isinstance(cluster, dict) and cluster.get("name"):
    mode = "cluster"
    deployment = safe_name(cluster.get("name"), "cluster name")
    membership_config_version = cluster.get("version")
    node_count = cluster.get("nodes")
    if type(membership_config_version) is not int or membership_config_version < 0:
        stop("cluster config version is invalid")
    if type(node_count) is not int or node_count < 1 or cluster.get("quorate") != 1:
        stop("cluster is not fully quorate")
    if not isinstance(nodelist, dict) or len(nodelist) != node_count or local_name not in nodelist:
        stop("cluster nodelist is incomplete")
    seen_ids = set()
    for raw_name, member in nodelist.items():
        name = safe_name(raw_name, "PVE node name")
        if not isinstance(member, dict):
            stop("node %s membership is malformed" % name)
        node_id = member.get("id")
        if type(node_id) is not int or node_id <= 0 or node_id in seen_ids:
            stop("node %s has an invalid or duplicate ID" % name)
        if member.get("online") != 1:
            stop("node %s is not online" % name)
        seen_ids.add(node_id)
        address = canonical_ipv4(member.get("ip"), "node %s management IP" % name)
        nodes.append({"id": node_id, "ip": address, "name": name, "online": 1})
    nodes.sort(key=lambda value: (value["id"], value["name"]))
    status = run([PVECM, "status"]).stdout

    def status_field(pattern, label):
        matches = re.findall(pattern, status, re.MULTILINE)
        if len(matches) != 1:
            stop("pvecm status has an invalid %s" % label)
        return matches[0]

    if status_field(r"^Name:\s+(\S+)\s*$", "name") != deployment or \
            int(status_field(r"^Nodes:\s+(\d+)\s*$", "node count")) != node_count or \
            status_field(r"^Quorate:\s+(Yes|No)\s*$", "quorum") != "Yes":
        stop("pvecm status differs from /etc/pve/.members")
    live_nodes = {}
    local_markers = []
    for line in run([PVECM, "nodes"]).stdout.splitlines():
        match = re.fullmatch(
            r"\s*(\d+)\s+\d+\s+([A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)(\s+\(local\))?\s*",
            line,
        )
        if not match:
            continue
        name = match.group(2)
        if name in live_nodes:
            stop("pvecm nodes repeats %s" % name)
        live_nodes[name] = int(match.group(1))
        if match.group(3):
            local_markers.append(name)
    if live_nodes != {node["name"]: node["id"] for node in nodes} or local_markers != [local_name]:
        stop("pvecm live membership differs from /etc/pve/.members")
else:
    if cluster is not None:
        stop("standalone membership contains malformed cluster state")
    mode = "standalone"
    deployment = "standalone-" + local_name
    membership_config_version = 0
    if nodelist is None:
        local_id = 0
        local_address = "local"
    else:
        if not isinstance(nodelist, dict) or set(nodelist) != {local_name}:
            stop("standalone membership contains a foreign node")
        member = nodelist[local_name]
        if not isinstance(member, dict) or member.get("online", 1) != 1:
            stop("standalone local membership is malformed")
        local_id = member.get("id", 0)
        local_address = member.get("ip", "local")
        if local_address != "local":
            local_address = canonical_ipv4(local_address, "standalone management IP")
    if type(local_id) is not int or local_id != 0:
        stop("standalone node ID must be 0")
    nodes = [{"id": 0, "ip": local_address, "name": local_name, "online": 1}]
    if run([PVECM, "status"], check=False).returncode == 0:
        stop("pvecm status succeeded in standalone mode")

local_rows = [node for node in nodes if node["name"] == local_name]
if len(local_rows) != 1:
    stop("membership has no unique local node")
local_node_id = local_rows[0]["id"]
membership_payload = {
    "cluster": deployment,
    "config_version": membership_config_version,
    "mode": mode,
    "node_count": len(nodes),
    "nodes": nodes,
}
membership_fingerprint = hashlib.sha256(
    json.dumps(membership_payload, sort_keys=True, separators=(",", ":")).encode()
).hexdigest()
corosync_package = package_version()

if mode == "standalone":
    if secure_read(COROSYNC_PATH, "/etc/pve/corosync.conf", optional=True) is not None:
        stop("standalone node unexpectedly has corosync.conf")
    if run([SYSTEMCTL, "is-active", "--quiet", "corosync.service"], check=False).returncode == 0:
        stop("standalone node unexpectedly has an active Corosync service")
    if run([CFGTOOL, "-s"], check=False).returncode == 0:
        stop("standalone node unexpectedly exposes Corosync link runtime")
    if run([CMAPCTL], check=False).returncode == 0:
        stop("standalone node unexpectedly exposes Corosync cmap runtime")
    corosync_summary = None
else:
    config_raw = secure_read(COROSYNC_PATH, "/etc/pve/corosync.conf")
    try:
        config_text = config_raw.decode("utf-8").replace("\r\n", "\n")
    except UnicodeError as error:
        stop("corosync.conf is not valid UTF-8: %s" % error)
    cluster_names = re.findall(r"^\s*cluster_name:\s*(\S+)\s*$", config_text, re.MULTILINE)
    versions = re.findall(r"^\s*config_version:\s*(\d+)\s*$", config_text, re.MULTILINE)
    if cluster_names != [deployment] or len(versions) != 1:
        stop("corosync.conf cluster identity/config_version is invalid")
    config_version = int(versions[0])
    if config_version != membership_config_version:
        stop("corosync.conf config_version differs from PVE membership")
    node_starts = re.findall(r"^\s*node\s*\{", config_text, re.MULTILINE)
    node_blocks = re.findall(r"(?ms)^\s*node\s*\{.*?^\s*\}\s*$", config_text)
    if not node_blocks or len(node_blocks) != len(node_starts):
        stop("corosync.conf node blocks are malformed")
    configured = {}
    configured_ids = set()
    expected_by_name = {node["name"]: node for node in nodes}
    for block in node_blocks:
        names = re.findall(r"^\s*name:\s*(\S+)\s*$", block, re.MULTILINE)
        ids = re.findall(r"^\s*nodeid:\s*(\d+)\s*$", block, re.MULTILINE)
        if len(names) != 1 or len(ids) != 1:
            stop("each corosync.conf node needs one name and nodeid")
        name = safe_name(names[0], "corosync node name")
        node_id = int(ids[0])
        if name in configured or node_id <= 0 or node_id in configured_ids:
            stop("corosync.conf repeats a node name or ID")
        if name not in expected_by_name or expected_by_name[name]["id"] != node_id:
            stop("corosync.conf node identity differs from PVE membership")
        rings = {}
        for raw_ring, raw_address in re.findall(
            r"^\s*ring(\d+)_addr:\s*(\S+)\s*$", block, re.MULTILINE
        ):
            ring = int(raw_ring)
            if ring < 0 or ring > 7 or str(ring) in rings:
                stop("corosync.conf contains an invalid or duplicate KNET ring")
            if raw_address != name:
                canonical_ipv4(raw_address, "corosync ring address for %s" % name)
            rings[str(ring)] = raw_address
        if not rings:
            stop("corosync.conf node %s has no KNET ring" % name)
        configured[name] = {"name": name, "node_id": node_id, "rings": rings}
        configured_ids.add(node_id)
    if set(configured) != set(expected_by_name):
        stop("corosync.conf nodes differ from PVE membership")
    expected_rings = set(next(iter(configured.values()))["rings"])
    if not expected_rings or any(set(row["rings"]) != expected_rings for row in configured.values()):
        stop("corosync.conf KNET rings do not cover every node")

    def normalized_address(value, node_name):
        if value == node_name:
            return expected_by_name[node_name]["ip"]
        try:
            address = ipaddress.ip_address(value)
        except (TypeError, ValueError):
            stop("runtime ring address %r is neither an IP nor node name" % value)
        if not isinstance(address, ipaddress.IPv4Address):
            stop("runtime ring address is not IPv4")
        return str(address)

    def same_address(actual, expected, node_name):
        return normalized_address(actual, node_name) == normalized_address(expected, node_name)

    cmap_output = run([CMAPCTL]).stdout
    cfgtool_output = run([CFGTOOL, "-s"]).stdout
    values = {}
    for line in cmap_output.splitlines():
        match = re.match(r"^([A-Za-z0-9_.]+)\s+\([^)]+\)\s*=\s*(.*)$", line.strip())
        if not match:
            continue
        key, value = match.groups()
        if key in values:
            stop("Corosync cmap repeats %s" % key)
        value = value.strip()
        if value.startswith('"'):
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                stop("Corosync cmap contains invalid quoted data")
        values[key] = value
    if values.get("totem.cluster_name") != deployment:
        stop("Corosync cmap cluster name differs from PVE membership")
    try:
        runtime_version = int(values["totem.config_version"])
        local_position = int(values["nodelist.local_node_pos"])
    except (KeyError, TypeError, ValueError):
        stop("Corosync cmap lacks config version or local position")
    if runtime_version != config_version or local_position < 0:
        stop("Corosync cmap config version differs from persisted config")
    positions = {}
    node_pattern = re.compile(r"^nodelist\.node\.(\d+)\.(name|nodeid|ring([0-7])_addr)$")
    for key, value in values.items():
        match = node_pattern.match(key)
        if not match:
            continue
        position = int(match.group(1))
        row = positions.setdefault(position, {"rings": {}})
        field = match.group(2)
        if field in row and field != "rings":
            stop("Corosync cmap repeats a nodelist field")
        if field == "name":
            row["name"] = value
        elif field == "nodeid":
            try:
                row["node_id"] = int(value)
            except (TypeError, ValueError):
                stop("Corosync cmap has an invalid node ID")
        else:
            ring = match.group(3)
            if ring in row["rings"]:
                stop("Corosync cmap repeats a nodelist ring")
            row["rings"][ring] = value
    if local_position not in positions or len(positions) != len(configured):
        stop("Corosync cmap nodelist is incomplete")
    runtime_nodes = {}
    for row in positions.values():
        name = row.get("name")
        node_id = row.get("node_id")
        if name in runtime_nodes or name not in configured or configured[name]["node_id"] != node_id:
            stop("Corosync cmap nodelist identity differs from persisted config")
        if set(row["rings"]) != expected_rings:
            stop("Corosync cmap nodelist rings differ from persisted config")
        for ring in expected_rings:
            if not same_address(row["rings"][ring], configured[name]["rings"][ring], name):
                stop("Corosync cmap nodelist address differs from persisted config")
        runtime_nodes[name] = row
    if set(runtime_nodes) != set(configured) or positions[local_position].get("node_id") != local_node_id:
        stop("Corosync cmap local/full nodelist identity is wrong")
    members = {}
    member_pattern = re.compile(r"^runtime\.members\.(\d+)\.(config_version|ip|status)$")
    address_pattern = re.compile(r"r\(([0-7])\)\s+ip\(([^)]+)\)")
    for key, value in values.items():
        match = member_pattern.match(key)
        if not match:
            continue
        node_id = int(match.group(1))
        row = members.setdefault(node_id, {"rings": {}})
        field = match.group(2)
        if field == "config_version":
            try:
                parsed = int(value)
            except (TypeError, ValueError):
                stop("Corosync runtime member has invalid config_version")
            if "config_version" in row:
                stop("Corosync runtime member repeats config_version")
            row["config_version"] = parsed
        elif field == "status":
            if "status" in row:
                stop("Corosync runtime member repeats status")
            row["status"] = value
        else:
            if row["rings"]:
                stop("Corosync runtime member repeats link addresses")
            matches = address_pattern.findall(value)
            if not matches or address_pattern.sub("", value).strip():
                stop("Corosync runtime member link addresses are malformed")
            row["rings"] = {ring: address.strip() for ring, address in matches}
            if len(row["rings"]) != len(matches):
                stop("Corosync runtime member repeats a ring")
    expected_by_id = {node["id"]: node for node in nodes}
    if set(members) != set(expected_by_id):
        stop("Corosync joined runtime members differ from PVE membership")
    for node_id, node in expected_by_id.items():
        row = members[node_id]
        name = node["name"]
        if row.get("status") != "joined" or row.get("config_version") != config_version or \
                set(row["rings"]) != expected_rings:
            stop("Corosync runtime member %s is not exact/joined" % name)
        for ring in expected_rings:
            if not same_address(row["rings"][ring], configured[name]["rings"][ring], name):
                stop("Corosync runtime member address differs from persisted config")
    binds = {}
    for key, value in values.items():
        match = re.match(r"^totem\.interface\.([0-7])\.bindnetaddr$", key)
        if match:
            ring = match.group(1)
            if ring in binds:
                stop("Corosync cmap repeats a bind address")
            binds[ring] = value
    if set(binds) != expected_rings:
        stop("Corosync live bind rings differ from persisted config")
    for ring in expected_rings:
        if not same_address(binds[ring], configured[local_name]["rings"][ring], local_name):
            stop("Corosync live bind address differs from persisted config")

    local_ids = re.findall(r"^Local node ID\s+(\d+),", cfgtool_output, re.MULTILINE)
    if len(local_ids) != 1 or int(local_ids[0]) != local_node_id:
        stop("corosync-cfgtool reports the wrong local node ID")
    links = {}
    for match in re.finditer(
        r"(?ms)^LINK ID\s+(\d+)\s+.*?(?=^LINK ID\s+\d+\s+|\Z)",
        cfgtool_output,
    ):
        ring = int(match.group(1))
        if ring < 0 or ring > 7 or str(ring) in links:
            stop("corosync-cfgtool repeats an invalid link")
        block = match.group(0)
        addresses = re.findall(r"^\s*addr\s*=\s*(\S+)\s*$", block, re.MULTILINE)
        if len(addresses) != 1:
            stop("corosync-cfgtool link has no unique address")
        states = {}
        for raw_id, raw_state in re.findall(
            r"^\s*nodeid:\s*(\d+):\s*(\S+)\s*$", block, re.MULTILINE
        ):
            node_id = int(raw_id)
            if node_id in states:
                stop("corosync-cfgtool link repeats a node state")
            states[node_id] = raw_state.lower()
        if set(states) != set(expected_by_id) or states.get(local_node_id) != "localhost" or any(
            state != ("localhost" if node_id == local_node_id else "connected")
            for node_id, state in states.items()
        ):
            stop("corosync-cfgtool link is not fully connected N/N")
        if not same_address(addresses[0], configured[local_name]["rings"][str(ring)], local_name):
            stop("corosync-cfgtool link address differs from persisted config")
        links[str(ring)] = addresses[0]
    if set(links) != expected_rings:
        stop("corosync-cfgtool link set differs from persisted config")
    if secure_read(COROSYNC_PATH, "/etc/pve/corosync.conf") != config_raw:
        stop("corosync.conf changed during runtime verification")
    corosync_summary = {
        "sha256": hashlib.sha256(config_raw).hexdigest(),
        "config_version": config_version,
        "nodes": [configured[name] for name in sorted(configured)],
    }

if secure_read(MEMBERS_PATH, "/etc/pve/.members") != members_raw:
    stop("PVE membership changed during embedded Corosync verification")
if package_version() != corosync_package:
    stop("Corosync package version changed during embedded verification")
payload = {
    "schema": 1,
    "mode": mode,
    "deployment": deployment,
    "membership_config_version": membership_config_version,
    "membership_fingerprint": membership_fingerprint,
    "local_name": local_name,
    "local_node_id": local_node_id,
    "corosync_package_version": corosync_package,
    "corosync": corosync_summary,
}
print("PVN_EMBEDDED_COROSYNC " + json.dumps(payload, sort_keys=True, separators=(",", ":")))
PVN_EMBEDDED_COROSYNC
}

corosync_doctor_gate() {
    /usr/sbin/pvnctl doctor --check corosync-runtime-config >/dev/null ||
        remote_fail "pvnctl persisted/live Corosync safety check failed"
}

collect_state() {
    for pvn_command in python3 pvecm dpkg dpkg-query systemctl sha256sum apt-get awk perl ovsdb-tool ovsdb-client; do
        require_command "$pvn_command"
    done
    [ "$(id -u)" -eq 0 ] || remote_fail "execution user is not root"
    pvn_audit=$(dpkg --audit 2>/dev/null || true)
    [ -z "$pvn_audit" ] || remote_fail "dpkg reports incomplete package state"
    pvn_pkg_state=$(dpkg-query -W -f='${db:Status-Status}' pvn-node 2>/dev/null || true)
    [ "$pvn_pkg_state" = installed ] || remote_fail "pvn-node is not completely installed"
    pvn_version=$(dpkg-query -W -f='${Version}' pvn-node 2>/dev/null || true)
    case "$pvn_version" in ''|*[!A-Za-z0-9.+:~_-]*) remote_fail "invalid installed pvn-node version" ;; esac
    pvn_arch=$(dpkg --print-architecture)
    case "$pvn_arch" in ''|*[!A-Za-z0-9_-]*) remote_fail "invalid Debian architecture" ;; esac
    pvn_pve=$(dpkg-query -W -f='${Version}' pve-manager 2>/dev/null || true)
    pvn_pve=${pvn_pve#*:}
    case "$pvn_pve" in 9|9.*) ;; *) remote_fail "PVE 9 is required" ;; esac
    pvn_members=$(membership_record) || remote_fail "cannot verify PVE membership"
    pvn_old_ifs=$IFS
    IFS='|'
    read -r pvn_mode pvn_cluster pvn_config_version pvn_nodes pvn_hostname pvn_node_id pvn_fingerprint <<EOF
$pvn_members
EOF
    IFS=$pvn_old_ifs

    [ "$(unit_enabled ovn-host.service)" = masked ] || remote_fail "ovn-host.service must remain masked"
    [ "$(unit_enabled ovn-central.service)" = masked ] || remote_fail "ovn-central.service must remain masked"
    [ -x /usr/lib/pvn/pvn-ui-verify ] && /usr/lib/pvn/pvn-ui-verify >/dev/null ||
        remote_fail "PVN UI verification failed"

    if [ -e /etc/pvn/node-enabled ]; then
        [ -f /etc/pvn/node-enabled ] && [ ! -L /etc/pvn/node-enabled ] ||
            remote_fail "node activation marker is unsafe"
        pvn_node_state=active
        require_active pvn-node.target
        require_enabled pvn-node.target
        for pvn_unit in pvn-node-ready.service pvn-manager.service pvn-agent.service \
            pvn-ovn-host-config.service ovn-controller.service
        do
            require_active "$pvn_unit"
        done
        /usr/sbin/pvnctl doctor >/dev/null || remote_fail "pvnctl doctor failed"
    else
        pvn_node_state=inactive
        require_inactive pvn-node.target
        require_disabled pvn-node.target
        for pvn_unit in pvn-node-ready.service pvn-manager.service pvn-agent.service \
            pvn-ovn-host-config.service ovn-controller.service
        do
            require_inactive "$pvn_unit"
        done
    fi

    if [ -e /etc/pvn/central/enabled ]; then
        [ -f /etc/pvn/central/enabled ] && [ ! -L /etc/pvn/central/enabled ] ||
            remote_fail "central activation marker is unsafe"
        pvn_central_state=active
        require_active pvn-central.target
        require_enabled pvn-central.target
        require_active pvn-central-preflight.service
        require_active pvn-ovn-db-listeners.service
        pvn_central_pids=
        for pvn_unit in pvn-control-db.service ovn-ovsdb-server-nb.service \
            ovn-ovsdb-server-sb.service ovn-northd.service
        do
            require_active "$pvn_unit"
            pvn_pid=$(systemctl show --property=MainPID --value "$pvn_unit" 2>/dev/null || true)
            case "$pvn_pid" in ''|0|*[!0-9]*) remote_fail "$pvn_unit has no stable main PID" ;; esac
            pvn_central_pids=${pvn_central_pids:+$pvn_central_pids,}$pvn_pid
        done
        active_central_health
    else
        pvn_central_state=inactive
        pvn_central_mode=inactive
        pvn_central_pids=none
        pvn_northd_role=inactive
        require_inactive pvn-central.target
        require_disabled pvn-central.target
        for pvn_unit in pvn-central-preflight.service pvn-control-db.service \
            pvn-ovn-db-listeners.service pvn-ovn-northd-ready.service \
            ovn-ovsdb-server-nb.service \
            ovn-ovsdb-server-sb.service ovn-northd.service
        do
            require_inactive "$pvn_unit"
        done
    fi
    pvn_central_pending=$(central_restart_marker) ||
        remote_fail "central restart marker is unsafe"
}

emit_probe() {
    collect_state
    printf 'PVN_UPDATE mode=%s cluster=%s config=%s fingerprint=%s nodes=%s pve=%s arch=%s version=%s hostname=%s nodeid=%s node=%s central=%s centralmode=%s centralpids=%s centralpending=%s northdrole=%s\n' \
        "$pvn_mode" "$pvn_cluster" "$pvn_config_version" "$pvn_fingerprint" \
        "$pvn_nodes" "$pvn_pve" "$pvn_arch" "$pvn_version" "$pvn_hostname" \
        "$pvn_node_id" "$pvn_node_state" "$pvn_central_state" "$pvn_central_mode" "$pvn_central_pids" \
        "$pvn_central_pending" "$pvn_northd_role"
}

pvn_action=${1:-}
shift || true
case "$pvn_action" in
    embedded-corosync)
        [ "$#" -eq 0 ] || remote_fail "invalid embedded-corosync arguments"
        embedded_corosync_snapshot
        ;;
    probe)
        [ "$#" -eq 0 ] || remote_fail "invalid probe arguments"
        emit_probe
        ;;
    corosync-gate)
        [ "$#" -eq 0 ] || remote_fail "invalid corosync-gate arguments"
        collect_state
        corosync_doctor_gate
        printf 'PVN_COROSYNC_GATE version=%s\n' "$pvn_version"
        ;;
    prepare)
        [ "$#" -eq 0 ] || remote_fail "invalid prepare arguments"
        umask 077
        mktemp /var/tmp/pvn-node-update.XXXXXXXX.deb
        ;;
    verify)
        [ "$#" -eq 2 ] || remote_fail "invalid verify arguments"
        pvn_deb=$1
        pvn_sha=$2
        case "$pvn_deb" in /var/tmp/pvn-node-update.*.deb) ;; *) remote_fail "unsafe staged DEB path" ;; esac
        case "$pvn_sha" in *[!0-9a-f]*|'') remote_fail "invalid expected SHA-256" ;; esac
        [ "${#pvn_sha}" -eq 64 ] || remote_fail "invalid expected SHA-256 length"
        [ -f "$pvn_deb" ] && [ ! -L "$pvn_deb" ] || remote_fail "staged DEB is unsafe"
        pvn_actual=$(sha256sum -- "$pvn_deb" | awk '{print $1}')
        [ "$pvn_actual" = "$pvn_sha" ] || remote_fail "staged DEB checksum mismatch"
        ;;
    apply)
        [ "$#" -eq 11 ] || remote_fail "invalid apply arguments"
        pvn_deb=$1
        pvn_sha=$2
        pvn_target=$3
        pvn_target_arch=$4
        pvn_expected_current=$5
        pvn_expected_node=$6
        pvn_expected_central=$7
        pvn_expected_pids=$8
        pvn_expected_config=$9
        shift 9
        pvn_expected_fingerprint=$1
        pvn_expected_cluster=$2
        case "$pvn_deb" in /var/tmp/pvn-node-update.*.deb) ;; *) remote_fail "unsafe staged DEB path" ;; esac
        collect_state
        [ "$pvn_version" = "$pvn_expected_current" ] || remote_fail "installed version changed before apply"
        [ "$pvn_node_state" = "$pvn_expected_node" ] || remote_fail "node activation state changed before apply"
        [ "$pvn_central_state" = "$pvn_expected_central" ] || remote_fail "central activation state changed before apply"
        [ "$pvn_central_pids" = "$pvn_expected_pids" ] || remote_fail "central process identity changed before apply"
        [ "$pvn_config_version" = "$pvn_expected_config" ] || remote_fail "cluster config version changed before apply"
        [ "$pvn_fingerprint" = "$pvn_expected_fingerprint" ] || remote_fail "cluster membership changed before apply"
        [ "$pvn_cluster" = "$pvn_expected_cluster" ] || remote_fail "cluster identity changed before apply"
        [ "$pvn_target_arch" = all ] || [ "$pvn_target_arch" = "$pvn_arch" ] ||
            remote_fail "DEB architecture differs from this node"
        pvn_actual=$(sha256sum -- "$pvn_deb" | awk '{print $1}')
        [ "$pvn_actual" = "$pvn_sha" ] || remote_fail "staged DEB changed before apply"
        pvn_config_before=$(config_digest) || remote_fail "cannot fingerprint persistent configuration"
        if [ "$pvn_central_state" = active ]; then
            for pvn_db in /var/lib/pvn/control-db/pvn_control.db \
                /var/lib/ovn/ovnnb_db.db /var/lib/ovn/ovnsb_db.db
            do
                [ -f "$pvn_db" ] && [ ! -L "$pvn_db" ] || remote_fail "central database is missing or unsafe: $pvn_db"
            done
        fi
        DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade --no-remove -- "$pvn_deb"
        collect_state
        # postinst runs the same check before restarting an active node stack;
        # repeat it here before the updater can mutate another node. This also
        # covers topology-only nodes with no activation marker.
        corosync_doctor_gate
        [ "$pvn_version" = "$pvn_target" ] || remote_fail "installed version differs from target"
        [ "$pvn_node_state" = "$pvn_expected_node" ] || remote_fail "node activation state changed during update"
        [ "$pvn_central_state" = "$pvn_expected_central" ] || remote_fail "central activation state changed during update"
        [ "$pvn_central_pids" = "$pvn_expected_pids" ] ||
            remote_fail "central service restarted unexpectedly; stop the rollout"
        if [ "$pvn_central_state" = active ]; then
            [ "$pvn_central_pending" = "$pvn_target" ] ||
                remote_fail "active central restart marker does not match the installed target"
        fi
        pvn_config_after=$(config_digest) || remote_fail "cannot re-fingerprint persistent configuration"
        [ "$pvn_config_after" = "$pvn_config_before" ] ||
            remote_fail "persistent /etc/pvn or shared PVN configuration changed during update"
        if [ "$pvn_central_state" = active ]; then
            for pvn_db in /var/lib/pvn/control-db/pvn_control.db \
                /var/lib/ovn/ovnnb_db.db /var/lib/ovn/ovnsb_db.db
            do
                [ -f "$pvn_db" ] && [ ! -L "$pvn_db" ] || remote_fail "central database disappeared during update: $pvn_db"
            done
            printf 'PVN_UPDATED version=%s central-restart=pending\n' "$pvn_version"
        else
            printf 'PVN_UPDATED version=%s central-restart=none\n' "$pvn_version"
        fi
        ;;
    cleanup)
        [ "$#" -eq 1 ] || remote_fail "invalid cleanup arguments"
        case "$1" in /var/tmp/pvn-node-update.*.deb) rm -f -- "$1" ;; *) remote_fail "unsafe staged DEB path" ;; esac
        ;;
    *) remote_fail "unknown remote action" ;;
esac
'''


class Transport:
    def __init__(self, snapshot: Snapshot, deb: pathlib.Path):
        self.snapshot = snapshot
        self.deb = deb

    def _record(self, name: str) -> Node:
        for node in self.snapshot.nodes:
            if node.name == name:
                return node
        fail(f"no transport record for {name}")

    def run(self, node: Node, action: str, *arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
        remote_arguments = [action, *arguments]
        if node.local:
            return command(
                [LOCAL_SH, "-s", "--", *remote_arguments],
                input_text=REMOTE_SCRIPT,
                check=check,
                quiet=True,
            )
        known_hosts = NODES_DIR / node.name / "ssh_known_hosts"
        ssh_arguments = [
            SSH, "-F", "/dev/null", "-e", "none", "-i", str(IDENTITY),
            "-o", "BatchMode=yes", "-o", "PasswordAuthentication=no",
            "-o", "KbdInteractiveAuthentication=no", "-o", "PubkeyAuthentication=yes",
            "-o", "PreferredAuthentications=publickey", "-o", "IdentitiesOnly=yes",
            "-o", "NumberOfPasswordPrompts=0", "-o", "StrictHostKeyChecking=yes",
            "-o", "UpdateHostKeys=no", "-o", "CheckHostIP=no",
            "-o", f"HostKeyAlias={node.name}", "-o", f"UserKnownHostsFile={known_hosts}",
            "-o", "GlobalKnownHostsFile=none", "-o", "ConnectTimeout=10",
            "--", f"root@{node.address}", "sh", "-s", "--", *remote_arguments,
        ]
        return command(ssh_arguments, input_text=REMOTE_SCRIPT, check=check, quiet=True)

    def copy(self, node: Node, destination: str) -> None:
        if node.local:
            command([CP, "--", str(self.deb), destination], quiet=True)
            return
        address = f"[{node.address}]" if ":" in node.address else node.address
        target = f"root@{address}:{destination}"
        known_hosts = NODES_DIR / node.name / "ssh_known_hosts"
        arguments = [
            SCP, "-q", "-F", "/dev/null", "-i", str(IDENTITY),
            "-o", "BatchMode=yes", "-o", "PasswordAuthentication=no",
            "-o", "KbdInteractiveAuthentication=no", "-o", "PubkeyAuthentication=yes",
            "-o", "PreferredAuthentications=publickey", "-o", "IdentitiesOnly=yes",
            "-o", "NumberOfPasswordPrompts=0", "-o", "StrictHostKeyChecking=yes",
            "-o", "UpdateHostKeys=no", "-o", "CheckHostIP=no",
            "-o", f"HostKeyAlias={node.name}", "-o", f"UserKnownHostsFile={known_hosts}",
            "-o", "GlobalKnownHostsFile=none", "-o", "ConnectTimeout=10",
            "--", str(self.deb), target,
        ]
        command(arguments, quiet=True)


def parse_probe(node: Node, raw: str, snapshot: Snapshot) -> Probe:
    lines = [line.strip() for line in raw.splitlines() if line.strip()]
    if len(lines) != 1:
        fail(f"unexpected health response from {node.name}")
    fields = lines[0].split()
    if len(fields) != 17 or fields[0] != "PVN_UPDATE":
        fail(f"malformed health response from {node.name}")
    values: dict[str, str] = {}
    for field in fields[1:]:
        if field.count("=") != 1:
            fail(f"malformed health field from {node.name}")
        key, value = field.split("=", 1)
        if key in values or not value:
            fail(f"duplicate or empty health field from {node.name}")
        values[key] = value
    required = {
        "mode", "cluster", "config", "fingerprint", "nodes", "pve", "arch",
        "version", "hostname", "nodeid", "node", "central", "centralmode", "centralpids",
        "centralpending", "northdrole",
    }
    if set(values) != required:
        fail(f"unexpected health fields from {node.name}")
    if values["mode"] != snapshot.mode or values["cluster"] != snapshot.deployment:
        fail(f"{node.name} reports a different PVE deployment")
    if values["config"] != str(snapshot.config_version) or values["fingerprint"] != snapshot.fingerprint:
        fail(f"{node.name} reports different PVE membership or config version")
    if values["nodes"] != str(len(snapshot.nodes)):
        fail(f"{node.name} reports a different PVE node count")
    if values["hostname"] != node.name or values["nodeid"] != str(node.node_id):
        fail(f"{node.name} transport reached the wrong PVE node")
    if not SAFE_ARCH.fullmatch(values["arch"]) or not SAFE_VERSION.fullmatch(values["version"]):
        fail(f"{node.name} reports unsafe package metadata")
    if values["node"] not in {"active", "inactive"} or values["central"] not in {"active", "inactive"}:
        fail(f"{node.name} reports an invalid activation state")
    if values["central"] == "active" and values["centralmode"] not in {"raft", "standalone"}:
        fail(f"{node.name} reports an invalid active central mode")
    expected_central_mode = "standalone" if snapshot.mode == "standalone" else "raft"
    if values["central"] == "active" and values["centralmode"] != expected_central_mode:
        fail(f"{node.name} central database mode differs from the PVE deployment mode")
    if values["central"] == "inactive" and values["centralmode"] != "inactive":
        fail(f"{node.name} reports a central mode while inactive")
    if values["central"] == "inactive" and values["centralpids"] != "none":
        fail(f"{node.name} reports central PIDs while inactive")
    if values["central"] == "active" and values["northdrole"] not in {"active", "standby"}:
        fail(f"{node.name} reports an invalid active northd role")
    if values["central"] == "inactive" and values["northdrole"] != "inactive":
        fail(f"{node.name} reports a northd role while central is inactive")
    if values["central"] == "active" and not re.fullmatch(r"[1-9][0-9]*(?:,[1-9][0-9]*){3}", values["centralpids"]):
        fail(f"{node.name} reports invalid central process identities")
    if values["centralpending"] != "none" and not SAFE_VERSION.fullmatch(values["centralpending"]):
        fail(f"{node.name} reports an invalid central restart marker")
    return Probe(
        node, values["version"], values["arch"], values["node"],
        values["central"], values["centralmode"], values["centralpids"], values["centralpending"],
        values["northdrole"],
    )


def gate_northd_roles(probes: dict[str, Probe]) -> None:
    active = [probe for probe in probes.values() if probe.central_state == "active"]
    if not active:
        return
    # Package unpack deliberately leaves old central PIDs and a restart marker.
    # Do not make the required package/schema repin depend on a new northd
    # process that is forbidden to start until after that repin.
    if any(probe.central_pending != "none" for probe in active):
        return
    leaders = [probe.node.name for probe in active if probe.northd_role == "active"]
    if len(leaders) != 1:
        fail(
            "northd cluster must report exactly one active role when no central restart is pending; "
            f"found {len(leaders)}: {' '.join(leaders) or 'none'}"
        )


def probe_all(transport: Transport, snapshot: Snapshot, announce: bool) -> dict[str, Probe]:
    probes: dict[str, Probe] = {}
    architecture: str | None = None
    for node in snapshot.nodes:
        if announce:
            print(f"[{node.name}] read-only package, quorum, PVN, OVN, Raft, and UI checks")
        result = transport.run(node, "probe")
        probe = parse_probe(node, result.stdout, snapshot)
        if architecture is None:
            architecture = probe.architecture
        elif probe.architecture != architecture:
            fail(f"{node.name} architecture differs from the cluster")
        probes[node.name] = probe
        if announce:
            print(
                f"[{node.name}] healthy: pvn-node={probe.version} "
                f"node={probe.node_state} central={probe.central_state}"
            )
    gate_northd_roles(probes)
    return probes


def compare_versions(left: str, operator: str, right: str) -> bool:
    return command([DPKG, "--compare-versions", left, operator, right], check=False, quiet=True).returncode == 0


def validate_rollout_versions(probes: dict[str, Probe], target: str) -> None:
    older: set[str] = set()
    for probe in probes.values():
        if compare_versions(target, "ge", PROJECTLESS_SCHEMA_FIRST_VERSION) and \
                compare_versions(probe.version, "lt", PROJECTLESS_SCHEMA_FIRST_VERSION):
            fail(
                f"breaking PVN_Control transition refused: {probe.node.name} has "
                f"{probe.version}, target is {target}; stop all PVN writers and use the "
                "documented projectless database reset instead of rolling update"
            )
        if probe.central_state == "inactive" and probe.central_pending != "none":
            fail(
                f"{probe.node.name} has an inactive central target with an unresolved "
                "restart marker"
            )
        if probe.central_pending != "none":
            if probe.central_pending != probe.version:
                fail(
                    f"{probe.node.name} restart marker {probe.central_pending} differs "
                    f"from installed pvn-node {probe.version}"
                )
            if probe.version != target:
                fail(
                    f"{probe.node.name} must finish and consume its pvn-node "
                    f"{probe.version} central restart marker before updating to {target}"
                )
        if probe.version == target:
            continue
        if not compare_versions(probe.version, "lt", target):
            fail(f"downgrade refused: {probe.node.name} has {probe.version}, target is {target}")
        older.add(probe.version)
    if len(older) > 1:
        fail("cluster has more than one pre-update package version; normalize it before rolling update")


def gate_updated_nodes(
    transport: Transport,
    snapshot: Snapshot,
    probes: dict[str, Probe],
    target: str,
) -> None:
    """Fail closed on persisted/live Corosync drift before another mutation."""
    for node in snapshot.nodes:
        if probes[node.name].version != target:
            continue
        result = transport.run(node, "corosync-gate")
        expected = f"PVN_COROSYNC_GATE version={target}"
        if result.stdout.strip() != expected:
            fail(f"{node.name} returned no Corosync safety-gate record")


def parse_embedded_corosync_snapshot(
    node: Node, raw: str, snapshot: Snapshot
) -> EmbeddedCorosyncSnapshot:
    lines = [line.strip() for line in raw.splitlines() if line.strip()]
    prefix = "PVN_EMBEDDED_COROSYNC "
    if len(lines) != 1 or not lines[0].startswith(prefix):
        fail(f"{node.name} returned no embedded Corosync preflight record")
    try:
        payload = json.loads(lines[0][len(prefix):])
    except json.JSONDecodeError as error:
        fail(f"{node.name} returned invalid embedded Corosync JSON: {error}")
    required = {
        "schema", "mode", "deployment", "membership_config_version",
        "membership_fingerprint", "local_name", "local_node_id",
        "corosync_package_version", "corosync",
    }
    if not isinstance(payload, dict) or set(payload) != required or payload.get("schema") != 1:
        fail(f"{node.name} returned an unsupported embedded Corosync snapshot")
    if payload.get("mode") != snapshot.mode or payload.get("deployment") != snapshot.deployment:
        fail(f"{node.name} embedded Corosync deployment differs from PVE membership")
    if payload.get("membership_config_version") != snapshot.config_version or \
            payload.get("membership_fingerprint") != snapshot.fingerprint:
        fail(f"{node.name} embedded Corosync membership snapshot differs")
    if payload.get("local_name") != node.name or payload.get("local_node_id") != node.node_id:
        fail(f"{node.name} embedded Corosync transport reached the wrong node")
    package_version = payload.get("corosync_package_version")
    if not isinstance(package_version, str) or not SAFE_VERSION.fullmatch(package_version):
        fail(f"{node.name} returned an invalid Corosync package version")

    config_sha: str | None = None
    config_version: int | None = None
    corosync = payload.get("corosync")
    if snapshot.mode == "standalone":
        if corosync is not None:
            fail(f"{node.name} standalone snapshot unexpectedly contains Corosync state")
    else:
        if not isinstance(corosync, dict) or set(corosync) != {
            "sha256", "config_version", "nodes",
        }:
            fail(f"{node.name} returned malformed persisted Corosync state")
        config_sha = corosync.get("sha256")
        config_version = corosync.get("config_version")
        records = corosync.get("nodes")
        if not isinstance(config_sha, str) or not SAFE_SHA.fullmatch(config_sha) or \
                type(config_version) is not int or config_version != snapshot.config_version or \
                not isinstance(records, list) or len(records) != len(snapshot.nodes):
            fail(f"{node.name} returned an invalid Corosync config identity")
        expected_by_name = {item.name: item for item in snapshot.nodes}
        seen_names: set[str] = set()
        seen_ids: set[int] = set()
        expected_ring_keys: set[str] | None = None
        for record in records:
            if not isinstance(record, dict) or set(record) != {"name", "node_id", "rings"}:
                fail(f"{node.name} returned a malformed Corosync node record")
            name = record.get("name")
            node_id = record.get("node_id")
            rings = record.get("rings")
            expected_node = expected_by_name.get(name)
            if expected_node is None or node_id != expected_node.node_id or \
                    name in seen_names or node_id in seen_ids:
                fail(f"{node.name} Corosync node identity differs from PVE membership")
            if not isinstance(rings, dict) or not 1 <= len(rings) <= 8:
                fail(f"{node.name} Corosync node has an invalid KNET ring set")
            ring_keys = set(rings)
            if expected_ring_keys is None:
                expected_ring_keys = ring_keys
            elif ring_keys != expected_ring_keys:
                fail(f"{node.name} Corosync KNET rings do not cover every member")
            for ring, address in rings.items():
                if not isinstance(ring, str) or not re.fullmatch(r"[0-7]", ring) or \
                        not isinstance(address, str):
                    fail(f"{node.name} Corosync node has an invalid ring record")
                if address != name:
                    try:
                        parsed = ipaddress.ip_address(address)
                    except ValueError:
                        fail(f"{node.name} Corosync ring address is unsafe")
                    if not isinstance(parsed, ipaddress.IPv4Address) or str(parsed) != address or \
                            parsed.is_unspecified or parsed.is_multicast:
                        fail(f"{node.name} Corosync ring address is not canonical IPv4")
            seen_names.add(name)
            seen_ids.add(node_id)
        if seen_names != set(expected_by_name):
            fail(f"{node.name} Corosync config omits a PVE member")

    common = {
        key: value for key, value in payload.items()
        if key not in {"local_name", "local_node_id"}
    }
    return EmbeddedCorosyncSnapshot(
        canonical=json.dumps(common, sort_keys=True, separators=(",", ":")),
        package_version=package_version,
        config_sha256=config_sha,
        config_version=config_version,
    )


def gate_embedded_corosync(
    transport: Transport,
    snapshot: Snapshot,
    *,
    expected: EmbeddedCorosyncSnapshot | None = None,
    announce: bool = False,
) -> EmbeddedCorosyncSnapshot:
    """Prove all-node persisted/runtime state before any remote package mutation."""
    cluster_snapshot: EmbeddedCorosyncSnapshot | None = None
    for node in snapshot.nodes:
        if announce:
            print(f"[{node.name}] embedded pre-update Corosync persisted/runtime check")
        result = transport.run(node, "embedded-corosync")
        current = parse_embedded_corosync_snapshot(node, result.stdout, snapshot)
        if cluster_snapshot is None:
            cluster_snapshot = current
        elif current.package_version != cluster_snapshot.package_version:
            fail("PVE nodes do not run one exact Corosync package version")
        elif current.config_sha256 != cluster_snapshot.config_sha256 or \
                current.config_version != cluster_snapshot.config_version or \
                current.canonical != cluster_snapshot.canonical:
            fail("PVE nodes do not expose one exact persisted/runtime Corosync state")
    if cluster_snapshot is None:
        fail("embedded Corosync preflight found no PVE nodes")
    if expected is not None and cluster_snapshot != expected:
        fail("Corosync persisted/runtime/package state changed after preflight")
    if announce:
        if snapshot.mode == "standalone":
            print("[cluster] embedded Corosync preflight: standalone runtime is absent")
        else:
            print(
                "[cluster] embedded Corosync preflight: "
                f"config_version={cluster_snapshot.config_version} "
                f"sha256={cluster_snapshot.config_sha256} "
                f"package={cluster_snapshot.package_version}"
            )
    return cluster_snapshot


def inspect_deb(path: pathlib.Path) -> tuple[str, str, str]:
    try:
        resolved = path.resolve(strict=True)
    except OSError as error:
        fail(f"DEB is not readable: {error}")
    if not resolved.is_file():
        fail(f"DEB is not a regular file: {resolved}")
    package = command([DPKG_DEB, "-f", str(resolved), "Package"], quiet=True).stdout.strip()
    version = command([DPKG_DEB, "-f", str(resolved), "Version"], quiet=True).stdout.strip()
    architecture = command([DPKG_DEB, "-f", str(resolved), "Architecture"], quiet=True).stdout.strip()
    if package != "pvn-node":
        fail("DEB package must be pvn-node")
    if not SAFE_VERSION.fullmatch(version):
        fail("DEB has an unsafe or empty version")
    if not SAFE_ARCH.fullmatch(architecture):
        fail("DEB has an unsafe or empty architecture")
    digest_line = command([SHA256SUM, "--", str(resolved)], quiet=True).stdout.split()
    if len(digest_line) < 1 or not SAFE_SHA.fullmatch(digest_line[0]):
        fail("could not calculate a valid DEB SHA-256")
    return version, architecture, digest_line[0]


class UpdateLease:
    def __init__(self, snapshot: Snapshot):
        self.snapshot = snapshot
        self.token = secrets.token_hex(24)
        self.held = False
        self.lock_handle = None

    def acquire(self) -> None:
        if not LOCK_PATH.is_absolute():
            fail("PVN_UPDATE_LOCK_FILE must be absolute")
        try:
            self.lock_handle = LOCK_PATH.open("a+")
            fcntl.flock(self.lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (OSError, BlockingIOError) as error:
            fail(f"another local PVN update is running or lock is unavailable: {error}")
        owner = json.dumps(
            {
                "domain": "mutation",
                "deployment": self.snapshot.deployment,
                "node": self.snapshot.local_name,
                "operation": "rolling-update",
                "pid": os.getpid(),
                "started": int(time.time()),
                "token": self.token,
            },
            sort_keys=True,
            separators=(",", ":"),
        ) + "\n"
        command([LEASE, "acquire", "mutation", self.token], input_text=owner, quiet=True)
        self.held = True

    def release(self) -> None:
        error: UpdateError | None = None
        if self.held:
            try:
                command([LEASE, "release", "mutation", self.token], quiet=True)
                self.held = False
            except UpdateError as caught:
                error = caught
        if self.lock_handle is not None:
            self.lock_handle.close()
            self.lock_handle = None
        if error is not None:
            fail(f"cluster mutation lease could not be released; inspect `pvn-cluster-lease show mutation`: {error}")


def cleanup_staged(transport: Transport, staged: dict[str, str]) -> None:
    for name, path in list(staged.items()):
        node = next(node for node in transport.snapshot.nodes if node.name == name)
        result = transport.run(node, "cleanup", path, check=False)
        if result.returncode != 0:
            print(f"{PROGRAM}: warning: could not remove staged DEB {path} from {name}", file=sys.stderr)
        staged.pop(name, None)


def stage_pending(
    transport: Transport,
    snapshot: Snapshot,
    probes: dict[str, Probe],
    target: str,
    digest: str,
) -> dict[str, str]:
    staged: dict[str, str] = {}
    try:
        for node in snapshot.nodes:
            if probes[node.name].version == target:
                continue
            print(f"[{node.name}] staging checksum-verified pvn-node {target}")
            result = transport.run(node, "prepare")
            path = result.stdout.strip()
            if not re.fullmatch(r"/var/tmp/pvn-node-update\.[A-Za-z0-9]+\.deb", path):
                fail(f"unsafe staging path returned by {node.name}")
            staged[node.name] = path
            transport.copy(node, path)
            transport.run(node, "verify", path, digest)
        return staged
    except Exception:
        cleanup_staged(transport, staged)
        raise


def update_cluster(snapshot: Snapshot, deb: pathlib.Path, target: str, architecture: str, digest: str) -> None:
    transport = Transport(snapshot, deb)
    lease = UpdateLease(snapshot)
    staged: dict[str, str] = {}
    primary_error: BaseException | None = None
    try:
        lease.acquire()
        revalidate(snapshot)
        probes = probe_all(transport, snapshot, announce=True)
        validate_rollout_versions(probes, target)
        embedded_corosync = gate_embedded_corosync(
            transport, snapshot, announce=True
        )
        # A second all-node sweep closes the gap between the first read-only
        # proof and remote DEB staging.  Later sweeps pin this same snapshot
        # immediately before and after each dpkg transaction.
        gate_embedded_corosync(
            transport, snapshot, expected=embedded_corosync
        )
        gate_updated_nodes(transport, snapshot, probes, target)
        if architecture != "all" and any(probe.architecture != architecture for probe in probes.values()):
            fail(f"DEB architecture {architecture} differs from one or more PVE nodes")
        staged = stage_pending(transport, snapshot, probes, target, digest)
        revalidate(snapshot)
        gate_embedded_corosync(
            transport, snapshot, expected=embedded_corosync
        )

        for node in snapshot.nodes:
            revalidate(snapshot)
            gate_embedded_corosync(
                transport, snapshot, expected=embedded_corosync
            )
            probes = probe_all(transport, snapshot, announce=False)
            validate_rollout_versions(probes, target)
            gate_updated_nodes(transport, snapshot, probes, target)
            current = probes[node.name]
            if current.version == target:
                print(f"[{node.name}] already at pvn-node {target}; health verified")
                continue
            path = staged.get(node.name)
            if not path:
                fail(f"no staged package for pending node {node.name}")
            print(f"[{node.name}] rolling package update {current.version} -> {target}")
            result = transport.run(
                node,
                "apply",
                path,
                digest,
                target,
                architecture,
                current.version,
                current.node_state,
                current.central_state,
                current.central_pids,
                str(snapshot.config_version),
                snapshot.fingerprint,
                snapshot.deployment,
            )
            if "PVN_UPDATED" not in result.stdout:
                fail(f"{node.name} returned no update completion record")
            revalidate(snapshot)
            final_gate = probe_all(transport, snapshot, announce=False)
            if final_gate[node.name].version != target:
                fail(f"post-update health gate found the wrong version on {node.name}")
            gate_embedded_corosync(
                transport, snapshot, expected=embedded_corosync
            )
            gate_updated_nodes(transport, snapshot, final_gate, target)
            transport.run(node, "cleanup", path)
            staged.pop(node.name, None)
            print(f"[{node.name}] updated; full-cluster health gate passed")

        cleanup_staged(transport, staged)
        revalidate(snapshot)
        final = probe_all(transport, snapshot, announce=True)
        if any(probe.version != target for probe in final.values()):
            fail("final sweep found a mixed pvn-node version")
        gate_embedded_corosync(
            transport, snapshot, expected=embedded_corosync
        )
        gate_updated_nodes(transport, snapshot, final, target)
        active_pending = [
            probe.node.name for probe in final.values()
            if probe.central_state == "active" and probe.central_pending != "none"
        ]
        standalone_pending = [
            probe.node.name for probe in final.values()
            if probe.central_state == "active" and probe.central_mode == "standalone"
            and probe.central_pending != "none"
        ]
        raft_pending = [
            probe.node.name for probe in final.values()
            if probe.central_state == "active" and probe.central_mode == "raft"
            and probe.central_pending != "none"
        ]
        inactive_pending = [
            probe.node.name for probe in final.values()
            if probe.central_state == "inactive" and probe.central_pending != "none"
        ]
        print(f"Updated pvn-node {target} on all {len(snapshot.nodes)} nodes in {snapshot.deployment}.")
        print("Persistent /etc/pvn configuration, shared PVN configuration, and OVN/PVN databases were preserved.")
        if active_pending:
            print(
                "RESTART REQUIRED: active central processes were preserved and a durable "
                "restart marker remains on: " + " ".join(active_pending)
            )
            print(
                "NEXT REQUIRED ORDER: keep every restart marker intact; first run the "
                "pvn-topology active schema migration, then run pvn-control-plane plan "
                "and its confirmed apply for the combined package/schema repin; only "
                "after both succeed may central voters be restarted."
            )
        if standalone_pending:
            print(
                "After the required schema/package repin, restart the standalone central target "
                "during a maintenance window, then verify all "
                "three exact local database schemas before clearing its marker: "
                + " ".join(standalone_pending)
            )
        if raft_pending:
            print(
                "After the required schema/package repin and full Raft convergence, keep every "
                "marker and restart current standby voters first, then the dynamically current "
                "active voter last, one healthy voter at a time: "
                + " ".join(raft_pending)
            )
            print(
                "Only after every voter has restarted may you require all-node strict northd "
                "status, one common cfg, and exactly one active; then consume all markers and "
                "rerun updater plan."
            )
        if inactive_pending:
            print(
                "Inactive central targets were not activated; an older restart marker remains on: "
                + " ".join(inactive_pending)
            )
    except BaseException as error:
        primary_error = error
        raise
    finally:
        if staged:
            cleanup_staged(transport, staged)
        try:
            lease.release()
        except UpdateError:
            if primary_error is None:
                raise
            print(
                f"{PROGRAM}: warning: mutation lease release also failed; inspect it before retrying",
                file=sys.stderr,
            )


def plan(snapshot: Snapshot, deb: pathlib.Path, target: str, architecture: str, digest: str) -> None:
    transport = Transport(snapshot, deb)
    probes = probe_all(transport, snapshot, announce=True)
    validate_rollout_versions(probes, target)
    gate_embedded_corosync(transport, snapshot, announce=True)
    gate_updated_nodes(transport, snapshot, probes, target)
    if architecture != "all" and any(probe.architecture != architecture for probe in probes.values()):
        fail(f"DEB architecture {architecture} differs from one or more PVE nodes")
    pending = [probe.node.name for probe in probes.values() if probe.version != target]
    if pending:
        print(f"Plan: pvn-node {target} ({digest}) would roll sequentially over: {' '.join(pending)}")
    else:
        print(f"Plan: every node already has pvn-node {target}; apply would run health verification only.")
    central_will_require_restart = [
        probe.node.name for probe in probes.values()
        if probe.central_state == "active"
        and (probe.version != target or probe.central_pending != "none")
    ]
    if central_will_require_restart:
        print(
            "Plan: active central processes will not be restarted automatically; a durable "
            "restart-required marker will remain on: " + " ".join(central_will_require_restart)
        )
        print(
            "Plan: required order is pvn-topology active schema migration, then the "
            "pvn-control-plane combined package/schema repin, and only then a guarded "
            "central restart wave; clustered markers remain until its global strict proof."
        )
        standalone_restart = [
            probe.node.name for probe in probes.values()
            if probe.node.name in central_will_require_restart and probe.central_mode == "standalone"
        ]
        raft_restart = [
            probe.node.name for probe in probes.values()
            if probe.node.name in central_will_require_restart and probe.central_mode == "raft"
        ]
        if standalone_restart:
            print(
                "Plan: after both repins, restart the standalone central target in a maintenance "
                "window and verify its "
                "three local database schemas: " + " ".join(standalone_restart)
            )
        if raft_restart:
            print(
                "Plan: after both repins and full Raft convergence, keep all markers; "
                "restart current standbys first and the dynamically current active last, "
                "one healthy voter at a time: "
                + " ".join(raft_restart)
            )
            print(
                "Plan: after the complete restart wave, require all-node strict northd status, "
                "one common cfg, and exactly one active before consuming any marker; then "
                "rerun plan."
            )
    print(f"Re-run with apply --confirm {snapshot.deployment}; no changes made.")


def parse_arguments(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog=PROGRAM)
    parser.add_argument("phase", choices=("plan", "apply"))
    parser.add_argument("--deb", required=True, type=pathlib.Path)
    parser.add_argument("--confirm", default="")
    return parser.parse_args(arguments)


def main(arguments: list[str]) -> int:
    if os.geteuid() != 0:
        fail("must run as root on a Proxmox VE node")
    parsed = parse_arguments(arguments)
    version, architecture, digest = inspect_deb(parsed.deb)
    snapshot = discover()
    if snapshot.mode == "cluster":
        validate_identity()
    if parsed.phase == "plan":
        if parsed.confirm and parsed.confirm != snapshot.deployment:
            fail(f"confirmation {parsed.confirm!r} does not match {snapshot.deployment!r}")
        plan(snapshot, parsed.deb.resolve(), version, architecture, digest)
        return 0
    if not parsed.confirm:
        fail("apply requires --confirm DEPLOYMENT_ID")
    if parsed.confirm != snapshot.deployment:
        fail(f"confirmation {parsed.confirm!r} does not match {snapshot.deployment!r}")
    update_cluster(snapshot, parsed.deb.resolve(), version, architecture, digest)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print(f"{PROGRAM}: interrupted; completed nodes remain upgraded and are safe to verify/retry", file=sys.stderr)
        raise SystemExit(130)
    except UpdateError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        raise SystemExit(1)
