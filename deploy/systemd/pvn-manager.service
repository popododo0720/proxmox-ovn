[Unit]
Description=PVN manager control and Proxmox browser APIs
Documentation=file:/usr/share/doc/pvn-node/architecture.md
After=network-online.target pve-cluster.service
Wants=network-online.target
PartOf=pvn-node.target
ConditionPathExists=/etc/pvn/node-enabled
ConditionPathExists=/etc/pve/pvn/config.json

[Service]
Type=simple
User=pvn
Group=pvn
RuntimeDirectory=pvn pvn-api pvn-compute
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=www-data
EnvironmentFile=/etc/pvn/node.env
LoadCredential=pvn-config:/etc/pve/pvn/config.json
LoadCredential=pvn-pve-members:/etc/pve/.members
Environment=PVN_PVE_MEMBERS_FILE=%d/pvn-pve-members
ExecStartPre=/usr/bin/test -r %d/pvn-config
ExecStartPre=/usr/bin/test -r %d/pvn-pve-members
ExecStart=/usr/sbin/pvn-manager --config %d/pvn-config --pve-members-file %d/pvn-pve-members
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/pvn /run/pvn-api /run/pvn-compute
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=pvn-node.target
