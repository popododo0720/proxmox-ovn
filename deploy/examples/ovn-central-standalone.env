# Install as /etc/pvn/central/ovn-central.env only for an explicit one-voter
# deployment. Client listeners are configured by ovn-listeners.env.
PVN_OVN_BOOTSTRAP=standalone
OVN_CTL_OPTS="--db-nb-create-insecure-remote=no --db-sb-create-insecure-remote=no --ovn-nb-db-ssl-key=/etc/pvn/pki/node-key.pem --ovn-nb-db-ssl-cert=/etc/pvn/pki/node.pem --ovn-nb-db-ssl-ca-cert=/etc/pvn/pki/ca.pem --ovn-nb-db-ssl-protocols=TLSv1.2,TLSv1.3 --ovn-sb-db-ssl-key=/etc/pvn/pki/node-key.pem --ovn-sb-db-ssl-cert=/etc/pvn/pki/node.pem --ovn-sb-db-ssl-ca-cert=/etc/pvn/pki/ca.pem --ovn-sb-db-ssl-protocols=TLSv1.2,TLSv1.3"
