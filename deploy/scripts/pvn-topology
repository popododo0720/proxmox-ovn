LEASE_BIN = os.environ.get("PVN_TOPOLOGY_LEASE_BIN", "/usr/lib/pvn/pvn-cluster-lease")
LEASE_DOMAIN = "mutation"
SSH_BIN = os.environ.get("PVN_TOPOLOGY_SSH_BIN", "ssh")
