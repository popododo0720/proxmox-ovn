# Install as /etc/pvn/central/ovn-listeners.env on every voter. Replace the
# example address with that node's management/control address. The packaged
# service configures process-local ovsdb-server remotes; it never stores this
# node address in replicated NB_Global/SB_Global Connection rows.
PVN_OVN_LISTEN=10.0.0.11
PVN_OVN_NB_PORT=6641
PVN_OVN_SB_PORT=6642
