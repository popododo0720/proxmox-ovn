PROVIDER_ACK = "OPENSTACK_PROVIDER_PORTS_ALLOW_ARBITRARY_MAC_IP"
REMOTE_REQUEST_LIMIT = 8 * 1024 * 1024
PROCESS_OUTPUT_LIMIT = 4 * 1024 * 1024
TEST_FAST = os.environ.get("PVN_TOPOLOGY_TEST_FAST") == "1"
COROSYNC_SETTLE_ATTEMPTS = 1 if TEST_FAST else 5
COROSYNC_FINAL_ATTEMPTS = 1 if TEST_FAST else 30
