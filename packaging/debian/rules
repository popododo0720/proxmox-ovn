#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build VERSION=$$(dpkg-parsechangelog -SVersion)

override_dh_auto_test:
	$(MAKE) test

override_dh_auto_install:
	mkdir -p debian/pvn-node/usr/sbin
	install -m 0755 bin/pvn-manager bin/pvn-agent bin/pvnctl debian/pvn-node/usr/sbin/
	mkdir -p debian/pvn-node/usr/share/pvn
	mkdir -p debian/pvn-node/usr/share/pvn/schema
	install -m 0644 schema/*.ovsschema debian/pvn-node/usr/share/pvn/schema/
	mkdir -p debian/pvn-node/usr/lib/systemd/system
	install -m 0644 deploy/systemd/*.service deploy/systemd/*.target debian/pvn-node/usr/lib/systemd/system/
	for source in deploy/systemd/*.service.d; do \
		unit=$$(basename "$$source"); \
		install -d "debian/pvn-node/usr/lib/systemd/system/$$unit"; \
		install -m 0644 "$$source"/*.conf "debian/pvn-node/usr/lib/systemd/system/$$unit/"; \
	done
	mkdir -p debian/pvn-node/usr/share/pve-manager/js debian/pvn-node/usr/lib/pvn
	install -m 0644 pve-ui/pvn-loader.js debian/pvn-node/usr/lib/pvn/
	install -m 0755 pve-ui/inject.sh debian/pvn-node/usr/lib/pvn/pvn-ui-inject
	find deploy/scripts -mindepth 1 -maxdepth 1 -type f -name 'pvn-*' \
		-exec install -m 0755 -t debian/pvn-node/usr/lib/pvn/ -- {} +
	install -m 0755 deploy/scripts/pvn-db-backup debian/pvn-node/usr/sbin/pvn-db-backup
	mkdir -p debian/pvn-node/usr/share/doc/pvn-node/examples debian/pvn-node/usr/share/doc/pvn-node/inventory
	install -m 0644 README.md docs/*.md debian/pvn-node/usr/share/doc/pvn-node/
	install -m 0644 deploy/examples/* debian/pvn-node/usr/share/doc/pvn-node/examples/
	install -m 0644 deploy/inventory/* debian/pvn-node/usr/share/doc/pvn-node/inventory/

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
