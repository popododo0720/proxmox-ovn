#!/bin/sh
set -eu

config=/etc/pve/pvn/config.json
health_listen=${PVN_HEALTH_LISTEN:-127.0.0.1:9476}
health_url=${PVN_AGENT_HEALTH_URL:-http://127.0.0.1:9476/healthz}
attempt=1
max_attempts=30
last_output='PVN readiness checks have not run'

[ "$health_listen" = 127.0.0.1:9476 ] || {
    echo "PVN_HEALTH_LISTEN must use the packaged loopback endpoint" >&2
    exit 2
}
[ "$health_url" = http://127.0.0.1:9476/healthz ] || {
    echo "PVN_AGENT_HEALTH_URL must use the packaged loopback endpoint" >&2
    exit 2
}

if ! ui_output=$(/usr/lib/pvn/pvn-ui-verify 2>&1); then
    printf '%s\n' "$ui_output" >&2
    exit 1
fi

required_units_active() {
    for unit in \
        pvn-manager.service pvn-ovn-host-config.service \
        ovn-controller.service pvn-agent.service
    do
        /usr/bin/systemctl is-active --quiet "$unit" || return 1
    done
}

controller_is_connected() {
    controller_status=$(/usr/bin/ovn-appctl -t ovn-controller \
        connection-status 2>&1) || return 1
    [ "$controller_status" = connected ]
}

while [ "$attempt" -le "$max_attempts" ]; do
    if [ ! -S /run/pvn/manager.sock ]; then
        last_output='PVN manager runtime socket is not ready'
    elif ! required_units_active; then
        last_output='one or more required PVN node services are not active'
    elif ! controller_is_connected; then
        last_output="OVN Southbound controller is not connected: $controller_status"
    elif ! agent_health=$(/usr/bin/curl --fail --silent --show-error \
        --noproxy '*' --proto '=http' --connect-timeout 1 --max-time 2 \
        "$health_url" 2>&1)
    then
        last_output="PVN agent has not completed a healthy binding scan: $agent_health"
    elif last_output=$(/usr/sbin/pvnctl doctor --config "$config" 2>&1); then
        # Avoid accepting a process that only appeared active between restart
        # attempts. Manager socket creation also proves its DB probes passed.
        /usr/bin/sleep 2
        if [ -S /run/pvn/manager.sock ] && required_units_active && \
            controller_is_connected && \
            /usr/bin/curl --fail --silent --show-error --noproxy '*' \
                --proto '=http' --connect-timeout 1 --max-time 2 \
                "$health_url" >/dev/null
        then
            printf '%s\n' "$last_output"
            exit 0
        fi
        last_output='a required PVN node service did not remain active'
    fi

    attempt=$((attempt + 1))
    [ "$attempt" -le "$max_attempts" ] && /usr/bin/sleep 2
done

printf 'PVN node did not become ready: %s\n' "$last_output" >&2
exit 1
