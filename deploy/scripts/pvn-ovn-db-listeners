#!/bin/sh
set -eu
set -f

nb_port=${PVN_OVN_NB_PORT:-6641}
sb_port=${PVN_OVN_SB_PORT:-6642}
listen=${PVN_OVN_LISTEN:-}
attempts=${PVN_OVN_LISTENER_ATTEMPTS:-20}
retry_delay=${PVN_OVN_LISTENER_RETRY_DELAY:-1}

valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_port "$nb_port" || { echo "invalid PVN_OVN_NB_PORT" >&2; exit 2; }
valid_port "$sb_port" || { echo "invalid PVN_OVN_SB_PORT" >&2; exit 2; }
[ "$attempts" -ge 1 ] 2>/dev/null && [ "$attempts" -le 20 ] 2>/dev/null || {
    echo "PVN_OVN_LISTENER_ATTEMPTS must be between 1 and 20" >&2
    exit 2
}
[ "$retry_delay" -ge 0 ] 2>/dev/null && [ "$retry_delay" -le 1 ] 2>/dev/null || {
    echo "PVN_OVN_LISTENER_RETRY_DELAY must be between 0 and 1 second" >&2
    exit 2
}
[ "$nb_port" = 6641 ] || { echo "PVN OVN NB client port must be 6641" >&2; exit 2; }
[ "$sb_port" = 6642 ] || { echo "PVN OVN SB client port must be 6642" >&2; exit 2; }
if ! printf '%s\n' "$listen" | awk -F. '
    NF != 4 { exit 1 }
    {
        for (i = 1; i <= 4; i++) {
            if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
        }
    }
'; then
    echo "PVN_OVN_LISTEN must be an IPv4 address" >&2
    exit 2
fi
[ "$listen" != 0.0.0.0 ] || {
    echo "PVN_OVN_LISTEN must not use the IPv4 wildcard address" >&2
    exit 2
}

appctl=/usr/bin/ovs-appctl

configure_listener() {
    label=$1
    control_socket=$2
    unix_remote=$3
    database_remote=$4
    endpoint=$5
    attempt=1
    last_error=

    while [ "$attempt" -le "$attempts" ]; do
        status=0
        configure_listener_once || status=$?
        if [ "$status" -eq 0 ]; then
            return 0
        fi
        if [ "$status" -eq 2 ]; then
            echo "$last_error" >&2
            return 1
        fi
        if [ "$attempt" -lt "$attempts" ]; then
            sleep "$retry_delay"
        fi
        attempt=$((attempt + 1))
    done

    echo "$label database did not become ready after $attempts attempts" >&2
    [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
    return 1
}

inspect_remotes() {
    remotes=$1
    saw_unix=0
    saw_database=0
    saw_endpoint=0
    old_ifs=$IFS
    IFS='
'
    for remote in $remotes; do
        case "$remote" in
            "$unix_remote") saw_unix=$((saw_unix + 1)) ;;
            "$database_remote") saw_database=$((saw_database + 1)) ;;
            "$endpoint") saw_endpoint=$((saw_endpoint + 1)) ;;
            *)
                IFS=$old_ifs
                last_error="$label database exposes unexpected process remote: $remote"
                return 2
                ;;
        esac
    done
    IFS=$old_ifs
    if [ "$saw_unix" -ne 1 ] || [ "$saw_database" -gt 1 ] || \
        [ "$saw_endpoint" -gt 1 ]; then
        last_error="$label database process remote set is incomplete or duplicated"
        return 2
    fi
    return 0
}

list_remotes() {
    if ! listed=$("$appctl" --timeout=3 --target="$control_socket" \
        ovsdb-server/list-remotes 2>&1); then
        last_error="$label database list-remotes failed: $listed"
        return 1
    fi
    inspect_remotes "$listed"
}

configure_listener_once() {
    status=0
    list_remotes || status=$?
    [ "$status" -eq 0 ] || return "$status"
    if [ "$saw_database" -eq 0 ] && [ "$saw_endpoint" -eq 1 ]; then
        return 0
    fi

    # Establish the node-local TLS endpoint before detaching the replicated
    # remote source. A failed add leaves the existing listener source intact;
    # a failed remove leaves both allowed remotes for the next retry.
    if [ "$saw_endpoint" -eq 0 ]; then
        if ! changed=$("$appctl" --timeout=3 --target="$control_socket" \
            ovsdb-server/add-remote "$endpoint" 2>&1); then
            last_error="$label database add-remote failed: $changed"
            return 1
        fi
    fi
    if [ "$saw_database" -eq 1 ]; then
        if ! changed=$("$appctl" --timeout=3 --target="$control_socket" \
            ovsdb-server/remove-remote "$database_remote" 2>&1); then
            last_error="$label database remove-remote failed: $changed"
            return 1
        fi
    fi

    status=0
    list_remotes || status=$?
    [ "$status" -eq 0 ] || return "$status"
    if [ "$saw_database" -eq 0 ] && [ "$saw_endpoint" -eq 1 ]; then
        return 0
    fi
    last_error="$label database process listener did not converge to the exact local remote set"
    return 1
}

configure_nb() {
    configure_listener NB /run/ovn/ovnnb_db.ctl \
        punix:/var/run/ovn/ovnnb_db.sock \
        db:OVN_Northbound,NB_Global,connections \
        "pssl:${nb_port}:${listen}"
}

configure_sb() {
    configure_listener SB /run/ovn/ovnsb_db.ctl \
        punix:/var/run/ovn/ovnsb_db.sock \
        db:OVN_Southbound,SB_Global,connections \
        "pssl:${sb_port}:${listen}"
}

case $# in
    0)
        configure_nb
        configure_sb
        ;;
    1)
        case "$1" in
            nb) configure_nb ;;
            sb) configure_sb ;;
            *) echo "usage: ${0##*/} [nb|sb]" >&2; exit 2 ;;
        esac
        ;;
    *) echo "usage: ${0##*/} [nb|sb]" >&2; exit 2 ;;
esac

exit 0
