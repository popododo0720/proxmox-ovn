#!/bin/sh
set -eu

nb_port=${PVN_OVN_NB_PORT:-6641}
sb_port=${PVN_OVN_SB_PORT:-6642}

valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_port "$nb_port" || { echo "invalid PVN_OVN_NB_PORT" >&2; exit 2; }
valid_port "$sb_port" || { echo "invalid PVN_OVN_SB_PORT" >&2; exit 2; }
[ "$nb_port" = 6641 ] || { echo "PVN OVN NB client port must be 6641" >&2; exit 2; }
[ "$sb_port" = 6642 ] || { echo "PVN OVN SB client port must be 6642" >&2; exit 2; }

nb_socket=unix:/run/ovn/ovnnb_db.sock
sb_socket=unix:/run/ovn/ovnsb_db.sock

/usr/bin/ovn-nbctl --timeout=30 --db="$nb_socket" \
    --inactivity-probe=60000 set-connection "pssl:${nb_port}"
/usr/bin/ovn-sbctl --timeout=30 --db="$sb_socket" \
    --inactivity-probe=60000 set-connection "pssl:${sb_port}"

exit 0
