# Install as /etc/pvn/central/ovn-central.env on the second and third voters.
# Replace the local address and keep the first healthy voter as the remote.
PVN_OVN_BOOTSTRAP=join
OVN_CTL_OPTS="--db-nb-cluster-local-addr=10.0.0.12 --db-nb-cluster-local-port=6643 --db-nb-cluster-local-proto=ssl --db-nb-cluster-remote-addr=10.0.0.11 --db-nb-cluster-remote-port=6643 --db-nb-cluster-remote-proto=ssl --db-sb-cluster-local-addr=10.0.0.12 --db-sb-cluster-local-port=6644 --db-sb-cluster-local-proto=ssl --db-sb-cluster-remote-addr=10.0.0.11 --db-sb-cluster-remote-port=6644 --db-sb-cluster-remote-proto=ssl --db-nb-create-insecure-remote=no --db-sb-create-insecure-remote=no --ovn-nb-db-ssl-key=/etc/pvn/pki/node-key.pem --ovn-nb-db-ssl-cert=/etc/pvn/pki/node.pem --ovn-nb-db-ssl-ca-cert=/etc/pvn/pki/ca.pem --ovn-nb-db-ssl-protocols=TLSv1.2,TLSv1.3 --ovn-sb-db-ssl-key=/etc/pvn/pki/node-key.pem --ovn-sb-db-ssl-cert=/etc/pvn/pki/node.pem --ovn-sb-db-ssl-ca-cert=/etc/pvn/pki/ca.pem --ovn-sb-db-ssl-protocols=TLSv1.2,TLSv1.3"
