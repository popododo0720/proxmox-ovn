#!/bin/sh
# Install pvn-node from one deployment host without activating PVN or touching
# host networking. The install phase is a dry run unless both --apply and a
# matching --confirm value are supplied.
set -eu

PROGRAM=${0##*/}
SCRIPT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
PHASE=
INVENTORY=
IDENTITY=
LOCAL_PVE=false
DEB=
APPLY=false
CONFIRM=
SSH_BIN=${PVN_SSH_BIN:-ssh}
SCP_BIN=${PVN_SCP_BIN:-scp}
CP_BIN=${PVN_CP_BIN:-cp}
LOCAL_SH_BIN=${PVN_LOCAL_SH_BIN:-sh}
PYTHON_BIN=${PVN_PYTHON_BIN:-python3}
PVECM_BIN=${PVN_PVECM_BIN:-pvecm}
PVE_MEMBERS_FILE=${PVN_PVE_MEMBERS_FILE:-/etc/pve/.members}
PVE_COROSYNC_CONF=${PVN_PVE_COROSYNC_CONF:-/etc/pve/corosync.conf}
PVE_NODES_DIR=${PVN_PVE_NODES_DIR:-/etc/pve/nodes}
PVE_CLUSTER_IDENTITY=${PVN_PVE_IDENTITY:-/root/.ssh/id_rsa}
if [ -n "${PVN_CLUSTER_LEASE_BIN:-}" ]; then
    CLUSTER_LEASE_BIN=$PVN_CLUSTER_LEASE_BIN
elif [ -x "$SCRIPT_DIR/pvn-cluster-lease" ]; then
    CLUSTER_LEASE_BIN=$SCRIPT_DIR/pvn-cluster-lease
else
    CLUSTER_LEASE_BIN=/usr/lib/pvn/pvn-cluster-lease
fi
CURRENT_HOST=
CURRENT_REMOTE_DEB=
STAGED_RECORDS=
PVE_MODE=
PVE_LOCAL_NODE=
PVE_NODE_RECORDS=
PVE_DISCOVERY_SNAPSHOT=
PVE_CONFIRM_ID=
PVE_GLOBAL_LOCK_TOKEN=
PVE_GLOBAL_LOCK_HELD=false

usage() {
    cat >&2 <<EOF
usage:
  $PROGRAM preflight --local-pve
  $PROGRAM install --local-pve --deb FILE [--apply --confirm DEPLOYMENT_ID]
  $PROGRAM preflight --inventory FILE --identity PRIVATE_KEY
  $PROGRAM install --inventory FILE --identity PRIVATE_KEY --deb FILE [--apply --confirm CLUSTER_ID]

preflight is always read-only. install is also read-only unless --apply and a
matching --confirm value are both used. --local-pve discovers a local standalone
PVE node or every online member of its quorate PVE cluster.
EOF
    exit 2
}

fail() {
    echo "$PROGRAM: $*" >&2
    exit 1
}

need_value() {
    [ "$#" -ge 2 ] || usage
    [ -n "$2" ] || usage
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        preflight|install)
            [ -z "$PHASE" ] || usage
            PHASE=$1
            shift
            ;;
        --inventory)
            need_value "$@"
            INVENTORY=$2
            shift 2
            ;;
        --identity)
            need_value "$@"
            IDENTITY=$2
            shift 2
            ;;
        --local-pve)
            LOCAL_PVE=true
            shift
            ;;
        --deb)
            need_value "$@"
            DEB=$2
            shift 2
            ;;
        --apply)
            APPLY=true
            shift
            ;;
        --confirm)
            need_value "$@"
            CONFIRM=$2
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            usage
            ;;
    esac
done

[ -n "$PHASE" ] || usage

validate_identity() {
    pvn_identity=$1
    [ -r "$pvn_identity" ] && [ -f "$pvn_identity" ] ||
        fail "SSH identity is not a readable regular file: $pvn_identity"
    [ ! -L "$pvn_identity" ] ||
        fail "SSH identity must not be a symlink: $pvn_identity"

    pvn_identity_owner=$(stat -c '%u' "$pvn_identity" 2>/dev/null || true)
    pvn_identity_mode=$(stat -c '%a' "$pvn_identity" 2>/dev/null || true)
    [ "$pvn_identity_owner" = "$(id -u)" ] ||
        fail "SSH identity must be owned by the deployment user"
    case "$pvn_identity_mode" in
        400|600) ;;
        *)
            fail "SSH identity mode must be 0400 or 0600 (found ${pvn_identity_mode:-unknown})"
            ;;
    esac
}

if [ "$LOCAL_PVE" = true ]; then
    [ -z "$INVENTORY" ] && [ -z "$IDENTITY" ] ||
        fail "--local-pve cannot be combined with --inventory or --identity"
    [ "$(id -u)" -eq 0 ] || fail "--local-pve must run as root on a PVE node"
else
    [ -n "$INVENTORY" ] || usage
    [ -n "$IDENTITY" ] || usage
    [ -r "$INVENTORY" ] && [ -f "$INVENTORY" ] ||
        fail "inventory is not a readable regular file: $INVENTORY"
    validate_identity "$IDENTITY"
fi

case "$PHASE" in
    preflight)
        [ "$APPLY" = false ] || fail "preflight is read-only and does not accept --apply"
        [ -z "$DEB" ] || fail "preflight does not accept --deb"
        ;;
    install)
        [ -n "$DEB" ] || usage
        [ -r "$DEB" ] && [ -f "$DEB" ] ||
            fail "DEB is not a readable regular file: $DEB"
        case "$DEB" in
            */*) pvn_deb_dir=${DEB%/*}; pvn_deb_name=${DEB##*/} ;;
            *) pvn_deb_dir=.; pvn_deb_name=$DEB ;;
        esac
        pvn_deb_dir=$(CDPATH= cd -P "$pvn_deb_dir" && pwd) ||
            fail "cannot resolve DEB directory: $pvn_deb_dir"
        DEB=$pvn_deb_dir/$pvn_deb_name
        if [ "$APPLY" = true ]; then
            [ -n "$CONFIRM" ] ||
                fail "--apply requires --confirm DEPLOYMENT_ID"
        fi
        ;;
esac

for command_name in sed awk grep wc stat id; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "required command is unavailable: $command_name"
done

NODES=
NODE_COUNT=0

if [ "$LOCAL_PVE" = false ]; then
    command -v "$SSH_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $SSH_BIN"

    # Read only the one supported field. Never source an inventory: doing so
    # would execute arbitrary shell code on the deployment host.
    inventory_values=$(sed -n \
        's/^[[:space:]]*PVN_TARGET_NODES[[:space:]]*=[[:space:]]*//p' \
        "$INVENTORY")
    inventory_lines=$(printf '%s\n' "$inventory_values" |
        awk 'NF { count++ } END { print count + 0 }')
    [ "$inventory_lines" -eq 1 ] ||
        fail "inventory must contain exactly one PVN_TARGET_NODES assignment"

    case "$inventory_values" in
        \"*\") inventory_values=${inventory_values#\"}; inventory_values=${inventory_values%\"} ;;
        \'*\') inventory_values=${inventory_values#\'}; inventory_values=${inventory_values%\'} ;;
    esac

    for node in $inventory_values; do
        case "$node" in
            ''|*[!A-Za-z0-9._-]*|-*)
                fail "unsafe node name in inventory: $node"
                ;;
        esac
        case " $NODES " in
            *" $node "*) fail "duplicate node in inventory: $node" ;;
        esac
        NODES=${NODES:+$NODES }$node
        NODE_COUNT=$((NODE_COUNT + 1))
    done
    [ "$NODE_COUNT" -gt 0 ] || fail "inventory contains no target nodes"
fi

discover_local_pve_snapshot() {
    command -v "$PYTHON_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $PYTHON_BIN"
    command -v "$PVECM_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $PVECM_BIN"

    "$PYTHON_BIN" - "$PVE_MEMBERS_FILE" "$PVE_COROSYNC_CONF" \
        "$PVECM_BIN" "$PVE_NODES_DIR" <<'PVN_DISCOVER'
import ipaddress
import json
import os
import re
import stat
import subprocess
import sys


def fail(message):
    print(f"PVN local PVE discovery failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def safe_name(value, label):
    pattern = r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?"
    if not isinstance(value, str) or not re.fullmatch(pattern, value) or value in {".", ".."}:
        fail(f"{label} is unsafe or empty")
    return value


def safe_int(value, label, minimum=0):
    if type(value) is not int or value < minimum:
        fail(f"{label} is not a valid integer")
    return value


def secure_regular(path, label):
    try:
        metadata = os.lstat(path)
    except OSError as error:
        fail(f"cannot inspect {label}: {error}")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        fail(f"{label} is not a regular non-symlink file")
    if metadata.st_uid != 0:
        fail(f"{label} is not owned by root")
    if stat.S_IMODE(metadata.st_mode) & 0o022:
        fail(f"{label} is group- or world-writable")


members_path, corosync_path, pvecm, nodes_dir = sys.argv[1:]
secure_regular(members_path, members_path)
try:
    with open(members_path, "r", encoding="utf-8") as members_file:
        data = json.load(members_file)
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    fail(f"cannot parse {members_path}: {error}")

if not isinstance(data, dict):
    fail(".members root must be an object")
local_name = safe_name(data.get("nodename"), ".members nodename")
members_version = safe_int(data.get("version", 0), ".members version")
nodelist = data.get("nodelist")
cluster = data.get("cluster")
has_corosync = os.path.exists(corosync_path)
records = []

if isinstance(cluster, dict) and cluster.get("name"):
    if not has_corosync:
        fail(".members reports a cluster but corosync.conf is absent")
    cluster_name = safe_name(cluster.get("name"), "cluster name")
    cluster_version = safe_int(cluster.get("version"), "cluster version")
    cluster_nodes = safe_int(cluster.get("nodes"), "cluster node count", 1)
    quorate = safe_int(cluster.get("quorate"), "cluster quorum state")
    if quorate != 1:
        fail("PVE cluster is not quorate")
    if not isinstance(nodelist, dict) or len(nodelist) != cluster_nodes:
        fail(".members nodelist count does not match cluster.nodes")
    if local_name not in nodelist:
        fail("local nodename is missing from .members nodelist")

    seen_ids = set()
    for name, member in nodelist.items():
        safe_name(name, "node name")
        if not isinstance(member, dict):
            fail(f"node {name} record is not an object")
        node_id = safe_int(member.get("id"), f"node {name} id", 1)
        if node_id in seen_ids:
            fail(f"duplicate PVE node id {node_id}")
        seen_ids.add(node_id)
        if safe_int(member.get("online"), f"node {name} online state") != 1:
            fail(f"PVE node {name} is offline")
        address = member.get("ip")
        if not isinstance(address, str):
            fail(f"node {name} has no management IP")
        try:
            address = str(ipaddress.ip_address(address))
        except ValueError:
            fail(f"node {name} has an invalid management IP")
        records.append((node_id, name, address, name == local_name))

    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    status_result = subprocess.run(
        [pvecm, "status"], text=True, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, env=environment, check=False,
    )
    if status_result.returncode != 0:
        fail("pvecm status failed for a configured cluster")

    def status_field(label, pattern):
        values = re.findall(pattern, status_result.stdout, re.MULTILINE)
        if len(values) != 1:
            fail(f"pvecm status has an invalid {label} field")
        return values[0]

    if status_field("name", r"^Name:\s+(\S+)\s*$") != cluster_name:
        fail("pvecm cluster name differs from .members")
    if int(status_field("node count", r"^Nodes:\s+(\d+)\s*$")) != cluster_nodes:
        fail("pvecm node count differs from .members")
    if status_field("quorum", r"^Quorate:\s+(Yes|No)\s*$") != "Yes":
        fail("pvecm reports a non-quorate cluster")

    nodes_result = subprocess.run(
        [pvecm, "nodes"], text=True, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, env=environment, check=False,
    )
    if nodes_result.returncode != 0:
        fail("pvecm nodes failed for a configured cluster")
    live_members = {}
    local_markers = []
    for line in nodes_result.stdout.splitlines():
        match = re.fullmatch(
            r"\s*(\d+)\s+\d+\s+([A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)(\s+\(local\))?\s*",
            line,
        )
        if not match:
            continue
        node_id = int(match.group(1))
        name = match.group(2)
        if name in live_members:
            fail(f"pvecm nodes repeats node {name}")
        live_members[name] = node_id
        if match.group(3):
            local_markers.append(name)
    expected_members = {name: node_id for node_id, name, _, _ in records}
    if live_members != expected_members:
        fail("pvecm live membership differs from .members nodelist")
    if local_markers != [local_name]:
        fail("pvecm local node marker differs from .members nodename")

    for _, name, _, is_local in records:
        if is_local:
            continue
        known_hosts = os.path.join(nodes_dir, name, "ssh_known_hosts")
        secure_regular(known_hosts, known_hosts)
        try:
            with open(known_hosts, "r", encoding="ascii") as known_hosts_file:
                host_lines = [
                    line.strip() for line in known_hosts_file
                    if line.strip() and not line.lstrip().startswith("#")
                ]
        except (OSError, UnicodeError) as error:
            fail(f"cannot read {known_hosts}: {error}")
        if not host_lines:
            fail(f"{known_hosts} contains no pinned host key")
        for host_line in host_lines:
            fields = host_line.split()
            if len(fields) < 3 or fields[0] != name:
                fail(f"{known_hosts} does not exclusively pin alias {name}")

    mode = "cluster"
    confirm_id = cluster_name
else:
    if has_corosync:
        fail("corosync.conf exists but .members has no cluster")
    cluster_version = 0
    if nodelist is None:
        records = [(0, local_name, "local", True)]
    else:
        if not isinstance(nodelist, dict) or set(nodelist) != {local_name}:
            fail("standalone .members must contain only the local node")
        member = nodelist[local_name]
        if not isinstance(member, dict):
            fail("standalone local node record is not an object")
        node_id = safe_int(member.get("id", 0), "standalone node id")
        if safe_int(member.get("online", 1), "standalone online state") != 1:
            fail("standalone local node is offline")
        address = member.get("ip", "local")
        if address != "local":
            if not isinstance(address, str):
                fail("standalone node IP is invalid")
            try:
                address = str(ipaddress.ip_address(address))
            except ValueError:
                fail("standalone node IP is invalid")
        records = [(node_id, local_name, address, True)]

    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    status_result = subprocess.run(
        [pvecm, "status"], text=True, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, env=environment, check=False,
    )
    if status_result.returncode == 0:
        fail("pvecm status succeeded although .members reports standalone mode")
    mode = "standalone"
    confirm_id = f"standalone-{local_name}"

records.sort(key=lambda record: (record[0], record[1]))
tokens = [
    "|".join(
        ["PVN_LOCAL", mode, confirm_id, str(cluster_version), local_name,
         str(len(records)), str(members_version)]
    )
]
for node_id, name, address, is_local in records:
    tokens.append(
        "|".join(
            ["PVN_NODE", name, address, str(node_id), "1" if is_local else "0"]
        )
    )
print(" ".join(tokens))
PVN_DISCOVER
}

load_local_pve_snapshot() {
    pvn_snapshot=$1
    set -- $pvn_snapshot
    [ "$#" -ge 2 ] || fail "local PVE discovery returned no node records"
    pvn_header=$1
    shift
    pvn_old_ifs=$IFS
    IFS='|'
    read -r pvn_tag pvn_mode pvn_confirm pvn_config_version \
        pvn_local pvn_count pvn_members_version <<EOF
$pvn_header
EOF
    IFS=$pvn_old_ifs
    [ "$pvn_tag" = PVN_LOCAL ] || fail "local PVE discovery returned a malformed header"
    case "$pvn_mode" in cluster|standalone) ;; *) fail "invalid local PVE mode" ;; esac
    case "$pvn_confirm" in
        ''|*[!A-Za-z0-9._-]*) fail "unsafe local PVE confirmation value" ;;
    esac
    case "$pvn_count" in ''|*[!0-9]*) fail "invalid local PVE node count" ;; esac
    [ "$pvn_count" -eq "$#" ] || fail "local PVE discovery node count mismatch"

    NODES=
    NODE_COUNT=0
    PVE_NODE_RECORDS=
    for pvn_record in "$@"; do
        IFS='|'
        read -r pvn_record_tag pvn_name pvn_ip pvn_id pvn_is_local <<EOF
$pvn_record
EOF
        IFS=$pvn_old_ifs
        [ "$pvn_record_tag" = PVN_NODE ] || fail "malformed local PVE node record"
        case "$pvn_name" in
            ''|*[!A-Za-z0-9._-]*|-*) fail "unsafe discovered PVE node name" ;;
        esac
        case "$pvn_id" in ''|*[!0-9]*) fail "invalid discovered PVE node id" ;; esac
        case "$pvn_is_local" in 0|1) ;; *) fail "invalid discovered local-node flag" ;; esac
        case " $NODES " in *" $pvn_name "*) fail "duplicate discovered PVE node" ;; esac
        NODES=${NODES:+$NODES }$pvn_name
        PVE_NODE_RECORDS=${PVE_NODE_RECORDS:+$PVE_NODE_RECORDS }$pvn_name,$pvn_ip,$pvn_id,$pvn_is_local
        NODE_COUNT=$((NODE_COUNT + 1))
    done

    PVE_MODE=$pvn_mode
    PVE_CONFIRM_ID=$pvn_confirm
    PVE_LOCAL_NODE=$pvn_local
}

verify_local_pve_snapshot() {
    [ "$LOCAL_PVE" = true ] || return 0
    pvn_fresh_snapshot=$(discover_local_pve_snapshot) ||
        fail "could not revalidate local PVE membership"
    [ "$pvn_fresh_snapshot" = "$PVE_DISCOVERY_SNAPSHOT" ] ||
        fail "PVE membership changed after the initial preflight"
}

local_pve_record() {
    pvn_wanted_node=$1
    for pvn_record in $PVE_NODE_RECORDS; do
        pvn_record_name=${pvn_record%%,*}
        if [ "$pvn_record_name" = "$pvn_wanted_node" ]; then
            printf '%s\n' "$pvn_record"
            return 0
        fi
    done
    return 1
}

if [ "$LOCAL_PVE" = true ]; then
    PVE_DISCOVERY_SNAPSHOT=$(discover_local_pve_snapshot) ||
        fail "local PVE discovery did not pass"
    load_local_pve_snapshot "$PVE_DISCOVERY_SNAPSHOT"
    command -v "$LOCAL_SH_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $LOCAL_SH_BIN"
    if [ "$PVE_MODE" = cluster ]; then
        command -v "$SSH_BIN" >/dev/null 2>&1 ||
            fail "required command is unavailable: $SSH_BIN"
        validate_identity "$PVE_CLUSTER_IDENTITY"
    fi
fi

acquire_pve_global_lock() {
    [ "$LOCAL_PVE" = true ] || return 0
    [ -x "$CLUSTER_LEASE_BIN" ] ||
        fail "PVE cluster lease helper is unavailable: $CLUSTER_LEASE_BIN"
    PVE_GLOBAL_LOCK_TOKEN=$("$PYTHON_BIN" -c \
        'import secrets; print(secrets.token_hex(24))') ||
        fail "could not generate the PVE cluster-global install token"
    case "$PVE_GLOBAL_LOCK_TOKEN" in
        ''|*[!0-9a-f]*) fail "cluster-global lock returned an invalid owner token" ;;
    esac
    pvn_lock_owner=$("$PYTHON_BIN" -c \
        'import json,sys,time; print(json.dumps({"domain":"mutation","deployment":sys.argv[1],"node":sys.argv[2],"pid":int(sys.argv[3]),"started":int(time.time()),"token":sys.argv[4]},sort_keys=True,separators=(",",":")))' \
        "$PVE_CONFIRM_ID" "$PVE_LOCAL_NODE" "$$" "$PVE_GLOBAL_LOCK_TOKEN") ||
        fail "could not create the PVE cluster-global install owner record"
    printf '%s\n' "$pvn_lock_owner" |
        "$CLUSTER_LEASE_BIN" acquire mutation "$PVE_GLOBAL_LOCK_TOKEN" >/dev/null ||
        fail "could not acquire the PVE cluster-global mutation lease"
    PVE_GLOBAL_LOCK_HELD=true
}

release_pve_global_lock() {
    [ "$PVE_GLOBAL_LOCK_HELD" = true ] || return 0
    if ! "$CLUSTER_LEASE_BIN" release mutation "$PVE_GLOBAL_LOCK_TOKEN"; then
        echo "$PROGRAM: warning: cluster-global mutation lease was not removed; run pvn-cluster-lease show mutation" >&2
        return 1
    fi
    PVE_GLOBAL_LOCK_HELD=false
    PVE_GLOBAL_LOCK_TOKEN=
}

emit_node_script() {
    cat <<'PVN_REMOTE'
set -eu

remote_fail() {
    echo "PVN cluster install precondition failed: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        remote_fail "required command is unavailable: $1"
}

package_state() {
    pvn_pkg_state=$(dpkg-query -W -f='${db:Status-Status}' pvn-node 2>/dev/null || true)
    case "$pvn_pkg_state" in
        '') echo absent ;;
        installed) echo installed ;;
        *) remote_fail "pvn-node has incomplete dpkg state: $pvn_pkg_state" ;;
    esac
}

check_inactive() {
    pvn_checked_package_state=$1
    for pvn_unit in \
        pvn-node.target pvn-central.target pvn-node-ready.service \
        pvn-manager.service pvn-agent.service pvn-ovn-host-config.service \
        pvn-control-db.service pvn-ovn-db-listeners.service \
        pvn-ovn-northd-ready.service \
        ovn-host.service ovn-central.service ovn-controller.service \
        ovn-ovsdb-server-nb.service ovn-ovsdb-server-sb.service \
        ovn-northd.service
    do
        pvn_load=$(systemctl show --property=LoadState --value "$pvn_unit" 2>/dev/null || true)
        case "$pvn_load" in
            loaded|masked)
                pvn_active=$(systemctl is-active "$pvn_unit" 2>/dev/null || true)
                [ "$pvn_active" = inactive ] ||
                    remote_fail "$pvn_unit must be inactive, found ${pvn_active:-unknown}"
                ;;
            not-found|'')
                [ "$pvn_checked_package_state" = absent ] ||
                    remote_fail "$pvn_unit is missing from an installed pvn-node package"
                ;;
            *)
                remote_fail "$pvn_unit has unsafe load state ${pvn_load:-unknown}"
                ;;
        esac
        pvn_enabled=$(systemctl is-enabled "$pvn_unit" 2>/dev/null || true)
        case "$pvn_enabled" in
            enabled|enabled-runtime|linked|linked-runtime|alias)
                if [ "$pvn_checked_package_state" = installed ]; then
                    case "$pvn_unit" in
                        ovn-ovsdb-server-nb.service|ovn-ovsdb-server-sb.service)
                            # Debian enables these database units. The packaged
                            # ConditionPathExists central marker keeps this
                            # exact inert retry from starting them.
                            ;;
                        *) remote_fail "$pvn_unit is enabled" ;;
                    esac
                else
                    remote_fail "$pvn_unit is enabled before first installation"
                fi
                ;;
            not-found|'')
                [ "$pvn_checked_package_state" = absent ] ||
                    remote_fail "$pvn_unit enable state is unknown"
                ;;
        esac
        if [ "$pvn_checked_package_state" = installed ]; then
            case "$pvn_unit" in
                ovn-host.service|ovn-central.service)
                    [ "$pvn_enabled" = masked ] ||
                        remote_fail "$pvn_unit must remain masked"
                    ;;
            esac
        fi
    done

    [ ! -e /etc/pvn/node-enabled ] ||
        remote_fail "/etc/pvn/node-enabled exists"
    [ ! -e /etc/pvn/central/enabled ] ||
        remote_fail "/etc/pvn/central/enabled exists"
}

check_absent_ownership() {
    if [ -d /etc/pvn ] && find /etc/pvn -mindepth 1 -print -quit | grep -q .; then
        remote_fail "stale /etc/pvn state exists before first installation"
    fi
    [ ! -e /var/lib/ovn/ovnnb_db.db ] ||
        remote_fail "an existing OVN Northbound database is present"
    [ ! -e /var/lib/ovn/ovnsb_db.db ] ||
        remote_fail "an existing OVN Southbound database is present"

    if command -v ovs-vsctl >/dev/null 2>&1; then
        if ! pvn_ovs_external_ids=$(ovs-vsctl --timeout=10 --data=bare \
            --no-heading get Open_vSwitch . external_ids 2>/dev/null); then
            remote_fail "existing OVS ownership cannot be inspected"
        fi
        for pvn_ovs_key in \
            ovn-remote ovn-encap-ip ovn-encap-type ovn-bridge ovn-bridge-mappings
        do
            case "$pvn_ovs_external_ids" in
                *"$pvn_ovs_key"*)
                    remote_fail "existing OVS external_id $pvn_ovs_key is already owned"
                    ;;
            esac
        done
    fi
}

check_pve_and_quorum() {
    pvn_pve_version=$(dpkg-query -W -f='${Version}' pve-manager 2>/dev/null || true)
    pvn_pve_version=${pvn_pve_version#*:}
    case "$pvn_pve_version" in
        9|9.*) ;;
        *) remote_fail "PVE 9 is required; found ${pvn_pve_version:-unknown}" ;;
    esac

    pvn_hostname=$(perl -MPVE::INotify -e 'print PVE::INotify::nodename()' 2>/dev/null) ||
        remote_fail "cannot determine the local PVE nodename"
    case "$pvn_hostname" in
        ''|*[!A-Za-z0-9._-]*|.|..) remote_fail "unsafe or empty PVE nodename" ;;
    esac

    if [ -e /etc/pve/corosync.conf ]; then
        pvn_mode=cluster
        pvn_cluster_status=$(LC_ALL=C pvecm status 2>/dev/null) ||
            remote_fail "pvecm status failed"
        pvn_cluster_id=$(printf '%s\n' "$pvn_cluster_status" |
            awk '$1 == "Name:" { print $2; found++ } END { if (found != 1) exit 1 }') ||
            remote_fail "cannot determine the PVE cluster name"
        case "$pvn_cluster_id" in
            ''|*[!A-Za-z0-9._-]*) remote_fail "unsafe PVE cluster name" ;;
        esac
        pvn_quorate=$(printf '%s\n' "$pvn_cluster_status" |
            awk '$1 == "Quorate:" { print $2; found++ } END { if (found != 1) exit 1 }') ||
            remote_fail "cannot determine quorum state"
        [ "$pvn_quorate" = Yes ] || remote_fail "PVE cluster is not quorate"
        pvn_cluster_nodes=$(printf '%s\n' "$pvn_cluster_status" |
            awk '$1 == "Nodes:" { print $2; found++ } END { if (found != 1) exit 1 }') ||
            remote_fail "cannot determine cluster node count"
        case "$pvn_cluster_nodes" in
            ''|*[!0-9]*) remote_fail "invalid cluster node count" ;;
        esac
        pvn_node_id_raw=$(printf '%s\n' "$pvn_cluster_status" |
            awk '$1 == "Node" && $2 == "ID:" { print $3; found++ } END { if (found != 1) exit 1 }') ||
            remote_fail "cannot determine local PVE node ID"
        case "$pvn_node_id_raw" in
            ''|*[!A-Fa-f0-9x]*) remote_fail "invalid local PVE node ID" ;;
        esac
        pvn_node_id=$(printf '%d\n' "$pvn_node_id_raw" 2>/dev/null) ||
            remote_fail "invalid local PVE node ID"
    else
        pvn_mode=standalone
        if LC_ALL=C pvecm status >/dev/null 2>&1; then
            remote_fail "pvecm status succeeded without corosync.conf"
        fi
        require_command python3
        pvn_standalone_record=$(python3 -c '
import json, sys
with open("/etc/pve/.members", encoding="utf-8") as source:
    data = json.load(source)
name = data.get("nodename")
nodes = data.get("nodelist")
if data.get("cluster") or (nodes is not None and set(nodes) != {name}):
    raise SystemExit(1)
node_id = 0 if nodes is None else nodes[name].get("id", 0)
if type(node_id) is not int or node_id < 0:
    raise SystemExit(1)
print(f"{name}|{node_id}")
' 2>/dev/null) || remote_fail "cannot validate standalone .members"
        pvn_old_ifs=$IFS
        IFS='|'
        read -r pvn_standalone_name pvn_node_id <<EOF
$pvn_standalone_record
EOF
        IFS=$pvn_old_ifs
        [ "$pvn_standalone_name" = "$pvn_hostname" ] ||
            remote_fail "standalone .members nodename differs from local PVE nodename"
        case "$pvn_node_id" in
            ''|*[!0-9]*) remote_fail "invalid standalone PVE node ID" ;;
        esac
        pvn_cluster_id=standalone-$pvn_hostname
        pvn_cluster_nodes=1
    fi
}

check_clean_ui_template() {
    pvn_template=/usr/share/pve-manager/index.html.tpl
    pvn_loader=/usr/share/pve-manager/js/pvn-loader.js
    [ -f "$pvn_template" ] || remote_fail "PVE UI template is missing"
    [ ! -L "$pvn_template" ] || remote_fail "PVE UI template is a symlink"

    awk '
        $0 == "    <script type=\"text/javascript\" src=\"/pve2/js/pvemanagerlib.js?ver=[% version %]\"></script>" { anchors++ }
        index($0, "<!-- PVN-LOADER:BEGIN -->") { begins++ }
        index($0, "<!-- PVN-LOADER:END -->") { ends++ }
        index($0, "/pve2/js/pvn-loader.js") { tags++ }
        END {
            if (anchors != 1 || begins != 0 || ends != 0 || tags != 0) exit 1
        }
    ' "$pvn_template" ||
        remote_fail "PVE 9 UI template is unsupported, malformed, or already modified"
    [ ! -e "$pvn_loader" ] ||
        remote_fail "an unmanaged PVN UI loader already exists"
}

check_ui() {
    pvn_package_state=$1
    if [ "$pvn_package_state" = installed ]; then
        [ -x /usr/lib/pvn/pvn-ui-verify ] ||
            remote_fail "installed pvn-ui-verify is missing"
        /usr/lib/pvn/pvn-ui-verify ||
            remote_fail "installed PVN UI verification failed"
    else
        check_clean_ui_template
    fi
}

run_preflight() {
    require_command dpkg-query
    require_command pvecm
    require_command systemctl
    require_command awk
    require_command dpkg
    require_command sha256sum
    require_command apt-get
    require_command find
    require_command grep
    require_command perl
    [ "$(id -u)" -eq 0 ] || remote_fail "execution user is not root"

    pvn_package_state=$(package_state)
    check_pve_and_quorum
    check_inactive "$pvn_package_state"
    check_ui "$pvn_package_state"
    if [ "$pvn_package_state" = absent ]; then
        check_absent_ownership
        pvn_package_version=absent
    else
        pvn_package_version=$(dpkg-query -W -f='${Version}' pvn-node 2>/dev/null || true)
        [ -n "$pvn_package_version" ] ||
            remote_fail "installed pvn-node version cannot be determined"
    fi
    pvn_arch=$(dpkg --print-architecture)
    case "$pvn_arch" in
        ''|*[!A-Za-z0-9_-]*) remote_fail "invalid dpkg architecture" ;;
    esac
}

pvn_action=${1:-}
shift || true
case "$pvn_action" in
    probe)
        [ "$#" -eq 0 ] || remote_fail "invalid probe arguments"
        run_preflight
        printf 'PVN_PREFLIGHT mode=%s cluster=%s nodes=%s pve=%s arch=%s package=%s version=%s hostname=%s nodeid=%s\n' \
            "$pvn_mode" "$pvn_cluster_id" "$pvn_cluster_nodes" "$pvn_pve_version" \
            "$pvn_arch" "$pvn_package_state" "$pvn_package_version" \
            "$pvn_hostname" "$pvn_node_id"
        ;;
    prepare)
        [ "$#" -eq 0 ] || remote_fail "invalid prepare arguments"
        require_command mktemp
        umask 077
        mktemp /var/tmp/pvn-node.XXXXXXXX.deb
        ;;
    verify)
        [ "$#" -eq 2 ] || remote_fail "invalid verify arguments"
        pvn_remote_deb=$1
        pvn_expected_sha=$2
        case "$pvn_remote_deb" in
            /var/tmp/pvn-node.*.deb) ;;
            *) remote_fail "unsafe staged package path" ;;
        esac
        case "$pvn_expected_sha" in
            *[!0-9a-f]*|'') remote_fail "invalid expected SHA-256" ;;
        esac
        [ "${#pvn_expected_sha}" -eq 64 ] || remote_fail "invalid expected SHA-256 length"
        [ -f "$pvn_remote_deb" ] && [ ! -L "$pvn_remote_deb" ] ||
            remote_fail "staged package is not a regular file"
        pvn_actual_sha=$(sha256sum -- "$pvn_remote_deb" | awk '{ print $1 }')
        [ "$pvn_actual_sha" = "$pvn_expected_sha" ] ||
            remote_fail "staged package SHA-256 mismatch"
        ;;
    apply)
        [ "$#" -eq 4 ] || remote_fail "invalid apply arguments"
        pvn_remote_deb=$1
        pvn_expected_sha=$2
        pvn_expected_version=$3
        pvn_expected_arch=$4
        case "$pvn_remote_deb" in
            /var/tmp/pvn-node.*.deb) ;;
            *) remote_fail "unsafe staged package path" ;;
        esac

        # Recheck every safety condition immediately before the first write to
        # systemd state. This also prevents an active PVN node from being
        # treated as an idempotent package upgrade.
        run_preflight
        [ "$pvn_expected_arch" = all ] || [ "$pvn_arch" = "$pvn_expected_arch" ] ||
            remote_fail "package architecture $pvn_expected_arch does not match $pvn_arch"
        pvn_actual_sha=$(sha256sum -- "$pvn_remote_deb" | awk '{ print $1 }')
        [ "$pvn_actual_sha" = "$pvn_expected_sha" ] ||
            remote_fail "staged package changed after verification"

        # Aggregate OVN units are masked before apt can install dependencies.
        # No bridge, interface, provider uplink, or activation marker is touched.
        systemctl mask ovn-host.service ovn-central.service >/dev/null
        [ "$(systemctl is-enabled ovn-host.service 2>/dev/null || true)" = masked ] ||
            remote_fail "ovn-host.service could not be masked"
        [ "$(systemctl is-enabled ovn-central.service 2>/dev/null || true)" = masked ] ||
            remote_fail "ovn-central.service could not be masked"

        DEBIAN_FRONTEND=noninteractive apt-get install -y -- "$pvn_remote_deb"

        pvn_installed_version=$(dpkg-query -W -f='${Version}' pvn-node 2>/dev/null || true)
        [ "$pvn_installed_version" = "$pvn_expected_version" ] ||
            remote_fail "installed pvn-node version does not match the DEB"
        [ "$(systemctl is-enabled ovn-host.service 2>/dev/null || true)" = masked ] ||
            remote_fail "ovn-host.service is not masked after installation"
        [ "$(systemctl is-enabled ovn-central.service 2>/dev/null || true)" = masked ] ||
            remote_fail "ovn-central.service is not masked after installation"
        check_inactive installed
        [ "$(package_state)" = installed ] ||
            remote_fail "pvn-node is not completely installed"
        check_ui installed
        ;;
    cleanup)
        [ "$#" -eq 1 ] || remote_fail "invalid cleanup arguments"
        pvn_remote_deb=$1
        case "$pvn_remote_deb" in
            /var/tmp/pvn-node.*.deb) rm -f -- "$pvn_remote_deb" ;;
            *) remote_fail "unsafe staged package path" ;;
        esac
        ;;
    *)
        remote_fail "unknown remote action"
        ;;
esac
PVN_REMOTE
}

node_run() {
    pvn_run_host=$1
    shift
    if [ "$LOCAL_PVE" = true ]; then
        pvn_run_record=$(local_pve_record "$pvn_run_host") ||
            fail "no local PVE transport record for $pvn_run_host"
        pvn_old_ifs=$IFS
        IFS=','
        read -r pvn_run_name pvn_run_ip pvn_run_id pvn_run_local <<EOF
$pvn_run_record
EOF
        IFS=$pvn_old_ifs
        if [ "$pvn_run_local" = 1 ]; then
            emit_node_script | PVN_NODE_NAME="$pvn_run_name" \
                "$LOCAL_SH_BIN" -s -- "$@"
            return
        fi
        pvn_known_hosts=$PVE_NODES_DIR/$pvn_run_name/ssh_known_hosts
        emit_node_script | "$SSH_BIN" -F /dev/null -e none \
            -i "$PVE_CLUSTER_IDENTITY" \
            -o BatchMode=yes \
            -o PasswordAuthentication=no \
            -o KbdInteractiveAuthentication=no \
            -o PubkeyAuthentication=yes \
            -o PreferredAuthentications=publickey \
            -o IdentitiesOnly=yes \
            -o NumberOfPasswordPrompts=0 \
            -o StrictHostKeyChecking=yes \
            -o UpdateHostKeys=no \
            -o CheckHostIP=no \
            -o "HostKeyAlias=$pvn_run_name" \
            -o "UserKnownHostsFile=$pvn_known_hosts" \
            -o GlobalKnownHostsFile=none \
            -o ConnectTimeout=10 \
            -- "root@$pvn_run_ip" sh -s -- "$@"
        return
    fi

    emit_node_script | "$SSH_BIN" \
        -i "$IDENTITY" \
        -o BatchMode=yes \
        -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no \
        -o PubkeyAuthentication=yes \
        -o PreferredAuthentications=publickey \
        -o IdentitiesOnly=yes \
        -o NumberOfPasswordPrompts=0 \
        -o StrictHostKeyChecking=yes \
        -o ConnectTimeout=10 \
        -- "root@$pvn_run_host" sh -s -- "$@"
}

node_copy_deb() {
    pvn_copy_host=$1
    pvn_copy_path=$2
    if [ "$LOCAL_PVE" = true ]; then
        pvn_copy_record=$(local_pve_record "$pvn_copy_host") ||
            fail "no local PVE transport record for $pvn_copy_host"
        pvn_old_ifs=$IFS
        IFS=','
        read -r pvn_copy_name pvn_copy_ip pvn_copy_id pvn_copy_local <<EOF
$pvn_copy_record
EOF
        IFS=$pvn_old_ifs
        if [ "$pvn_copy_local" = 1 ]; then
            "$CP_BIN" -- "$DEB" "$pvn_copy_path"
            return
        fi
        pvn_known_hosts=$PVE_NODES_DIR/$pvn_copy_name/ssh_known_hosts
        case "$pvn_copy_ip" in
            *:*) pvn_copy_target="root@[$pvn_copy_ip]:$pvn_copy_path" ;;
            *) pvn_copy_target="root@$pvn_copy_ip:$pvn_copy_path" ;;
        esac
        "$SCP_BIN" -q -F /dev/null \
            -i "$PVE_CLUSTER_IDENTITY" \
            -o BatchMode=yes \
            -o PasswordAuthentication=no \
            -o KbdInteractiveAuthentication=no \
            -o PubkeyAuthentication=yes \
            -o PreferredAuthentications=publickey \
            -o IdentitiesOnly=yes \
            -o NumberOfPasswordPrompts=0 \
            -o StrictHostKeyChecking=yes \
            -o UpdateHostKeys=no \
            -o CheckHostIP=no \
            -o "HostKeyAlias=$pvn_copy_name" \
            -o "UserKnownHostsFile=$pvn_known_hosts" \
            -o GlobalKnownHostsFile=none \
            -o ConnectTimeout=10 \
            -- "$DEB" "$pvn_copy_target"
        return
    fi

    "$SCP_BIN" -q \
        -i "$IDENTITY" \
        -o BatchMode=yes \
        -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no \
        -o PubkeyAuthentication=yes \
        -o PreferredAuthentications=publickey \
        -o IdentitiesOnly=yes \
        -o NumberOfPasswordPrompts=0 \
        -o StrictHostKeyChecking=yes \
        -o ConnectTimeout=10 \
        -- "$DEB" "root@$pvn_copy_host:$pvn_copy_path"
}

DISCOVERED_CLUSTER_ID=
DISCOVERED_ARCH=
DISCOVERED_PACKAGE_VERSIONS=

preflight_all() {
    pvn_expected_mode=
    pvn_expected_cluster=
    pvn_expected_arch=
    pvn_seen_hostnames=
    pvn_seen_node_ids=
    pvn_versions=
    for pvn_host in $NODES; do
        echo "[$pvn_host] read-only preflight"
        pvn_probe=$(node_run "$pvn_host" probe) ||
            fail "preflight failed on $pvn_host"
        set -- $pvn_probe
        [ "$#" -eq 10 ] && [ "$1" = PVN_PREFLIGHT ] ||
            fail "unexpected preflight response from $pvn_host"
        pvn_mode=${2#mode=}
        pvn_cluster=${3#cluster=}
        pvn_reported_nodes=${4#nodes=}
        pvn_pve=${5#pve=}
        pvn_arch=${6#arch=}
        pvn_package=${7#package=}
        pvn_package_version=${8#version=}
        pvn_hostname=${9#hostname=}
        pvn_node_id=${10#nodeid=}
        [ "$2" = "mode=$pvn_mode" ] &&
            [ "$3" = "cluster=$pvn_cluster" ] &&
            [ "$4" = "nodes=$pvn_reported_nodes" ] &&
            [ "$5" = "pve=$pvn_pve" ] &&
            [ "$6" = "arch=$pvn_arch" ] &&
            [ "$7" = "package=$pvn_package" ] &&
            [ "$8" = "version=$pvn_package_version" ] &&
            [ "$9" = "hostname=$pvn_hostname" ] &&
            [ "${10}" = "nodeid=$pvn_node_id" ] ||
            fail "malformed preflight response from $pvn_host"
        case "$pvn_mode" in cluster|standalone) ;; *) fail "invalid PVE mode from $pvn_host" ;; esac
        case "$pvn_node_id" in ''|*[!0-9]*) fail "invalid PVE node ID from $pvn_host" ;; esac
        [ "$pvn_reported_nodes" = "$NODE_COUNT" ] ||
            fail "$pvn_host reports $pvn_reported_nodes nodes, but the target set has $NODE_COUNT"
        if [ -z "$pvn_expected_cluster" ]; then
            pvn_expected_mode=$pvn_mode
            pvn_expected_cluster=$pvn_cluster
            pvn_expected_arch=$pvn_arch
        else
            [ "$pvn_mode" = "$pvn_expected_mode" ] ||
                fail "$pvn_host reports PVE mode $pvn_mode, expected $pvn_expected_mode"
            [ "$pvn_cluster" = "$pvn_expected_cluster" ] ||
                fail "$pvn_host belongs to cluster $pvn_cluster, expected $pvn_expected_cluster"
            [ "$pvn_arch" = "$pvn_expected_arch" ] ||
                fail "$pvn_host architecture $pvn_arch differs from $pvn_expected_arch"
        fi
        case " $pvn_seen_hostnames " in
            *" $pvn_hostname "*)
                fail "$pvn_host duplicates PVE hostname $pvn_hostname"
                ;;
        esac
        if [ "$LOCAL_PVE" = true ]; then
            pvn_expected_record=$(local_pve_record "$pvn_host") ||
                fail "missing discovery record for $pvn_host"
            pvn_old_ifs=$IFS
            IFS=','
            read -r pvn_expected_name pvn_expected_ip pvn_expected_id \
                pvn_expected_local <<EOF
$pvn_expected_record
EOF
            IFS=$pvn_old_ifs
            [ "$pvn_mode" = "$PVE_MODE" ] ||
                fail "$pvn_host PVE mode differs from the discovery snapshot"
            [ "$pvn_cluster" = "$PVE_CONFIRM_ID" ] ||
                fail "$pvn_host deployment ID differs from the discovery snapshot"
            [ "$pvn_hostname" = "$pvn_expected_name" ] ||
                fail "$pvn_host reached PVE node $pvn_hostname, expected $pvn_expected_name"
            [ "$pvn_node_id" = "$pvn_expected_id" ] ||
                fail "$pvn_host reports node ID $pvn_node_id, expected $pvn_expected_id"
        fi
        case " $pvn_seen_node_ids " in
            *" $pvn_node_id "*)
                fail "$pvn_host duplicates PVE node ID $pvn_node_id"
                ;;
        esac
        pvn_seen_hostnames=${pvn_seen_hostnames:+$pvn_seen_hostnames }$pvn_hostname
        pvn_seen_node_ids=${pvn_seen_node_ids:+$pvn_seen_node_ids }$pvn_node_id
        pvn_versions=${pvn_versions:+$pvn_versions }$pvn_package_version
        echo "[$pvn_host] ok: mode=$pvn_mode node=$pvn_hostname/$pvn_node_id cluster=$pvn_cluster pve=$pvn_pve arch=$pvn_arch package=$pvn_package:$pvn_package_version inactive"
    done
    DISCOVERED_CLUSTER_ID=$pvn_expected_cluster
    DISCOVERED_ARCH=$pvn_expected_arch
    DISCOVERED_PACKAGE_VERSIONS=$pvn_versions
}

cleanup_staged() {
    if [ -n "$CURRENT_HOST" ] && [ -n "$CURRENT_REMOTE_DEB" ]; then
        node_run "$CURRENT_HOST" cleanup "$CURRENT_REMOTE_DEB" >/dev/null 2>&1 ||
            echo "$PROGRAM: warning: could not remove $CURRENT_REMOTE_DEB from $CURRENT_HOST" >&2
        CURRENT_HOST=
        CURRENT_REMOTE_DEB=
    fi
    for pvn_staged_record in $STAGED_RECORDS; do
        pvn_staged_host=${pvn_staged_record%%|*}
        pvn_staged_path=${pvn_staged_record#*|}
        node_run "$pvn_staged_host" cleanup "$pvn_staged_path" >/dev/null 2>&1 ||
            echo "$PROGRAM: warning: could not remove $pvn_staged_path from $pvn_staged_host" >&2
    done
    STAGED_RECORDS=
}

cleanup_all() {
    cleanup_staged
    release_pve_global_lock || true
}

trap cleanup_all 0
trap 'exit 130' HUP INT TERM

if [ "$PHASE" = preflight ]; then
    preflight_all
    [ -z "$CONFIRM" ] || [ "$CONFIRM" = "$DISCOVERED_CLUSTER_ID" ] ||
        fail "confirmation '$CONFIRM' does not match cluster '$DISCOVERED_CLUSTER_ID'"
    echo "Preflight passed for all $NODE_COUNT nodes in cluster $DISCOVERED_CLUSTER_ID; no changes made."
    exit 0
fi

for command_name in dpkg dpkg-deb sha256sum; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "required command is unavailable: $command_name"
done
if [ "$LOCAL_PVE" = true ]; then
    command -v "$CP_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $CP_BIN"
    if [ "$PVE_MODE" = cluster ]; then
        command -v "$SCP_BIN" >/dev/null 2>&1 ||
            fail "required command is unavailable: $SCP_BIN"
    fi
else
    command -v "$SCP_BIN" >/dev/null 2>&1 ||
        fail "required command is unavailable: $SCP_BIN"
fi

DEB_PACKAGE=$(dpkg-deb -f "$DEB" Package 2>/dev/null || true)
[ "$DEB_PACKAGE" = pvn-node ] || fail "DEB package must be pvn-node"
DEB_VERSION=$(dpkg-deb -f "$DEB" Version 2>/dev/null || true)
DEB_ARCH=$(dpkg-deb -f "$DEB" Architecture 2>/dev/null || true)
case "$DEB_VERSION" in
    ''|*[!A-Za-z0-9.+:~_-]*) fail "DEB has an unsafe or empty version" ;;
esac
case "$DEB_ARCH" in
    ''|*[!A-Za-z0-9_-]*) fail "DEB has an unsafe or empty architecture" ;;
esac
DEB_SHA=$(sha256sum -- "$DEB" | awk '{ print $1 }')
case "$DEB_SHA" in
    *[!0-9a-f]*|'') fail "could not calculate a valid DEB SHA-256" ;;
esac
[ "${#DEB_SHA}" -eq 64 ] || fail "could not calculate a valid DEB SHA-256"

if [ "$APPLY" = true ]; then
    command -v flock >/dev/null 2>&1 || fail "required command is unavailable: flock"
    pvn_lock_file=${PVN_INSTALL_LOCK_FILE:-/run/lock/pvn-cluster-install.lock}
    case "$pvn_lock_file" in
        /*) ;;
        *) fail "PVN_INSTALL_LOCK_FILE must be an absolute path" ;;
    esac
    exec 9>"$pvn_lock_file" || fail "cannot open local install lock: $pvn_lock_file"
    flock -n 9 || fail "another PVN cluster install is already running"
    acquire_pve_global_lock
fi

preflight_all
if [ "$APPLY" = true ]; then
    verify_local_pve_snapshot
fi

[ "$DEB_ARCH" = all ] || [ "$DEB_ARCH" = "$DISCOVERED_ARCH" ] ||
    fail "DEB architecture $DEB_ARCH does not match cluster architecture $DISCOVERED_ARCH"

for pvn_seen_version in $DISCOVERED_PACKAGE_VERSIONS; do
    case "$pvn_seen_version" in
        absent|"$DEB_VERSION") ;;
        *)
            dpkg --compare-versions "$pvn_seen_version" lt "$DEB_VERSION" ||
                fail "installed pvn-node $pvn_seen_version is newer than target $DEB_VERSION; downgrade refused"
            ;;
    esac
done

if [ "$APPLY" = false ]; then
    echo "Dry run: pvn-node $DEB_VERSION ($DEB_SHA) would be installed on: $NODES"
    echo "Re-run with --apply --confirm $DISCOVERED_CLUSTER_ID to install; no changes made."
    exit 0
fi

[ "$CONFIRM" = "$DISCOVERED_CLUSTER_ID" ] ||
    fail "confirmation '$CONFIRM' does not match cluster '$DISCOVERED_CLUSTER_ID'"

# Stage and hash the identical package on every node before apt changes any
# node. A failed copy or hash therefore leaves the whole cluster uninstalled.
for pvn_host in $NODES; do
    echo "[$pvn_host] staging verified pvn-node $DEB_VERSION"
    CURRENT_HOST=$pvn_host
    CURRENT_REMOTE_DEB=$(node_run "$pvn_host" prepare) ||
        fail "could not create a staging file on $pvn_host"
    case "$CURRENT_REMOTE_DEB" in
        /var/tmp/pvn-node.*.deb) ;;
        *) fail "unsafe staging path returned by $pvn_host" ;;
    esac
    case "$CURRENT_REMOTE_DEB" in
        *[!A-Za-z0-9._/-]*) fail "unsafe staging path returned by $pvn_host" ;;
    esac
    node_copy_deb "$pvn_host" "$CURRENT_REMOTE_DEB" ||
        fail "could not copy the DEB to $pvn_host"
    node_run "$pvn_host" verify "$CURRENT_REMOTE_DEB" "$DEB_SHA" ||
        fail "DEB verification failed on $pvn_host"

    STAGED_RECORDS=${STAGED_RECORDS:+$STAGED_RECORDS }$pvn_host\|$CURRENT_REMOTE_DEB
    CURRENT_HOST=
    CURRENT_REMOTE_DEB=
done

verify_local_pve_snapshot

for pvn_staged_record in $STAGED_RECORDS; do
    pvn_host=${pvn_staged_record%%|*}
    pvn_remote_deb=${pvn_staged_record#*|}
    echo "[$pvn_host] masking OVN aggregate units and installing"
    verify_local_pve_snapshot
    node_run "$pvn_host" apply "$pvn_remote_deb" "$DEB_SHA" \
        "$DEB_VERSION" "$DEB_ARCH" ||
        fail "package installation failed on $pvn_host"
    echo "[$pvn_host] installed and verified inactive"
done

# Remove all staged artifacts, then prove the final state on every node rather
# than trusting only the per-node apt command.
cleanup_staged
verify_local_pve_snapshot
preflight_all
for pvn_seen_version in $DISCOVERED_PACKAGE_VERSIONS; do
    [ "$pvn_seen_version" = "$DEB_VERSION" ] ||
        fail "final sweep found pvn-node $pvn_seen_version, expected $DEB_VERSION"
done

echo "Installed pvn-node $DEB_VERSION on all $NODE_COUNT nodes in cluster $DISCOVERED_CLUSTER_ID."
echo "No PVN activation marker or network/provider configuration was created."
