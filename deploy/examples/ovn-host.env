# Install as /etc/pvn/ovn-host.env on every PVE node. The Debian 13
# ovn-controller.service expands this single value into ovn-ctl arguments.
OVN_CTL_OPTS="--ovn-controller-ssl-key=/etc/pvn/pki/node-key.pem --ovn-controller-ssl-cert=/etc/pvn/pki/node.pem --ovn-controller-ssl-ca-cert=/etc/pvn/pki/ca.pem --ovn-controller-ssl-protocols=TLSv1.2,TLSv1.3"
