#!/bin/sh
set -eu

nb_port=${PVN_OVN_NB_PORT:-6641}
sb_port=${PVN_OVN_SB_PORT:-6642}
listen=${PVN_OVN_LISTEN:-}
attempts=${PVN_OVN_LISTENER_ATTEMPTS:-30}
retry_delay=${PVN_OVN_LISTENER_RETRY_DELAY:-1}

valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_port "$nb_port" || { echo "invalid PVN_OVN_NB_PORT" >&2; exit 2; }
valid_port "$sb_port" || { echo "invalid PVN_OVN_SB_PORT" >&2; exit 2; }
[ "$attempts" -ge 1 ] 2>/dev/null && [ "$attempts" -le 300 ] 2>/dev/null || {
    echo "PVN_OVN_LISTENER_ATTEMPTS must be between 1 and 300" >&2
    exit 2
}
[ "$retry_delay" -ge 0 ] 2>/dev/null && [ "$retry_delay" -le 60 ] 2>/dev/null || {
    echo "PVN_OVN_LISTENER_RETRY_DELAY must be between 0 and 60 seconds" >&2
    exit 2
}
[ "$nb_port" = 6641 ] || { echo "PVN OVN NB client port must be 6641" >&2; exit 2; }
[ "$sb_port" = 6642 ] || { echo "PVN OVN SB client port must be 6642" >&2; exit 2; }
if ! printf '%s\n' "$listen" | awk -F. '
    NF != 4 { exit 1 }
    {
        for (i = 1; i <= 4; i++) {
            if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
        }
    }
'; then
    echo "PVN_OVN_LISTEN must be an IPv4 address" >&2
    exit 2
fi
[ "$listen" != 0.0.0.0 ] || {
    echo "PVN_OVN_LISTEN must not use the IPv4 wildcard address" >&2
    exit 2
}

nb_socket=unix:/run/ovn/ovnnb_db.sock
sb_socket=unix:/run/ovn/ovnsb_db.sock

configure_listener() {
    label=$1
    command=$2
    socket=$3
    endpoint=$4
    attempt=1
    last_error=

    while [ "$attempt" -le "$attempts" ]; do
        if last_error=$("$command" --timeout=3 --db="$socket" \
            --inactivity-probe=60000 set-connection "$endpoint" 2>&1); then
            return 0
        fi
        if [ "$attempt" -lt "$attempts" ]; then
            sleep "$retry_delay"
        fi
        attempt=$((attempt + 1))
    done

    echo "$label database did not become ready after $attempts attempts" >&2
    [ -z "$last_error" ] || printf '%s\n' "$last_error" >&2
    return 1
}

configure_listener NB /usr/bin/ovn-nbctl "$nb_socket" "pssl:${nb_port}:${listen}"
configure_listener SB /usr/bin/ovn-sbctl "$sb_socket" "pssl:${sb_port}:${listen}"

exit 0
