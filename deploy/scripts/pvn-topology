    "active_readiness",
)


class TopologyError(RuntimeError):
    pass


def fail(message: str) -> "NoReturn":
    raise TopologyError(message)


def canonical_json(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def digest_text(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()


def canonical_uuid(value: Any) -> bool:
    if not isinstance(value, str):
        return False
    try:
        parsed = uuid.UUID(value)
    except (ValueError, AttributeError):
        return False
    return str(parsed) == value


def read_limited(path: Path, limit: int, root_only: bool = True) -> str:
    try:
        before = path.lstat()
    except OSError as exc:
        fail(f"cannot inspect {path}: {exc}")
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        fail(f"{path} must be a regular, non-symlink file")
    if before.st_nlink != 1:
        fail(f"{path} must have exactly one hard link")
    if root_only and (before.st_uid != 0 or before.st_mode & 0o022):
        fail(f"{path} has unsafe ownership or mode")
    if before.st_size > limit:
        fail(f"{path} is unexpectedly large")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        fail(f"cannot open {path}: {exc}")
    try:
        opened = os.fstat(descriptor)
        identity = (before.st_dev, before.st_ino)
        if (
            (opened.st_dev, opened.st_ino) != identity
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_nlink != 1
            or (root_only and (opened.st_uid != 0 or opened.st_mode & 0o022))
        ):
            fail(f"{path} changed identity or safety metadata while opening")
        chunks = []
        size = 0
        while True:
            chunk = os.read(descriptor, min(65536, limit + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > limit:
                fail(f"{path} is unexpectedly large")
        after = path.lstat()
        if (
            (after.st_dev, after.st_ino) != identity
            or stat.S_ISLNK(after.st_mode)
            or not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or (root_only and (after.st_uid != 0 or after.st_mode & 0o022))
        ):
            fail(f"{path} changed identity while being read")
        return b"".join(chunks).decode("utf-8")
    except (OSError, UnicodeError) as exc:
        fail(f"cannot read {path}: {exc}")
    finally:
        os.close(descriptor)


def run_bounded_process(
    argv: list[str], input_text: str, timeout: int,
    output_limit: int = PROCESS_OUTPUT_LIMIT,
) -> subprocess.CompletedProcess[str]:
    payload = input_text.encode("utf-8")
    try:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as exc:
        fail(f"command could not start: {argv[0]}: {exc}")
    assert process.stdin is not None
    assert process.stdout is not None
    assert process.stderr is not None
    selector = selectors.DefaultSelector()
    streams = {
        process.stdin.fileno(): ("stdin", process.stdin),
        process.stdout.fileno(): ("stdout", process.stdout),
        process.stderr.fileno(): ("stderr", process.stderr),
    }
    for descriptor, (kind, stream) in streams.items():
        os.set_blocking(descriptor, False)
        selector.register(
            descriptor,
            selectors.EVENT_WRITE if kind == "stdin" else selectors.EVENT_READ,
            (kind, stream),
        )
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    written = 0
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail(f"command timed out after {timeout}s: {argv[0]}")
            for key, _events in selector.select(min(remaining, 0.25)):
                kind, stream = key.data
                descriptor = key.fd
                if kind == "stdin":
                    try:
                        count = os.write(descriptor, payload[written:written + 65536])
                    except BrokenPipeError:
                        count = 0
                        written = len(payload)
                    except BlockingIOError:
                        continue
                    written += count
                    if written >= len(payload):
                        selector.unregister(descriptor)
                        stream.close()
                    continue
                try:
                    chunk = os.read(descriptor, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(descriptor)
                    stream.close()
                    continue
                buffers[kind].extend(chunk)
                if len(buffers["stdout"]) + len(buffers["stderr"]) > output_limit:
                    fail(
                        f"command output exceeds {output_limit} bytes: {argv[0]}"
                    )
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail(f"command timed out after {timeout}s: {argv[0]}")
        returncode = process.wait(timeout=remaining)
        try:
            stdout = buffers["stdout"].decode("utf-8")
            stderr = buffers["stderr"].decode("utf-8")
        except UnicodeError as exc:
            fail(f"command returned invalid UTF-8: {argv[0]}: {exc}")
        return subprocess.CompletedProcess(argv, returncode, stdout, stderr)
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"command failed: {argv[0]}: {exc}")
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
        for key in list(selector.get_map().values()):
            try:
                selector.unregister(key.fd)
            except Exception:
                pass
            try:
                key.data[1].close()
            except Exception:
                pass
        selector.close()


def parse_cidr(value: str, option: str) -> ipaddress.IPv4Network:
    try:
        network = ipaddress.ip_network(value, strict=True)
    except ValueError as exc:
        fail(f"{option} must be a canonical IPv4 network: {exc}")
    if not isinstance(network, ipaddress.IPv4Network):
        fail(f"{option} must be IPv4")
    if network.prefixlen > 30 or network.is_loopback or network.is_multicast:
        fail(f"{option} is not a usable host network")
    return network


def discover_members() -> tuple[str, str, list[dict[str, Any]], dict[str, Any]]:
    try:
        data = json.loads(read_limited(MEMBERS_FILE, 1024 * 1024))
    except json.JSONDecodeError as exc:
        fail(f"invalid {MEMBERS_FILE}: {exc}")
    if not isinstance(data, dict):
        fail(f"{MEMBERS_FILE} must contain a JSON object")

    cluster = data.get("cluster")
    nodelist = data.get("nodelist")
    if not isinstance(cluster, dict) or not isinstance(nodelist, dict) or not nodelist:
        fail(f"{MEMBERS_FILE} does not describe a PVE cluster")
    cluster_name = cluster.get("name")
    if not isinstance(cluster_name, str) or not SAFE_NAME.fullmatch(cluster_name):
        fail("PVE cluster name is empty or unsafe")
    if cluster.get("quorate") not in (1, True, "1"):
        fail("PVE cluster is not quorate")
    members_version = data.get("version")
    cluster_version = cluster.get("version")
    if type(members_version) is not int or members_version < 0:
        fail("PVE membership version is invalid")
    if type(cluster_version) is not int or cluster_version < 0:
        fail("PVE cluster membership version is invalid")
    declared = cluster.get("nodes")
    if not isinstance(declared, int) or declared != len(nodelist):
        fail("PVE cluster node count does not match /etc/pve/.members")
    local_name = data.get("nodename")
    if (
        not isinstance(local_name, str)
        or not SAFE_NAME.fullmatch(local_name)
        or local_name not in nodelist
    ):
        fail("local PVE nodename is empty, unsafe, or absent from membership")

    nodes: list[dict[str, Any]] = []
    seen_ids: set[int] = set()
    seen_ips: set[str] = set()
    offline: list[str] = []
    for name, entry in nodelist.items():
        if not isinstance(name, str) or not SAFE_NAME.fullmatch(name):
            fail(f"unsafe PVE node name: {name!r}")
        if not isinstance(entry, dict):
            fail(f"invalid member record for {name}")
        if entry.get("online") not in (1, True, "1"):
            offline.append(name)
            continue
        node_id = entry.get("id")
        if not isinstance(node_id, int) or node_id <= 0 or node_id in seen_ids:
            fail(f"invalid or duplicate node ID for {name}")
        try:
            address = ipaddress.ip_address(entry.get("ip"))
        except ValueError:
            fail(f"invalid management IP for {name}")
        if not isinstance(address, ipaddress.IPv4Address):
            fail(f"IPv4 management is required for {name}")
        if str(address) in seen_ips:
            fail(f"duplicate management IP {address}")
        seen_ids.add(node_id)
        seen_ips.add(str(address))
        nodes.append({"name": name, "id": node_id, "ip": str(address)})
    if offline:
        fail("every cluster member must be online; offline: " + ", ".join(sorted(offline)))
    if len(nodes) != declared:
        fail("not every declared PVE member is online")
    nodes.sort(key=lambda item: (item["id"], item["name"]))
    membership_snapshot = {
        "mode": "cluster",
        "cluster_name": cluster_name,
        "cluster_version": cluster_version,
        "nodes": [
            {"name": node["name"], "node_id": node["id"], "management_ip": node["ip"]}
            for node in nodes
        ],
    }
    return cluster_name, local_name, nodes, membership_snapshot


def assert_membership_unchanged(expected: dict[str, Any], context: str) -> None:
    _cluster_name, _local_name, _nodes, current = discover_members()
    if current != expected:
        fail(f"PVE membership changed {context}; refusing further topology mutation")


def validate_ssh_files(nodes: list[dict[str, Any]]) -> None:
    try:
        identity_info = PVE_IDENTITY_FILE.lstat()
    except OSError as exc:
        fail(f"cannot inspect Proxmox cluster identity {PVE_IDENTITY_FILE}: {exc}")
    if stat.S_ISLNK(identity_info.st_mode) or not stat.S_ISREG(identity_info.st_mode):
        fail(f"{PVE_IDENTITY_FILE} must be a regular, non-symlink file")
    if identity_info.st_uid != 0 or stat.S_IMODE(identity_info.st_mode) not in (0o400, 0o600):
        fail(f"{PVE_IDENTITY_FILE} must be root-owned with mode 0400 or 0600")

    for node in nodes:
        known_hosts = PVE_NODES_DIR / node["name"] / "ssh_known_hosts"
        try:
            info = known_hosts.lstat()
        except OSError as exc:
            fail(f"cannot inspect PVE host-key pin {known_hosts}: {exc}")
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            fail(f"{known_hosts} must be a regular, non-symlink file")
        if info.st_uid != 0 or info.st_mode & 0o022:
            fail(f"{known_hosts} must be root-owned and not group/world writable")
        text = read_limited(known_hosts, 1024 * 1024)
        entries = [
            line.split()
            for line in text.splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
        if not entries:
            fail(f"{known_hosts} contains no pinned host key")
        if any(len(entry) < 3 or entry[0] != node["name"] for entry in entries):
            fail(f"{known_hosts} does not exclusively pin alias {node['name']}")


REMOTE_HELPER = r'''
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import re
import selectors
import stat
import subprocess
import sys
import tempfile
import time

INTERFACES = Path("/etc/network/interfaces")
PENDING = Path("/etc/network/interfaces.new")
COROSYNC = Path("/etc/pve/corosync.conf")
STATE_DIR = Path("/var/lib/pvn/topology")
STATE_FILE = STATE_DIR / "state.json"
LEDGER_DIR = Path("/etc/pve/priv/pvn")
LEDGER_FILE = LEDGER_DIR / "topology.json"
CONTROL_LEDGER_FILE = LEDGER_DIR / "control-plane.json"
CENTRAL_RESTART_DIR = Path("/var/lib/pvn-node")
CENTRAL_RESTART_MARKER = CENTRAL_RESTART_DIR / "central-restart-pending"
PVNCTL = "/usr/sbin/pvnctl"
MARKERS = (Path("/etc/pvn/node-enabled"), Path("/etc/pvn/central/enabled"))
ACTIVATION_UNITS = (
    "pvn-node.target", "pvn-central.target", "pvn-node-ready.service",
    "pvn-manager.service", "pvn-agent.service", "pvn-control-db.service",
    "pvn-ovn-db-listeners.service", "pvn-ovn-host-config.service",
    "ovn-controller.service", "ovn-northd.service",
    "ovn-ovsdb-server-nb.service", "ovn-ovsdb-server-sb.service",
)
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
REMOTE_REQUEST_LIMIT = 8 * 1024 * 1024
PROCESS_OUTPUT_LIMIT = 4 * 1024 * 1024


class RemoteFailure(RuntimeError):
    pass


def abort(message):
    raise RemoteFailure(message)


def emit(**values):
    values["ok"] = True
    print(json.dumps(values, sort_keys=True, separators=(",", ":")))


def run_bounded_process(argv, input_text, timeout, output_limit=PROCESS_OUTPUT_LIMIT):
    payload = input_text.encode("utf-8")
    try:
        process = subprocess.Popen(
            argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as exc:
        abort("command could not start: %s: %s" % (argv[0], exc))
    selector = selectors.DefaultSelector()
    streams = {
        process.stdin.fileno(): ("stdin", process.stdin),
        process.stdout.fileno(): ("stdout", process.stdout),
        process.stderr.fileno(): ("stderr", process.stderr),
    }
    for descriptor, (kind, stream) in streams.items():
        os.set_blocking(descriptor, False)
        selector.register(
            descriptor,
            selectors.EVENT_WRITE if kind == "stdin" else selectors.EVENT_READ,
            (kind, stream),
        )
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    written = 0
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                abort("command timed out after %ss: %s" % (timeout, argv[0]))
            for key, _events in selector.select(min(remaining, 0.25)):
                kind, stream = key.data
                descriptor = key.fd
                if kind == "stdin":
                    try:
                        count = os.write(descriptor, payload[written:written + 65536])
                    except BrokenPipeError:
                        count = 0
                        written = len(payload)
                    except BlockingIOError:
                        continue
                    written += count
                    if written >= len(payload):
                        selector.unregister(descriptor)
                        stream.close()
                    continue
                try:
                    chunk = os.read(descriptor, 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(descriptor)
                    stream.close()
                    continue
                buffers[kind].extend(chunk)
                if len(buffers["stdout"]) + len(buffers["stderr"]) > output_limit:
                    abort("command output exceeds %d bytes: %s" % (output_limit, argv[0]))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            abort("command timed out after %ss: %s" % (timeout, argv[0]))
        returncode = process.wait(timeout=remaining)
        try:
            stdout = buffers["stdout"].decode("utf-8")
            stderr = buffers["stderr"].decode("utf-8")
        except UnicodeError as exc:
            abort("command returned invalid UTF-8: %s: %s" % (argv[0], exc))
        return subprocess.CompletedProcess(argv, returncode, stdout, stderr)
    except (OSError, subprocess.TimeoutExpired) as exc:
        abort("command failed: %s: %s" % (argv[0], exc))
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
        for key in list(selector.get_map().values()):
            try:
                selector.unregister(key.fd)
            except Exception:
                pass
            try:
                key.data[1].close()
            except Exception:
                pass
        selector.close()


def run(argv, timeout=30, check=True, input_text=None):
    result = run_bounded_process(argv, input_text or "", timeout)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().replace("\n", "; ")
        abort("command failed: %s: %s" % (argv[0], detail[:500]))
    return result


PVE_CAS_HELPER = r"""
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use Encode qw(encode);
use Fcntl qw(:DEFAULT);
use JSON::PP qw(decode_json encode_json);

my $action = shift // die "missing CAS action\n";
my $raw = '';
my $buffer;
while (1) {
    my $read = read(STDIN, $buffer, 8192);
    defined($read) or die "cannot read CAS request: $!\n";
    last if $read == 0;
    $raw .= $buffer;
    length($raw) <= 8 * 1024 * 1024 or die "CAS request is too large\n";
}
my $request = decode_json($raw);
ref($request) eq 'HASH' or die "CAS request must be an object\n";

my $interfaces = '/etc/network/interfaces';
my $pending = '/etc/network/interfaces.new';
my $network_lock = '/etc/network/.pve-interfaces.lock';
my $corosync = '/etc/pve/corosync.conf';
my $corosync_new = '/etc/pve/corosync.conf.new';

sub read_bytes {
    my ($path, $optional) = @_;
    return undef if $optional && !-e $path && !-l $path;
    my $flags = O_RDONLY;
    $flags |= O_NOFOLLOW if defined(&O_NOFOLLOW);
    sysopen(my $handle, $path, $flags) or die "cannot open $path: $!\n";
    binmode($handle);
    my $content = '';
    while (1) {
        my $read = read($handle, my $chunk, 8192);
        defined($read) or die "cannot read $path: $!\n";
        last if $read == 0;
        $content .= $chunk;
        length($content) <= 4 * 1024 * 1024 or die "$path is unexpectedly large\n";
    }
    close($handle) or die "cannot close $path: $!\n";
    return $content;
}

sub hash_path {
    my ($path, $optional) = @_;
    my $content = read_bytes($path, $optional);
    return undef if !defined($content);
    return sha256_hex($content);
}

sub write_exclusive {
    my ($path, $content) = @_;
    my $flags = O_WRONLY | O_CREAT | O_EXCL;
    $flags |= O_NOFOLLOW if defined(&O_NOFOLLOW);
    sysopen(my $handle, $path, $flags, 0600) or die "cannot create $path: $!\n";
    binmode($handle);
    my $ok = eval {
        print {$handle} $content or die "cannot write $path: $!\n";
        close($handle) or die "cannot close $path: $!\n";
        1;
    };
    if (!$ok) {
        my $error = $@ || "unknown write failure\n";
        close($handle);
        unlink($path);
        die $error;
    }
}

sub locked_network {
    my ($code) = @_;
    require PVE::Tools;
    my $result = PVE::Tools::lock_file($network_lock, 10, $code);
    my $error = $@;
    defined($error) && length($error) and die "network config lock failed: $error";
    return $result;
}

sub safe_iface {
    my ($value) = @_;
    defined($value) && !ref($value) && $value =~ /\A[A-Za-z0-9][A-Za-z0-9._-]*\z/
        or die "unsafe interface name\n";
    return $value;
}

sub safe_mtu {
    my ($value) = @_;
    defined($value) && !ref($value) && "$value" =~ /\A[0-9]+\z/
        && $value >= 1280 && $value <= 65520
        or die "unsafe MTU\n";
    return int($value);
}

if ($action eq 'stage-network') {
    require PVE::INotify;
    my $result = locked_network(sub {
        hash_path($interfaces, 0) eq $request->{expected_current_sha256}
            or die "interfaces failed compare-and-swap before staging\n";
        !-e $pending && !-l $pending or die "pending network configuration already exists\n";
        my $geneve = safe_iface($request->{geneve}->{interface});
        my $provider = safe_iface($request->{provider}->{interface});
        my $geneve_mtu = safe_mtu($request->{geneve}->{mtu});
        my $provider_mtu = safe_mtu($request->{provider}->{mtu});
        my $integration_mtu = safe_mtu($request->{effective_underlay_mtu});
        my $config = PVE::INotify::read_file('interfaces');
        my $ifaces = $config->{ifaces};
        ref($ifaces) eq 'HASH' or die "PVE interfaces object is invalid\n";
        ref($ifaces->{$geneve}) eq 'HASH' && $ifaces->{$geneve}->{type} eq 'eth'
            or die "Geneve interface changed before staging\n";
        ref($ifaces->{$provider}) eq 'HASH' && $ifaces->{$provider}->{type} eq 'eth'
            or die "provider interface changed before staging\n";
        !$ifaces->{'br-int'} && !$ifaces->{'br-provider'}
            or die "PVN bridge appeared before staging\n";
        for my $name (keys %$ifaces) {
            next if $name eq $geneve || $name eq $provider;
            my $row = $ifaces->{$name};
            next if ref($row) ne 'HASH';
            my $ports = join(' ', map { $row->{$_} // '' } qw(bridge_ports ovs_ports slaves ovs_bonds));
            my %used = map { $_ => 1 } grep { length($_) } split(/\s+/, $ports);
            !$used{$geneve} && !$used{$provider}
                or die "candidate interface became owned by $name\n";
        }

        $ifaces->{$geneve}->{mtu} = $geneve_mtu;
        $ifaces->{'br-int'} = {
            type => 'OVSBridge', autostart => 1, mtu => $integration_mtu,
            families => ['inet'], method => 'manual', method6 => 'manual',
        };
        $ifaces->{'br-provider'} = {
            type => 'OVSBridge', autostart => 1, mtu => $provider_mtu,
            ovs_ports => $provider, families => ['inet'], method => 'manual',
            method6 => 'manual',
        };
        my $provider_row = $ifaces->{$provider};
        delete $provider_row->{$_}
            for qw(address netmask gateway cidr address6 netmask6 gateway6 cidr6);
        $provider_row->{type} = 'OVSPort';
        $provider_row->{ovs_bridge} = 'br-provider';
        $provider_row->{autostart} = 0;
        $provider_row->{mtu} = $provider_mtu;
        $provider_row->{families} = ['inet'];
        $provider_row->{method} = 'manual';
        $provider_row->{method6} = 'manual';

        my $desired;
        my $ok = eval {
            PVE::INotify::write_file('interfaces', $config);
            $desired = hash_path($pending, 0);
            1;
        };
        if (!$ok) {
            my $error = $@ || "unknown PVE network write failure\n";
            unlink($pending) if -e $pending || -l $pending;
            die $error;
        }
        return $desired;
    });
    print encode_json({ desired_sha256 => $result }), "\n";
    exit 0;
}

if ($action eq 'apply-network') {
    my $result = locked_network(sub {
        hash_path($interfaces, 0) eq $request->{expected_current_sha256}
            or die "interfaces changed before network apply\n";
        hash_path($pending, 0) eq $request->{expected_pending_sha256}
            or die "pending interfaces failed compare-and-swap\n";
        rename($pending, $interfaces) or die "cannot atomically install pending interfaces: $!\n";
        my $written = hash_path($interfaces, 0);
        $written eq $request->{expected_pending_sha256}
            or die "installed interfaces hash differs from candidate\n";
        return $written;
    });
    print encode_json({ interfaces_sha256 => $result }), "\n";
    exit 0;
}

if ($action eq 'discard-network') {
    my $result = locked_network(sub {
        my $pending_hash = hash_path($pending, 1);
        return 0 if !defined($pending_hash);
        $pending_hash eq $request->{expected_pending_sha256}
            or die "refusing to discard unrelated pending network changes\n";
        unlink($pending) or die "cannot discard owned pending interfaces: $!\n";
        return 1;
    });
    print encode_json({ discarded => $result ? JSON::PP::true : JSON::PP::false }), "\n";
    exit 0;
}

if ($action eq 'write-pending') {
    my $content = encode('UTF-8', $request->{content});
    sha256_hex($content) eq $request->{content_sha256}
        or die "rollback interfaces content hash mismatch\n";
    my $result = locked_network(sub {
        hash_path($interfaces, 0) eq $request->{expected_current_sha256}
            or die "interfaces changed before rollback staging\n";
        my $pending_hash = hash_path($pending, 1);
        if (defined($pending_hash)) {
            return $pending_hash if $pending_hash eq $request->{content_sha256};
            defined($request->{replace_pending_sha256})
                && $pending_hash eq $request->{replace_pending_sha256}
                or die "refusing rollback with unrelated pending network changes\n";
            unlink($pending) or die "cannot remove owned pending interfaces: $!\n";
        }
        write_exclusive($pending, $content);
        return hash_path($pending, 0);
    });
    print encode_json({ pending_sha256 => $result }), "\n";
    exit 0;
}

if ($action eq 'apply-corosync') {
    my $content = encode('UTF-8', $request->{content});
    sha256_hex($content) eq $request->{content_sha256}
        or die "Corosync candidate hash mismatch\n";
    require PVE::Cluster;
    PVE::Cluster::cfs_update(1);
    my $result = PVE::Cluster::cfs_lock_file('corosync.conf', 10, sub {
        hash_path($corosync, 0) eq $request->{expected_current_sha256}
            or die "corosync.conf failed compare-and-swap\n";
        !-e $corosync_new && !-l $corosync_new
            or die "unrelated corosync.conf.new already exists\n";
        write_exclusive($corosync_new, $content);
        if (!rename($corosync_new, $corosync)) {
            my $error = $!;
            unlink($corosync_new);
            die "cannot atomically install corosync.conf candidate: $error\n";
        }
        return hash_path($corosync, 0);
    });
    my $error = $@;
    defined($error) && length($error) and die "Corosync config lock failed: $error";
    print encode_json({ corosync_sha256 => $result }), "\n";
    exit 0;
}

die "unknown PVE CAS action\n";
"""


def pve_cas(action, request, timeout=30):
    result = run(
        ["perl", "-e", PVE_CAS_HELPER, action],
        timeout=timeout,
        input_text=json.dumps(request, sort_keys=True, separators=(",", ":")),
    )
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        abort("invalid PVE CAS helper response: %s" % exc)
    if not isinstance(value, dict):
        abort("PVE CAS helper returned a non-object")
    return value


def read_regular(path, limit=4 * 1024 * 1024, root_only=True):
    try:
        before = path.lstat()
    except OSError as exc:
        abort("cannot inspect %s: %s" % (path, exc))
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        abort("%s is not a regular non-symlink file" % path)
    if before.st_nlink != 1:
        abort("%s must have exactly one hard link" % path)
    if root_only and (before.st_uid != 0 or before.st_mode & 0o022):
        abort("%s has unsafe ownership or mode" % path)
    if before.st_size > limit:
        abort("%s is unexpectedly large" % path)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        abort("cannot open %s: %s" % (path, exc))
    try:
        opened = os.fstat(descriptor)
        identity = (before.st_dev, before.st_ino)
        if (
            (opened.st_dev, opened.st_ino) != identity
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_nlink != 1
            or (root_only and (opened.st_uid != 0 or opened.st_mode & 0o022))
        ):
            abort("%s changed identity or safety metadata while opening" % path)
        chunks = []
        size = 0
        while True:
            chunk = os.read(descriptor, min(65536, limit + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > limit:
                abort("%s is unexpectedly large" % path)
        after = path.lstat()
        if (
            (after.st_dev, after.st_ino) != identity
            or stat.S_ISLNK(after.st_mode)
            or not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or (root_only and (after.st_uid != 0 or after.st_mode & 0o022))
        ):
            abort("%s changed identity while being read" % path)
        return b"".join(chunks).decode("utf-8")
    except (OSError, UnicodeError) as exc:
        abort("cannot read %s: %s" % (path, exc))
    finally:
        os.close(descriptor)


def verify_membership_snapshot(expected):
    if not isinstance(expected, dict):
        abort("expected PVE membership snapshot is missing")
    try:
        data = json.loads(read_regular(Path("/etc/pve/.members"), 1024 * 1024))
    except json.JSONDecodeError as exc:
        abort("invalid /etc/pve/.members: %s" % exc)
    cluster = data.get("cluster") if isinstance(data, dict) else None
    nodelist = data.get("nodelist") if isinstance(data, dict) else None
    if not isinstance(cluster, dict) or not isinstance(nodelist, dict) or not nodelist:
        abort("/etc/pve/.members does not describe a PVE cluster")
    if cluster.get("quorate") not in (1, True, "1"):
        abort("PVE cluster is not quorate")
    members_version = data.get("version")
    cluster_version = cluster.get("version")
    if type(members_version) is not int or members_version < 0:
        abort("PVE membership version is invalid")
    if type(cluster_version) is not int or cluster_version < 0:
        abort("PVE cluster membership version is invalid")
    declared = cluster.get("nodes")
    if type(declared) is not int or declared != len(nodelist):
        abort("PVE cluster node count differs from membership")
    nodes = []
    seen_ids = set()
    seen_ips = set()
    for name, entry in nodelist.items():
        if not isinstance(name, str) or not SAFE_NAME.fullmatch(name) or not isinstance(entry, dict):
            abort("PVE membership contains an unsafe node")
        if entry.get("online") not in (1, True, "1"):
            abort("PVE membership contains an offline node")
        node_id = entry.get("id")
        if type(node_id) is not int or node_id <= 0 or node_id in seen_ids:
            abort("PVE membership contains an invalid or duplicate node ID")
        try:
            address = ipaddress.ip_address(entry.get("ip"))
        except ValueError:
            abort("PVE membership contains an invalid management IP")
        if not isinstance(address, ipaddress.IPv4Address) or str(address) in seen_ips:
            abort("PVE membership contains a non-IPv4 or duplicate management IP")
        seen_ids.add(node_id)
        seen_ips.add(str(address))
        nodes.append({"name": name, "node_id": node_id, "management_ip": str(address)})
    nodes.sort(key=lambda item: (item["node_id"], item["name"]))
    actual = {
        "mode": "cluster",
        "cluster_name": cluster.get("name"),
        "cluster_version": cluster_version,
        "nodes": nodes,
    }
    if actual != expected:
        abort("exact PVE membership snapshot changed during topology apply")


def sha_text(value):
    return hashlib.sha256(value.encode()).hexdigest()


def sha_file(path):
    return sha_text(read_regular(path))


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path, content, mode=0o600):
    parent = path.parent
    tmp = parent / (".%s.pvn-%d" % (path.name, os.getpid()))
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(tmp, flags, mode)
    try:
        data = content.encode()
        offset = 0
        while offset < len(data):
            offset += os.write(fd, data[offset:])
        os.fsync(fd)
        try:
            os.fchmod(fd, mode)
        except OSError:
            # pmxcfs paths have path-defined permissions and reject chmod.
            pass
    finally:
        os.close(fd)
    os.replace(tmp, path)
    try:
        fsync_dir(parent)
    except OSError:
        # pmxcfs does not implement every fsync operation.
        pass


def ensure_state_dir():
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    info = STATE_DIR.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        abort("unsafe topology state directory")
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        abort("topology state directory must be root:0700")


def load_journal(optional=True):
    if not STATE_FILE.exists():
        if optional:
            return None
        abort("topology journal is missing")
    info = STATE_FILE.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        abort("unsafe topology journal")
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
        abort("topology journal must be root:0600")
    try:
        value = json.loads(read_regular(STATE_FILE, 1024 * 1024))
    except json.JSONDecodeError as exc:
        abort("invalid topology journal: %s" % exc)
    if not isinstance(value, dict) or value.get("schema") != 1:
        abort("unsupported topology journal")
    return value


def save_journal(value):
    ensure_state_dir()
    atomic_write(STATE_FILE, json.dumps(value, sort_keys=True, indent=2) + "\n", 0o600)


def activation_state():
    markers = {
        str(marker): bool(marker.exists() or marker.is_symlink())
        for marker in MARKERS
    }
    units = {}
    for unit in ACTIVATION_UNITS:
        result = run(["systemctl", "is-active", unit], check=False)
        units[unit] = result.returncode == 0 and result.stdout.strip() == "active"
    return {"markers": markers, "units": units}


def activation_mode(value):
    if not isinstance(value, dict):
        return "mixed"
    markers = value.get("markers")
    units = value.get("units")
    if (
        not isinstance(markers, dict)
        or set(markers) != {str(marker) for marker in MARKERS}
        or any(type(item) is not bool for item in markers.values())
        or not isinstance(units, dict)
        or set(units) != set(ACTIVATION_UNITS)
        or any(type(item) is not bool for item in units.values())
    ):
        return "mixed"
    values = list(markers.values()) + list(units.values())
    if all(values):
        return "active"
    if not any(values):
        return "inactive"
    return "mixed"


def check_activation_absent():
    state = activation_state()
    mode = activation_mode(state)
    if mode != "inactive":
        abort("PVN activation state is not uniformly inactive: %s" % mode)


def require_commands(names):
    for name in names:
        result = run(["sh", "-c", "command -v -- \"$1\" >/dev/null 2>&1", "sh", name], check=False)
        if result.returncode != 0:
            abort("required command is unavailable: %s" % name)


def parse_json_command(argv):
    result = run(argv)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        abort("invalid JSON from %s: %s" % (argv[0], exc))


def cluster_status(expected_nodes, expected_name=None):
    output = run(["pvecm", "status"]).stdout
    nodes = re.findall(r"^Nodes:\s*(\d+)\s*$", output, re.M)
    quorate = re.findall(r"^Quorate:\s*(\S+)\s*$", output, re.M)
    names = re.findall(r"^Name:\s*(\S+)\s*$", output, re.M)
    if len(nodes) != 1 or int(nodes[0]) != expected_nodes:
        abort("pvecm reports the wrong cluster node count")
    if len(quorate) != 1 or quorate[0] != "Yes":
        abort("PVE cluster is not quorate")
    if expected_name is not None and (len(names) != 1 or names[0] != expected_name):
        abort("pvecm reports a different cluster name")
    return True


def network_rows(node):
    value = parse_json_command([
        "pvesh", "get", "/nodes/%s/network" % node, "--output-format", "json",
    ])
    if not isinstance(value, list):
        abort("PVE network API returned a non-list")
    return {row.get("iface"): row for row in value if isinstance(row, dict) and row.get("iface")}


def link_rows():
    rows = parse_json_command(["ip", "-j", "-d", "link", "show"])
    if not isinstance(rows, list):
        abort("ip link returned a non-list")
    return {row.get("ifname"): row for row in rows if isinstance(row, dict) and row.get("ifname")}


def address_rows():
    rows = parse_json_command(["ip", "-j", "-4", "address", "show"])
    if not isinstance(rows, list):
        abort("ip address returned a non-list")
    return rows


def route_rows():
    rows = parse_json_command(["ip", "-j", "-4", "route", "show", "table", "all"])
    if not isinstance(rows, list):
        abort("ip route returned a non-list")
    return rows


def addresses_by_interface(rows):
    result = {}
    for row in rows:
        ifname = row.get("ifname")
        if not ifname:
            continue
        values = []
        for addr in row.get("addr_info", []):
            if addr.get("family") == "inet" and addr.get("local"):
                values.append({
                    "address": addr["local"],
                    "prefixlen": int(addr.get("prefixlen", 32)),
                    "scope": addr.get("scope", ""),
                })
        result[ifname] = values
    return result


def physical_link(ifname, links, allow_ovs_master=False):
    row = links.get(ifname)
    if not row:
        abort("interface %s is absent" % ifname)
    device = Path("/sys/class/net") / ifname / "device"
    if not device.exists():
        abort("interface %s is not a physical PCI/virtio NIC" % ifname)
    kind = (row.get("linkinfo") or {}).get("info_kind")
    if kind:
        abort("interface %s is a %s, not a physical NIC" % (ifname, kind))
    if row.get("master") and not (allow_ovs_master and row.get("master") == "ovs-system"):
        abort("interface %s is already enslaved to %s" % (ifname, row["master"]))
    max_mtu = row.get("max_mtu")
    mtu = row.get("mtu")
    if not isinstance(max_mtu, int) or max_mtu < 1280:
        abort("interface %s does not expose a usable actual max MTU" % ifname)
    if not isinstance(mtu, int) or mtu <= 0 or mtu > max_mtu:
        abort("interface %s has an invalid live MTU" % ifname)
    return {
        "interface": ifname,
        "mac": row.get("address", ""),
        "mtu": mtu,
        "max_mtu": max_mtu,
    }


def configured_mtu(row, ifname):
    raw = row.get("mtu")
    if raw is None or raw == "":
        return None
    if type(raw) is int:
        value = raw
    elif isinstance(raw, str) and re.fullmatch(r"[0-9]+", raw):
        value = int(raw)
    else:
        abort("interface %s has an invalid configured MTU" % ifname)
    if value < 1280 or value > 65535:
        abort("interface %s has an invalid configured MTU" % ifname)
    return value


def find_cidr_interface(network, addresses, links):
    matches = []
    for ifname, values in addresses.items():
        for value in values:
            try:
                address = ipaddress.ip_address(value["address"])
            except ValueError:
                continue
            if address in network:
                matches.append((ifname, value))
    if len(matches) != 1:
        abort("%s must have exactly one physical NIC/IP; found %d" % (network, len(matches)))
    ifname, address = matches[0]
    result = physical_link(ifname, links)
    result["address"] = "%s/%d" % (address["address"], address["prefixlen"])
    return result


def guest_config_users(node, interfaces):
    token = re.compile(r"(?<![A-Za-z0-9_.:-])(?:%s)(?![A-Za-z0-9_.:-])" % "|".join(
        re.escape(value) for value in interfaces
    ))
    users = []
    for kind in ("qemu-server", "lxc"):
        directory = Path("/etc/pve/nodes") / node / kind
        if not directory.exists():
            continue
        for path in sorted(directory.glob("*.conf")):
            text = read_regular(path, 1024 * 1024, root_only=False)
            if token.search(text):
                users.append(str(path))
    return users


def route_signature(routes):
    keep = ("dst", "gateway", "dev", "table", "metric", "protocol", "scope", "type")
    values = []
    for route in routes:
        if route.get("dst", "default") == "default":
            values.append({key: route[key] for key in keep if key in route})
    values.sort(key=lambda item: json.dumps(item, sort_keys=True))
    if not values:
        abort("no IPv4 default route is configured")
    return values


def corosync_runtime_links(expected_node_id):
    output = run(["corosync-cfgtool", "-s"]).stdout
    local_ids = re.findall(r"^Local node ID\s+(\d+),", output, re.M)
    if len(local_ids) != 1 or int(local_ids[0]) != expected_node_id:
        abort("Corosync runtime reports the wrong local node ID")
    links = {}
    for match in re.finditer(
        r"(?ms)^LINK ID\s+(\d+)\s+.*?(?=^LINK ID\s+\d+\s+|\Z)", output
    ):
        ring = int(match.group(1))
        if ring in links or ring < 0 or ring > 7:
            abort("Corosync runtime exposes an invalid or duplicate link")
        block = match.group(0)
        addresses = re.findall(r"^\s*addr\s*=\s*(\S+)\s*$", block, re.M)
        if len(addresses) != 1:
            abort("Corosync runtime link has no unique local address")
        try:
            local_address = str(ipaddress.ip_address(addresses[0]))
        except ValueError:
            abort("Corosync runtime link has an invalid local address")
        states = {}
        for raw_id, raw_state in re.findall(
            r"^\s*nodeid:\s*(\d+):\s*(\S+)\s*$", block, re.M
        ):
            node_id = int(raw_id)
            if node_id in states:
                abort("Corosync runtime link repeats a node status")
            states[node_id] = raw_state.lower()
        if states.get(expected_node_id) != "localhost":
            abort("Corosync runtime link does not identify the local node")
        connected = sorted(
            node_id for node_id, state in states.items()
            if state in ("connected", "localhost")
        )
        links[ring] = {
            "address": local_address,
            "connected_node_ids": connected,
            "node_states": {str(key): value for key, value in sorted(states.items())},
        }
    if not links:
        abort("Corosync runtime exposes no KNET links")
    return {"local_node_id": expected_node_id, "links": links}


def corosync_runtime_config(expected_node_id, expected_cluster_name, expected_members):
    output = run(["corosync-cmapctl"]).stdout
    values = {}
    for line in output.splitlines():
        match = re.match(r"^([A-Za-z0-9_.]+)\s+\([^)]+\)\s*=\s*(.*)$", line.strip())
        if not match:
            continue
        key, value = match.groups()
        if key in values:
            abort("Corosync cmap repeats %s" % key)
        value = value.strip()
        if value.startswith('"'):
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                abort("Corosync cmap has an invalid quoted value")
        values[key] = value

    cluster_name = values.get("totem.cluster_name")
    if cluster_name != expected_cluster_name:
        abort("Corosync runtime reports the wrong cluster name")
    try:
        version = int(values["totem.config_version"])
        local_position = int(values["nodelist.local_node_pos"])
    except (KeyError, TypeError, ValueError):
        abort("Corosync cmap is missing a valid config version or local position")
    if version < 0 or local_position < 0:
        abort("Corosync cmap has an invalid config version or local position")

    positions = {}
    node_pattern = re.compile(r"^nodelist\.node\.(\d+)\.(name|nodeid|ring([0-7])_addr)$")
    for key, value in values.items():
        match = node_pattern.match(key)
        if not match:
            continue
        position = int(match.group(1))
        row = positions.setdefault(position, {"rings": {}})
        field = match.group(2)
        if field == "name":
            row["name"] = value
        elif field == "nodeid":
            try:
                row["node_id"] = int(value)
            except (TypeError, ValueError):
                abort("Corosync cmap has an invalid node ID")
        else:
            row["rings"][match.group(3)] = value
    if not positions or local_position not in positions:
        abort("Corosync cmap has no complete local nodelist")

    nodes = {}
    for position, row in positions.items():
        name = row.get("name")
        node_id = row.get("node_id")
        if (
            not isinstance(name, str)
            or not SAFE_NAME.fullmatch(name)
            or type(node_id) is not int
            or node_id <= 0
            or not row["rings"]
            or name in nodes
        ):
            abort("Corosync cmap has a malformed or duplicate nodelist node")
        nodes[name] = {"node_id": node_id, "rings": row["rings"]}
    expected_nodes = {
        row["name"]: row["node_id"] for row in expected_members
    }
    if {name: row["node_id"] for name, row in nodes.items()} != expected_nodes:
        abort("Corosync runtime nodelist differs from PVE membership")
    if positions[local_position].get("node_id") != expected_node_id:
        abort("Corosync cmap reports the wrong local node ID")

    members = {}
    member_pattern = re.compile(
        r"^runtime\.members\.(\d+)\.(config_version|ip|status)$"
    )
    address_pattern = re.compile(r"r\(([0-7])\)\s+ip\(([^)]+)\)")
    for key, value in values.items():
        match = member_pattern.match(key)
        if not match:
            continue
        node_id = int(match.group(1))
        row = members.setdefault(str(node_id), {"rings": {}})
        field = match.group(2)
        if field == "config_version":
            try:
                row["config_version"] = int(value)
            except (TypeError, ValueError):
                abort("Corosync cmap has an invalid member config version")
        elif field == "status":
            row["status"] = value
        else:
            matches = address_pattern.findall(value)
            if not matches or address_pattern.sub("", value).strip():
                abort("Corosync cmap has malformed member link addresses")
            row["rings"] = {ring: address.strip() for ring, address in matches}
    expected_ids = {str(value) for value in expected_nodes.values()}
    if set(members) != expected_ids:
        abort("Corosync joined runtime members differ from PVE membership")
    for row in members.values():
        if (
            row.get("status") != "joined"
            or type(row.get("config_version")) is not int
            or not row["rings"]
        ):
            abort("Corosync runtime member is not fully joined")

    binds = {}
    bind_pattern = re.compile(r"^totem\.interface\.([0-7])\.bindnetaddr$")
    for key, value in values.items():
        match = bind_pattern.match(key)
        if match:
            binds[match.group(1)] = value
    local_rings = positions[local_position]["rings"]
    if set(binds) != set(local_rings):
        abort("Corosync live bind links differ from its runtime nodelist")
    return {
        "cluster_name": cluster_name,
        "config_version": version,
        "local_node_id": expected_node_id,
        "nodes": nodes,
        "members": members,
        "bind_addresses": binds,
    }


def ovs_bridge_exists(name):
    return run(["ovs-vsctl", "--timeout=10", "br-exists", name], check=False).returncode == 0


def ovs_port_bridge(name):
    result = run(["ovs-vsctl", "--timeout=10", "iface-to-br", name], check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def check_pve_packages():
    pve = run(["dpkg-query", "-W", "-f=${Version}", "pve-manager"]).stdout.strip()
    pve = pve.split(":", 1)[-1]
    if not (pve == "9" or pve.startswith("9.")):
        abort("PVE 9 is required; found %s" % pve)
    for package in ("ifupdown2", "openvswitch-switch"):
        status = run(["dpkg-query", "-W", "-f=${db:Status-Status}", package]).stdout.strip()
        if status != "installed":
            abort("%s has incomplete package state: %s" % (package, status or "unknown"))


def installed_package_version(package):
    result = run([
        "dpkg-query", "-W", "-f=${db:Status-Abbrev} ${Version}", package,
    ]).stdout.strip()
    match = re.fullmatch(r"ii\s+([A-Za-z0-9.+:~_-]{1,200})", result)
    if not match:
        abort("%s has incomplete or unsafe package/version state" % package)
    return match.group(1)


def central_restart_pending():
    directory = CENTRAL_RESTART_DIR
    marker = CENTRAL_RESTART_MARKER
    if not os.path.lexists(str(directory)):
        return None
    try:
        directory_before = directory.lstat()
    except OSError as exc:
        abort("cannot inspect central restart state directory: %s" % exc)
    if (
        stat.S_ISLNK(directory_before.st_mode)
        or not stat.S_ISDIR(directory_before.st_mode)
        or directory_before.st_uid != 0
        or directory_before.st_gid != 0
        or stat.S_IMODE(directory_before.st_mode) != 0o700
    ):
        abort("central restart state directory must be root:root mode 0700")
    if not os.path.lexists(str(marker)):
        return None
    try:
        marker_before = marker.lstat()
    except OSError as exc:
        abort("cannot inspect central restart-required marker: %s" % exc)
    marker_identity = (marker_before.st_dev, marker_before.st_ino)
    if (
        stat.S_ISLNK(marker_before.st_mode)
        or not stat.S_ISREG(marker_before.st_mode)
        or marker_before.st_nlink != 1
        or marker_before.st_uid != 0
        or marker_before.st_gid != 0
        or stat.S_IMODE(marker_before.st_mode) != 0o600
    ):
        abort("central restart-required marker must be root:root mode 0600 with one link")
    raw = read_regular(marker, 512)
    try:
        marker_after = marker.lstat()
        directory_after = directory.lstat()
    except OSError as exc:
        abort("central restart state changed while being read: %s" % exc)
    if (
        (marker_after.st_dev, marker_after.st_ino) != marker_identity
        or stat.S_ISLNK(marker_after.st_mode)
        or not stat.S_ISREG(marker_after.st_mode)
        or marker_after.st_nlink != 1
        or marker_after.st_uid != 0
        or marker_after.st_gid != 0
        or stat.S_IMODE(marker_after.st_mode) != 0o600
        or (directory_after.st_dev, directory_after.st_ino)
        != (directory_before.st_dev, directory_before.st_ino)
        or stat.S_ISLNK(directory_after.st_mode)
        or not stat.S_ISDIR(directory_after.st_mode)
        or directory_after.st_uid != 0
        or directory_after.st_gid != 0
        or stat.S_IMODE(directory_after.st_mode) != 0o700
    ):
        abort("central restart state changed identity or safety metadata while being read")
    lines = raw.splitlines()
    if (
        len(lines) != 1
        or raw != lines[0] + "\n"
        or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,200}", lines[0])
    ):
        abort("central restart-required marker has invalid content")
    return lines[0]


def active_pvn_readiness():
    package_version = installed_package_version("pvn-node")
    restart_pending = central_restart_pending()
    doctor = run([PVNCTL, "doctor"], timeout=30, check=False)
    central = run([PVNCTL, "central", "status"], timeout=30, check=False)
    try:
        central_status = json.loads(central.stdout)
    except json.JSONDecodeError:
        central_status = None
    if central_status is not None and not isinstance(central_status, dict):
        central_status = None
    return {
        "package_version": package_version,
        "central_restart_pending": restart_pending,
        "doctor": doctor.returncode == 0,
        "central_status_ok": central.returncode == 0 and central_status is not None,
        "central_status": central_status,
    }


def validate_journal_for_request(journal, request):
    if journal is None:
        return
    if journal.get("transaction") != request["transaction"]:
        abort("an unrelated topology journal already exists")
    journal_spec = journal.get("spec")
    requested_spec = request.get("spec")
    if not isinstance(journal_spec, dict) or not isinstance(requested_spec, dict):
        abort("topology journal spec is invalid")
    if any(journal_spec.get(key) != value for key, value in requested_spec.items()):
        abort("topology journal does not match this exact request")
    if "guest_mtu" in requested_spec and journal_spec != requested_spec:
        abort("topology journal does not match this exact request")
    if journal.get("node") != request["node"]:
        abort("topology journal does not match this exact request")
    requested_effective = request.get("effective_underlay_mtu")
    if (
        requested_effective is not None
        and journal.get("effective_underlay_mtu") != requested_effective
    ):
        abort("topology journal has a different effective underlay MTU")


def read_ledger():
    if not (LEDGER_FILE.exists() or LEDGER_FILE.is_symlink()):
        return None, None
    text = read_regular(LEDGER_FILE, 1024 * 1024)
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        abort("invalid shared topology ledger: %s" % exc)
    if not isinstance(value, dict):
        abort("shared topology ledger must be an object")
    return text, sha_text(text)


def read_control_ledger():
    if not (CONTROL_LEDGER_FILE.exists() or CONTROL_LEDGER_FILE.is_symlink()):
        return None, None
    text = read_regular(CONTROL_LEDGER_FILE, 1024 * 1024)
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        abort("invalid shared control-plane ledger: %s" % exc)
    if not isinstance(value, dict):
        abort("shared control-plane ledger must be an object")
    return text, sha_text(text)


def resolve_effective_underlay_mtu(request, journal, ledger_text):
    recorded = []
    requested = request.get("effective_underlay_mtu")
    if requested is not None:
        recorded.append(("request", requested))
    request_spec = request.get("spec")
    if isinstance(request_spec, dict) and request_spec.get("effective_underlay_mtu") is not None:
        recorded.append(("request spec", request_spec.get("effective_underlay_mtu")))
    if journal is not None and journal.get("effective_underlay_mtu") is not None:
        recorded.append(("journal", journal.get("effective_underlay_mtu")))
    journal_spec = journal.get("spec") if isinstance(journal, dict) else None
    if isinstance(journal_spec, dict) and journal_spec.get("effective_underlay_mtu") is not None:
        recorded.append(("journal spec", journal_spec.get("effective_underlay_mtu")))
    if ledger_text is not None:
        ledger = json.loads(ledger_text)
        if ledger.get("effective_underlay_mtu") is not None:
            recorded.append(("ledger", ledger.get("effective_underlay_mtu")))
    expected = None
    for source, value in recorded:
        if type(value) is not int or value < 1280 or value > 65535:
            abort("%s has an invalid effective underlay MTU" % source)
        if expected is not None and value != expected:
            abort("recorded effective underlay MTUs do not match")
        expected = value
    return expected


def build_probe(request):
    activation = activation_state()
    active_readiness = (
        active_pvn_readiness() if activation_mode(activation) == "active" else None
    )
    require_commands(("ip", "pvecm", "pvesh", "ifquery", "ifreload", "ovs-vsctl", "corosync", "corosync-cfgtool", "corosync-cmapctl", "perl"))
    check_pve_packages()
    corosync_package_version = installed_package_version("corosync")
    cluster_status(request["node_count"], request["cluster_name"])

    node = request["node"]
    if run(["hostname", "-s"]).stdout.strip() != node:
        abort("SSH host is not the expected PVE node %s" % node)
    interfaces_text = read_regular(INTERFACES)
    corosync_text = read_regular(COROSYNC)
    interfaces_sha = sha_text(interfaces_text)
    corosync_sha = sha_text(corosync_text)
    links = link_rows()
    address_list = address_rows()
    addresses = addresses_by_interface(address_list)
    routes = route_rows()
    api = network_rows(node)
    member_rows = request["membership_snapshot"]["nodes"]
    local_ids = [row["node_id"] for row in member_rows if row["name"] == node]
    if len(local_ids) != 1:
        abort("membership snapshot has no unique local node ID")
    corosync_runtime = corosync_runtime_links(local_ids[0])
    corosync_runtime["config"] = corosync_runtime_config(
        local_ids[0], request["cluster_name"], member_rows
    )

    management_matches = []
    for ifname, values in addresses.items():
        for value in values:
            if value["address"] == request["management_ip"]:
                management_matches.append((ifname, value))
    if len(management_matches) != 1:
        abort("member management IP is not uniquely assigned")
    management_if, management_addr = management_matches[0]
    defaults = route_signature(routes)
    if not any(route.get("dev") == management_if for route in defaults):
        abort("the member management IP does not own a default route")

    geneve_net = ipaddress.ip_network(request["spec"]["geneve_cidr"])
    provider_net = ipaddress.ip_network(request["spec"]["provider_cidr"])
    journal = load_journal(optional=True)
    validate_journal_for_request(journal, request)
    ledger_text, ledger_sha = read_ledger()
    control_ledger_text, control_ledger_sha = read_control_ledger()
    effective_underlay_mtu = resolve_effective_underlay_mtu(
        request, journal, ledger_text
    )

    geneve = find_cidr_interface(geneve_net, addresses, links)
    provider_matches = []
    for ifname, values in addresses.items():
        for value in values:
            if ipaddress.ip_address(value["address"]) in provider_net:
                provider_matches.append((ifname, value))
    if len(provider_matches) == 1:
        provider_if, provider_addr = provider_matches[0]
        provider = physical_link(provider_if, links)
        provider["address"] = "%s/%d" % (provider_addr["address"], provider_addr["prefixlen"])
    elif len(provider_matches) == 0 and journal:
        saved = journal.get("provider", {})
        provider_if = saved.get("interface")
        provider = physical_link(provider_if, links, allow_ovs_master=True) if isinstance(provider_if, str) else None
        if not provider:
            abort("journal provider NIC is invalid")
        provider["address"] = saved.get("address")
        try:
            if ipaddress.ip_interface(provider["address"]).ip not in provider_net:
                abort("journal provider address is outside the requested CIDR")
        except ValueError:
            abort("journal provider address is invalid")
    else:
        abort("%s must have exactly one physical NIC/IP; found %d" % (provider_net, len(provider_matches)))

    if geneve["interface"] == provider["interface"]:
        abort("Geneve and provider CIDRs resolve to the same NIC")
    if management_if in (geneve["interface"], provider["interface"]):
        abort("a Geneve/provider candidate is the management interface")
    default_devs = {route.get("dev") for route in defaults}
    if geneve["interface"] in default_devs or provider["interface"] in default_devs:
        abort("a Geneve/provider candidate owns a default route")

    users = guest_config_users(node, (geneve["interface"], provider["interface"]))
    if users:
        abort("a VM/LXC config uses a candidate NIC: %s" % ", ".join(users))

    geneve_api = api.get(geneve["interface"], {})
    provider_api = api.get(provider["interface"], {})
    if geneve_api.get("type") != "eth":
        abort("Geneve NIC is already a bridge, bond, VLAN, or OVS port")
    for iface, row in api.items():
        if iface in ("br-provider",):
            continue
        fields = " ".join(str(row.get(key, "")) for key in ("bridge_ports", "ovs_ports", "slaves", "ovs_bonds"))
        tokens = fields.split()
        if geneve["interface"] in tokens or provider["interface"] in tokens:
            abort("candidate NIC is already used by %s" % iface)
    geneve["configured_mtu"] = configured_mtu(geneve_api, geneve["interface"])
    provider["configured_mtu"] = configured_mtu(provider_api, provider["interface"])
    br_int_configured_mtu = configured_mtu(api.get("br-int", {}), "br-int")
    br_provider_configured_mtu = configured_mtu(
        api.get("br-provider", {}), "br-provider"
    )

    br_int_live = ovs_bridge_exists("br-int")
    br_provider_live = ovs_bridge_exists("br-provider")
    provider_ovs_bridge = ovs_port_bridge(provider["interface"])
    provider_ipv4 = addresses.get(provider["interface"], [])
    connected_provider_routes = []
    for route in routes:
        if route.get("dev") == provider["interface"]:
            dst = route.get("dst")
            try:
                route_net = ipaddress.ip_network(dst, strict=False) if dst and dst != "default" else None
            except ValueError:
                route_net = None
            if route_net and route_net.overlaps(provider_net):
                connected_provider_routes.append(route)

    desired = (
        journal is not None
        and effective_underlay_mtu is not None
        and not provider_ipv4
        and not connected_provider_routes
        and provider_api.get("type") == "OVSPort"
        and provider_api.get("ovs_bridge") == "br-provider"
        and api.get("br-int", {}).get("type") == "OVSBridge"
        and api.get("br-provider", {}).get("type") == "OVSBridge"
        and provider["interface"] in str(api.get("br-provider", {}).get("ovs_ports", "")).split()
        and br_int_live and br_provider_live
        and provider_ovs_bridge == "br-provider"
        and geneve["configured_mtu"] == geneve["mtu"]
        and provider["configured_mtu"] == provider["mtu"]
        and br_int_configured_mtu == effective_underlay_mtu
        and br_provider_configured_mtu == provider["mtu"]
    )
    if not desired:
        if journal and not provider_ipv4:
            abort("journal exists but provider NIC is neither original nor exact desired state")
        if len(provider_matches) != 1:
            abort("provider NIC lacks its original single CIDR address")
        if provider_api.get("type") != "eth":
            abort("provider NIC is already a bridge, bond, VLAN, or OVS port")
        if br_int_live or br_provider_live or provider_ovs_bridge:
            abort("unmanaged PVN OVS bridge/port already exists")
        if "br-int" in api or "br-provider" in api:
            abort("unmanaged PVN bridge config already exists")

    pending_sha = None
    if PENDING.exists() or PENDING.is_symlink():
        pending_sha = sha_file(PENDING)
        if not journal or pending_sha != journal.get("desired_interfaces_sha256"):
            abort("unrelated pending PVE network changes exist")
    return {
        "node": node,
        "interfaces_sha256": interfaces_sha,
        "pending_interfaces_sha256": pending_sha,
        "corosync_sha256": corosync_sha,
        "corosync_text": corosync_text,
        "corosync_package_version": corosync_package_version,
        "corosync_runtime": corosync_runtime,
        "management": {
            "interface": management_if,
            "address": "%s/%d" % (management_addr["address"], management_addr["prefixlen"]),
            "default_routes": defaults,
        },
        "geneve": geneve,
        "provider": provider,
        "network_state": "desired" if desired else "initial",
        "journal": journal,
        "journal_phase": journal.get("phase") if journal else None,
        "ledger_text": ledger_text,
        "ledger_sha256": ledger_sha,
        "control_ledger_text": control_ledger_text,
        "control_ledger_sha256": control_ledger_sha,
        "active_readiness": active_readiness,
        "activation": activation,
        "activation_safe": activation_mode(activation) == "inactive",
    }


def exclusive_backup(path, content):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o600)
    except FileExistsError:
        if sha_file(path) != sha_text(content):
            abort("immutable backup content changed: %s" % path)
        return
    try:
        data = content.encode()
        offset = 0
        while offset < len(data):
            offset += os.write(fd, data[offset:])
        os.fsync(fd)
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)


def prepare(request):
    check_activation_absent()
    report = build_probe(request)
    effective_underlay_mtu = request.get("effective_underlay_mtu")
    if (
        type(effective_underlay_mtu) is not int
        or effective_underlay_mtu < 1280
        or effective_underlay_mtu > 65535
    ):
        abort("prepare request has an invalid effective underlay MTU")
    expected = request["expected"]
    if report["interfaces_sha256"] != expected["interfaces_sha256"]:
        abort("interfaces changed after preflight")
    if report["corosync_sha256"] != expected["corosync_sha256"]:
        abort("corosync.conf changed after preflight")
    ensure_state_dir()
    backup_dir = STATE_DIR / "backups" / request["transaction"]
    backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(backup_dir, 0o700)
    existing = load_journal(optional=True)
    if existing:
        validate_journal_for_request(existing, request)
        emit(journal=existing, report=report)
        return
    interfaces_text = read_regular(INTERFACES)
    corosync_text = read_regular(COROSYNC)
    exclusive_backup(backup_dir / "interfaces.before", interfaces_text)
    exclusive_backup(backup_dir / "corosync.before", corosync_text)
    value = {
        "schema": 1,
        "transaction": request["transaction"],
        "spec": request["spec"],
        "node": request["node"],
        "management": report["management"],
        "geneve": report["geneve"],
        "provider": report["provider"],
        "effective_underlay_mtu": effective_underlay_mtu,
        "before_interfaces_sha256": sha_text(interfaces_text),
        "before_corosync_sha256": sha_text(corosync_text),
        "desired_interfaces_sha256": None,
        "phase": "prepared",
    }
    save_journal(value)
    emit(journal=value, report=report)


def validate_corosync(request):
    check_activation_absent()
    current = sha_file(COROSYNC)
    if current != request["expected_sha256"]:
        abort("corosync.conf failed compare-and-swap validation")
    candidate = request["candidate"]
    if sha_text(candidate) != request["candidate_sha256"]:
        abort("corosync candidate hash mismatch")
    fd, path = tempfile.mkstemp(prefix="pvn-corosync-", suffix=".conf", dir="/run")
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, candidate.encode())
        os.fsync(fd)
        os.close(fd)
        fd = -1
        run(["corosync", "-t", "-c", path])
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    emit(valid=True)


def apply_corosync(request):
    check_activation_absent()
    if installed_package_version("corosync") != request.get("corosync_package_version"):
        abort("Corosync package version changed before shared config write")
    local_id, members = corosync_request_identity(request)
    runtime = corosync_runtime_links(local_id)
    runtime["config"] = corosync_runtime_config(
        local_id, request["cluster_name"], members
    )
    require_full_bridge(request, runtime)
    boundary_mode = request.get("runtime_boundary_mode")
    if boundary_mode not in ("exact", "stale-v0.2.13", "partial-rollback"):
        abort("Corosync config write has no valid runtime boundary mode")
    if boundary_mode != "partial-rollback" and not runtime_target_fully_loaded(
        request, runtime, request.get("runtime_boundary_target")
    ):
        abort("Corosync runtime boundary changed immediately before config CAS")
    candidate = request["candidate"]
    if sha_text(candidate) != request["candidate_sha256"]:
        abort("corosync candidate hash mismatch")
    result = pve_cas("apply-corosync", {
        "expected_current_sha256": request["expected_sha256"],
        "content": candidate,
        "content_sha256": request["candidate_sha256"],
    })
    if result.get("corosync_sha256") != request["candidate_sha256"]:
        abort("Corosync CAS helper installed an unexpected candidate")
    emit(corosync_sha256=sha_file(COROSYNC))


def corosync_request_identity(request):
    members = request.get("membership_snapshot", {}).get("nodes")
    if not isinstance(members, list) or not members:
        abort("Corosync runtime request has no pinned membership")
    node = request.get("node")
    local = [row for row in members if isinstance(row, dict) and row.get("name") == node]
    if len(local) != 1 or type(local[0].get("node_id")) is not int:
        abort("Corosync runtime request has no unique local node ID")
    if run(["hostname", "-s"]).stdout.strip() != node:
        abort("SSH host is not the expected PVE node %s" % node)
    cluster_status(len(members), request.get("cluster_name"))
    return local[0]["node_id"], members


def require_full_bridge(request, runtime):
    ring = request.get("bridge_ring")
    addresses = request.get("bridge_addresses")
    members = request["membership_snapshot"]["nodes"]
    if type(ring) is not int or ring < 0 or ring > 7 or not isinstance(addresses, dict):
        abort("Corosync bridge-ring request is invalid")
    link = runtime["links"].get(ring)
    if link is None:
        link = runtime["links"].get(str(ring))
    expected_ids = sorted(row["node_id"] for row in members)
    local_address = addresses.get(request["node"])
    if (
        not isinstance(link, dict)
        or link.get("connected_node_ids") != expected_ids
        or link.get("address") != local_address
    ):
        abort("Corosync safety bridge is not fully connected on this node")


def runtime_target_loaded(request, runtime):
    return runtime_target_loaded_from(
        request, runtime, request.get("runtime_target")
    )


def runtime_target_loaded_from(request, runtime, target):
    if not isinstance(target, dict):
        return False
    config = runtime.get("config", {})
    if (
        config.get("cluster_name") != target.get("cluster_name")
        or config.get("config_version") != target.get("config_version")
        or config.get("local_node_id") != runtime.get("local_node_id")
        or config.get("nodes") != target.get("nodes")
    ):
        return False
    local = target["nodes"].get(request["node"], {})
    rings = local.get("rings", {})
    binds = target.get("bind_addresses", {}).get(request["node"], {})
    if set(rings) != set(binds) or config.get("bind_addresses") != binds:
        return False
    links = runtime.get("links", {})
    if {str(value) for value in links} != set(rings):
        return False
    for raw_ring, address in binds.items():
        link = links.get(int(raw_ring))
        if link is None:
            link = links.get(raw_ring)
        if not isinstance(link, dict) or link.get("address") != address:
            return False
    return True


def runtime_target_fully_loaded(request, runtime, target):
    if not runtime_target_loaded_from(request, runtime, target):
        return False
    members = runtime.get("config", {}).get("members", {})
    nodes = target.get("nodes", {})
    binds = target.get("bind_addresses", {})
    expected_ids = {str(row.get("node_id")) for row in nodes.values()}
    if set(members) != expected_ids or set(binds) != set(nodes):
        return False
    for name, node in nodes.items():
        row = members.get(str(node.get("node_id")), {})
        if (
            row.get("status") != "joined"
            or row.get("config_version") != target.get("config_version")
            or row.get("rings") != binds.get(name)
        ):
            return False
    return True


def reload_corosync(request):
    check_activation_absent()
    local_id, members = corosync_request_identity(request)
    if installed_package_version("corosync") != request.get("corosync_package_version"):
        abort("Corosync package version changed before runtime reload")
    if sha_file(COROSYNC) != request.get("expected_sha256"):
        abort("corosync.conf changed before runtime reload")
    runtime = corosync_runtime_links(local_id)
    runtime["config"] = corosync_runtime_config(
        local_id, request["cluster_name"], members
    )
    require_full_bridge(request, runtime)
    run(["corosync-cfgtool", "-R"])
    emit(reloaded=True, corosync_sha256=sha_file(COROSYNC))


def restart_corosync(request):
    check_activation_absent()
    local_id, members = corosync_request_identity(request)
    if installed_package_version("corosync") != request.get("corosync_package_version"):
        abort("Corosync package version changed before guarded restart")
    if sha_file(COROSYNC) != request.get("expected_sha256"):
        abort("corosync.conf changed before guarded restart")
    runtime = corosync_runtime_links(local_id)
    runtime["config"] = corosync_runtime_config(
        local_id, request["cluster_name"], members
    )
    require_full_bridge(request, runtime)
    run(["systemctl", "restart", "corosync.service"], timeout=90)
    deadline = time.monotonic() + 90
    last_error = "Corosync did not rejoin"
    while time.monotonic() < deadline:
        try:
            cluster_status(len(members), request.get("cluster_name"))
            runtime = corosync_runtime_links(local_id)
            runtime["config"] = corosync_runtime_config(
                local_id, request["cluster_name"], members
            )
            require_full_bridge(request, runtime)
            if not runtime_target_loaded(request, runtime):
                abort("restarted Corosync has not loaded the persisted target")
            emit(restarted=True, corosync_sha256=sha_file(COROSYNC))
            return
        except RemoteFailure as exc:
            last_error = str(exc)
            time.sleep(2)
    abort(last_error)


def config_ring_addresses(text, ring):
    result = {}
    block_re = re.compile(r"(?ms)^\s*node\s*\{.*?^\s*\}")
    for match in block_re.finditer(text):
        block = match.group(0)
        name = re.findall(r"^\s*name:\s*(\S+)\s*$", block, re.M)
        addr = re.findall(r"^\s*ring%d_addr:\s*(\S+)\s*$" % ring, block, re.M)
        if len(name) == 1 and len(addr) == 1:
            result[name[0]] = addr[0]
    return result


def verify_cluster(request):
    check_activation_absent()
    cluster_status(request["node_count"], request["cluster_name"])
    current_text = read_regular(COROSYNC)
    current_sha = sha_text(current_text)
    if current_sha not in request["allowed_corosync_sha256"]:
        abort("unexpected shared corosync.conf during verification")
    if request.get("ring") is not None:
        actual = config_ring_addresses(current_text, int(request["ring"]))
        if actual != request["expected_ring_addresses"]:
            abort("Corosync ring addresses do not match the verified target")
    status = run(["corosync-cfgtool", "-s"]).stdout
    if re.search(r"connected\s*:\s*no", status, re.I):
        abort("Corosync reports a disconnected peer")
    for peer in request.get("management_peers", []):
        run(["ping", "-n", "-c", "1", "-W", "2", peer])
    emit(verified=True, corosync_sha256=current_sha)


def discard_pending(expected_sha256):
    response = pve_cas("discard-network", {
        "expected_pending_sha256": expected_sha256,
    })
    return response.get("discarded") is True


def assert_staged_network(node, request):
    rows = network_rows(node)
    geneve = rows.get(request["geneve"]["interface"], {})
    provider = rows.get(request["provider"]["interface"], {})
    br_int = rows.get("br-int", {})
    br_provider = rows.get("br-provider", {})
    if geneve.get("type") != "eth" or int(geneve.get("mtu", 0)) != request["geneve"]["mtu"]:
        abort("staged Geneve NIC does not preserve its verified live MTU")
    if provider.get("type") != "OVSPort" or provider.get("ovs_bridge") != "br-provider":
        abort("staged provider NIC is not an OVS port")
    if any(provider.get(key) for key in ("cidr", "address", "gateway", "cidr6", "address6", "gateway6")):
        abort("staged provider NIC still has L3 configuration")
    if br_int.get("type") != "OVSBridge" or br_provider.get("type") != "OVSBridge":
        abort("staged PVN OVS bridges are missing")
    if int(br_int.get("mtu", 0)) != request["effective_underlay_mtu"]:
        abort("staged integration bridge MTU differs from the safe live underlay MTU")
    if int(br_provider.get("mtu", 0)) != request["provider"]["mtu"]:
        abort("staged provider bridge does not preserve the verified live provider MTU")
    if request["provider"]["interface"] not in str(br_provider.get("ovs_ports", "")).split():
        abort("staged provider bridge does not contain the physical NIC")


def stage_network(request):
    check_activation_absent()
    journal = load_journal(optional=False)
    validate_journal_for_request(journal, request)
    current = sha_file(INTERFACES)
    if current != journal["before_interfaces_sha256"]:
        if journal.get("desired_interfaces_sha256") == current and not PENDING.exists():
            emit(noop=True, desired_interfaces_sha256=current)
            return
        abort("interfaces failed compare-and-swap before staging")
    if PENDING.exists() or PENDING.is_symlink():
        pending_sha = sha_file(PENDING)
        if pending_sha == journal.get("desired_interfaces_sha256"):
            emit(noop=True, desired_interfaces_sha256=pending_sha)
            return
        abort("unrelated pending PVE network changes exist")

    node = request["node"]
    owned_desired = None
    try:
        response = pve_cas("stage-network", {
            "expected_current_sha256": journal["before_interfaces_sha256"],
            "geneve": request["geneve"],
            "provider": request["provider"],
            "effective_underlay_mtu": request["effective_underlay_mtu"],
        })
        owned_desired = response.get("desired_sha256")
        if not isinstance(owned_desired, str) or not SHA256.fullmatch(owned_desired):
            abort("PVE network CAS helper returned an invalid candidate hash")
        if sha_file(PENDING) != owned_desired:
            abort("pending interfaces changed immediately after atomic staging")
        run(["ifquery", "-i", str(PENDING), "-a"])
        assert_staged_network(node, request)
        if sha_file(PENDING) != owned_desired:
            abort("pending interfaces changed during validation")
        journal["desired_interfaces_sha256"] = owned_desired
        journal["phase"] = "network-staged"
        save_journal(journal)
        emit(noop=False, desired_interfaces_sha256=owned_desired)
    except Exception as error:
        if owned_desired:
            try:
                discard_pending(owned_desired)
            except Exception as cleanup_error:
                abort("%s; owned pending cleanup also failed: %s" % (error, cleanup_error))
        raise


def apply_network(request):
    check_activation_absent()
    journal = load_journal(optional=False)
    validate_journal_for_request(journal, request)
    desired = journal.get("desired_interfaces_sha256")
    if not isinstance(desired, str) or not SHA256.fullmatch(desired):
        abort("network candidate has not been staged")
    current = sha_file(INTERFACES)
    if current == desired and not PENDING.exists():
        emit(noop=True, interfaces_sha256=current)
        return
    if current != journal["before_interfaces_sha256"]:
        abort("interfaces changed before network apply")
    result = pve_cas("apply-network", {
        "expected_current_sha256": journal["before_interfaces_sha256"],
        "expected_pending_sha256": desired,
    })
    if result.get("interfaces_sha256") != desired:
        abort("PVE network CAS helper installed an unexpected candidate")
    run(["ifreload", "-a"], timeout=90)
    if sha_file(INTERFACES) != desired:
        abort("PVE network API did not install the staged file")
    journal["phase"] = "network-applied-unverified"
    save_journal(journal)
    emit(noop=False, interfaces_sha256=desired)


def ping_geneve(request):
    source = request["geneve"]["address"].split("/", 1)[0]
    for peer in request.get("geneve_peers", []):
        run(["ping", "-n", "-c", "1", "-W", "2", "-I", source, peer])


def verify_network(request):
    report = build_probe(request)
    if report["network_state"] != "desired":
        abort("node does not match the exact desired network state")
    journal = load_journal(optional=False)
    if report["interfaces_sha256"] != journal.get("desired_interfaces_sha256"):
        abort("live interfaces do not match the journaled candidate")
    if report["management"] != journal.get("management"):
        abort("management IP/default route changed")
    if report["geneve"]["interface"] != journal.get("geneve", {}).get("interface"):
        abort("Geneve NIC changed")
    ping_geneve(request)
    cluster_status(request["node_count"], request["cluster_name"])
    check_activation_absent()
    emit(verified=True, report=report)


def rollback_network(request):
    check_activation_absent()
    journal = load_journal(optional=False)
    validate_journal_for_request(journal, request)
    desired = journal.get("desired_interfaces_sha256")
    before = journal.get("before_interfaces_sha256")
    current = sha_file(INTERFACES)
    if PENDING.exists() or PENDING.is_symlink():
        discard_pending(desired)
    if current == before:
        journal["phase"] = "network-rolled-back"
        save_journal(journal)
        report = build_probe(request)
        if report["network_state"] != "initial" or report["management"] != journal.get("management"):
            abort("rollback file is original but live network state is not")
        emit(noop=True, interfaces_sha256=current, report=report)
        return
    if current != desired:
        abort("refusing rollback after unrelated interfaces drift")
    backup = STATE_DIR / "backups" / request["transaction"] / "interfaces.before"
    content = read_regular(backup)
    if sha_text(content) != before:
        abort("interfaces backup hash mismatch")
    staged = pve_cas("write-pending", {
        "expected_current_sha256": desired,
        "replace_pending_sha256": desired,
        "content": content,
        "content_sha256": before,
    })
    if staged.get("pending_sha256") != before:
        abort("network rollback CAS helper staged an unexpected backup")
    run(["ifquery", "-i", str(PENDING), "-a"])
    applied = pve_cas("apply-network", {
        "expected_current_sha256": desired,
        "expected_pending_sha256": before,
    })
    if applied.get("interfaces_sha256") != before:
        abort("network rollback CAS helper installed an unexpected backup")
    run(["ifreload", "-a"], timeout=90)
    if sha_file(INTERFACES) != before:
        abort("interfaces rollback did not restore the immutable backup")
    journal["phase"] = "network-rolled-back"
    save_journal(journal)
    report = build_probe(request)
    if report["network_state"] != "initial" or report["management"] != journal.get("management"):
        abort("rollback did not restore the original live network state")
    emit(noop=False, interfaces_sha256=before, report=report)


def discard_stage(request):
    check_activation_absent()
    journal = load_journal(optional=False)
    validate_journal_for_request(journal, request)
    if not (PENDING.exists() or PENDING.is_symlink()):
        emit(noop=True)
        return
    discarded = discard_pending(journal.get("desired_interfaces_sha256"))
    emit(noop=not discarded)


def record_phase(request):
    check_activation_absent()
    journal = load_journal(optional=False)
    validate_journal_for_request(journal, request)
    phase = request.get("phase")
    if phase not in (
        "corosync-dual-runtime", "corosync-final-runtime",
        "corosync-migrated", "complete",
    ):
        abort("invalid journal phase")
    journal["phase"] = phase
    save_journal(journal)
    emit(phase=phase)


LEDGER_UPGRADE_PROOF_KEYS = (
    "node", "interfaces_sha256", "pending_interfaces_sha256",
    "corosync_sha256", "corosync_text", "corosync_package_version",
    "corosync_runtime", "management", "geneve", "provider",
    "network_state", "journal", "journal_phase", "activation",
    "control_ledger_text", "control_ledger_sha256",
    "active_readiness",
)


def ledger_upgrade_proof_sha256(report):
    proof = {key: report.get(key) for key in LEDGER_UPGRADE_PROOF_KEYS}
    return sha_text(json.dumps(proof, sort_keys=True, separators=(",", ":")))


def require_active_ledger_upgrade(request, expected_ledger_sha256):
    if request.get("ledger_upgrade_only") is not True:
        abort("active ledger mutation lacks its explicit upgrade-only fence")
    report = build_probe(request)
    if activation_mode(report.get("activation")) != "active":
        abort("ledger-only upgrade requires one exact active PVN state")
    journal = report.get("journal")
    if (
        not isinstance(journal, dict)
        or journal.get("phase") != "complete"
        or report.get("network_state") != "desired"
        or report.get("pending_interfaces_sha256") is not None
        or report.get("interfaces_sha256") != journal.get("desired_interfaces_sha256")
    ):
        abort("ledger-only upgrade local topology proof is no longer complete")
    if report.get("ledger_sha256") != expected_ledger_sha256:
        abort("ledger-only upgrade observed a different shared ledger boundary")
    if ledger_upgrade_proof_sha256(report) != request.get("upgrade_proof_sha256"):
        abort("ledger-only upgrade local proof changed before ledger CAS")
    return report


def write_ledger(request):
    content = request.get("ledger")
    expected_hash = request.get("expected_ledger_sha256")
    desired_hash = request.get("ledger_sha256")
    if not isinstance(content, str) or sha_text(content) != desired_hash:
        abort("shared topology ledger hash mismatch")
    if request.get("ledger_upgrade_only") is True:
        require_active_ledger_upgrade(request, expected_hash)
    else:
        check_activation_absent()
    _current_text, current_hash = read_ledger()
    if current_hash != expected_hash:
        abort("shared topology ledger failed compare-and-swap")
    if current_hash == desired_hash:
        emit(noop=True, ledger_sha256=current_hash)
        return
    LEDGER_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = LEDGER_DIR.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
        abort("unsafe shared topology ledger directory")
    atomic_write(LEDGER_FILE, content, 0o600)
    _text, written_hash = read_ledger()
    if written_hash != desired_hash:
        abort("shared topology ledger write did not persist")
    emit(noop=False, ledger_sha256=written_hash)


def verify_ledger(request):
    if request.get("ledger_upgrade_only") is True:
        require_active_ledger_upgrade(request, request.get("ledger_sha256"))
    else:
        check_activation_absent()
    _text, current_hash = read_ledger()
    if current_hash != request.get("ledger_sha256"):
        abort("shared topology ledger is absent or inconsistent")
    emit(ledger_sha256=current_hash)


def restore_ledger(request):
    check_activation_absent()
    original = request.get("original_ledger")
    original_hash = request.get("original_ledger_sha256")
    failed_hash = request.get("failed_ledger_sha256")
    if original is None:
        if original_hash is not None:
            abort("absent original ledger has a non-empty hash")
    elif not isinstance(original, str) or sha_text(original) != original_hash:
        abort("original shared topology ledger hash mismatch")
    _current_text, current_hash = read_ledger()
    if current_hash == original_hash:
        emit(noop=True, ledger_sha256=current_hash)
        return
    if current_hash != failed_hash:
        abort("refusing shared ledger rollback after unrelated drift")
    if original is None:
        LEDGER_FILE.unlink()
        emit(noop=False, ledger_sha256=None)
        return
    atomic_write(LEDGER_FILE, original, 0o600)
    _text, restored_hash = read_ledger()
    if restored_hash != original_hash:
        abort("shared topology ledger rollback did not persist")
    emit(noop=False, ledger_sha256=restored_hash)


def main():
    if os.geteuid() != 0:
        abort("remote helper must run as root")
    if len(sys.argv) != 2:
        abort("invalid remote helper invocation")
    action = sys.argv[1]
    try:
        raw_request = sys.stdin.buffer.read(REMOTE_REQUEST_LIMIT + 1)
        if len(raw_request) > REMOTE_REQUEST_LIMIT:
            abort("remote request exceeds the bounded input limit")
        request = json.loads(raw_request.decode("utf-8"))
    except Exception as exc:
        abort("invalid request: %s" % exc)
    if not isinstance(request, dict):
        abort("request must be an object")
    cleanup_actions = {
        "rollback-network", "discard-stage", "restore-ledger",
    }
    if action not in cleanup_actions:
        verify_membership_snapshot(request.get("membership_snapshot"))
    handlers = {
        "probe": lambda: emit(report=build_probe(request)),
        "prepare": lambda: prepare(request),
        "validate-corosync": lambda: validate_corosync(request),
        "apply-corosync": lambda: apply_corosync(request),
        "reload-corosync": lambda: reload_corosync(request),
        "restart-corosync": lambda: restart_corosync(request),
        "verify-cluster": lambda: verify_cluster(request),
        "stage-network": lambda: stage_network(request),
        "apply-network": lambda: apply_network(request),
        "verify-network": lambda: verify_network(request),
        "rollback-network": lambda: rollback_network(request),
        "discard-stage": lambda: discard_stage(request),
        "record-phase": lambda: record_phase(request),
        "write-ledger": lambda: write_ledger(request),
        "verify-ledger": lambda: verify_ledger(request),
        "restore-ledger": lambda: restore_ledger(request),
    }
    handler = handlers.get(action)
    if not handler:
        abort("unknown remote action")
    handler()


try:
    main()
except RemoteFailure as exc:
    print("PVN topology precondition failed: %s" % exc, file=sys.stderr)
    sys.exit(1)
'''


def ssh_request(node: dict[str, Any], action: str, request: dict[str, Any], timeout: int = 120) -> dict[str, Any]:
    payload = canonical_json(request)
    if len(payload.encode("utf-8")) > REMOTE_REQUEST_LIMIT:
        fail(f"{node['name']} {action} request exceeds the bounded input limit")
    remote_command = "python3 -c %s %s" % (shlex.quote(REMOTE_HELPER), shlex.quote(action))
    argv = [
        SSH_BIN,
        "-F", "/dev/null",
        "-e", "none",
        "-i", str(PVE_IDENTITY_FILE),
        "-o", "BatchMode=yes",
        "-o", "PasswordAuthentication=no",
        "-o", "KbdInteractiveAuthentication=no",
        "-o", "PubkeyAuthentication=yes",
        "-o", "PreferredAuthentications=publickey",
        "-o", "IdentitiesOnly=yes",
        "-o", "NumberOfPasswordPrompts=0",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "CheckHostIP=no",
        "-o", "VerifyHostKeyDNS=no",
        "-o", "UpdateHostKeys=no",
        "-o", "GlobalKnownHostsFile=/dev/null",
        "-o", f"UserKnownHostsFile={PVE_NODES_DIR / node['name'] / 'ssh_known_hosts'}",
        "-o", f"HostKeyAlias={node['name']}",
        "-o", "ConnectTimeout=10",
        "-o", "ConnectionAttempts=1",
        "--", f"root@{node['ip']}", remote_command,
    ]
    result = run_bounded_process(argv, payload, timeout)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().replace("\n", "; ")
        fail(f"{node['name']} {action} failed: {detail[:800]}")
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if len(lines) != 1:
        fail(f"{node['name']} {action} returned unexpected output")
    try:
        response = json.loads(lines[0])
    except json.JSONDecodeError as exc:
        fail(f"{node['name']} {action} returned invalid JSON: {exc}")
    if not isinstance(response, dict) or response.get("ok") is not True:
        fail(f"{node['name']} {action} did not return a successful result")
    return response


def common_request(
    node: dict[str, Any],
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    membership_snapshot: dict[str, Any],
) -> dict[str, Any]:
    request = {
        "cluster_name": cluster_name,
        "node": node["name"],
        "node_count": len(nodes),
        "management_ip": node["ip"],
        "spec": spec,
        "transaction": transaction,
        "membership_snapshot": membership_snapshot,
    }
    effective_underlay_mtu = spec.get("effective_underlay_mtu")
    if effective_underlay_mtu is not None:
        request["effective_underlay_mtu"] = effective_underlay_mtu
    return request


def activation_report_mode(value: Any) -> str:
    if not isinstance(value, dict):
        return "mixed"
    markers = value.get("markers")
    units = value.get("units")
    if (
        not isinstance(markers, dict)
        or set(markers) != set(ACTIVATION_MARKERS)
        or any(type(item) is not bool for item in markers.values())
        or not isinstance(units, dict)
        or set(units) != set(ACTIVATION_UNITS)
        or any(type(item) is not bool for item in units.values())
    ):
        return "mixed"
    states = list(markers.values()) + list(units.values())
    if all(states):
        return "active"
    if not any(states):
        return "inactive"
    return "mixed"


def validate_report(report: Any, node: dict[str, Any], spec: dict[str, Any]) -> dict[str, Any]:
    if not isinstance(report, dict) or report.get("node") != node["name"]:
        fail(f"malformed topology report from {node['name']}")
    for key in ("interfaces_sha256", "corosync_sha256"):
        if not isinstance(report.get(key), str) or not SHA256.fullmatch(report[key]):
            fail(f"invalid {key} from {node['name']}")
    package_version = report.get("corosync_package_version")
    if (
        not isinstance(package_version, str)
        or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,200}", package_version)
    ):
        fail(f"invalid Corosync package version from {node['name']}")
    if not isinstance(report.get("corosync_text"), str) or len(report["corosync_text"]) > 4 * 1024 * 1024:
        fail(f"invalid corosync.conf from {node['name']}")
    if digest_text(report["corosync_text"]) != report["corosync_sha256"]:
        fail(f"corosync.conf hash mismatch from {node['name']}")
    runtime = report.get("corosync_runtime")
    if not isinstance(runtime, dict) or runtime.get("local_node_id") != node["id"]:
        fail(f"invalid Corosync runtime identity from {node['name']}")
    links = runtime.get("links")
    if not isinstance(links, dict) or not links:
        fail(f"missing Corosync runtime links from {node['name']}")
    for raw_ring, link in links.items():
        if type(raw_ring) is int:
            ring = raw_ring
        elif isinstance(raw_ring, str) and re.fullmatch(r"[0-7]", raw_ring):
            ring = int(raw_ring)
        else:
            fail(f"invalid Corosync runtime link from {node['name']}")
        if ring < 0 or ring > 7 or not isinstance(link, dict):
            fail(f"invalid Corosync runtime link from {node['name']}")
        try:
            address = ipaddress.ip_address(link.get("address"))
        except ValueError:
            fail(f"invalid Corosync runtime address from {node['name']}")
        if not isinstance(address, ipaddress.IPv4Address):
            fail(f"non-IPv4 Corosync runtime address from {node['name']}")
        connected = link.get("connected_node_ids")
        if (
            not isinstance(connected, list)
            or any(type(value) is not int or value <= 0 for value in connected)
            or connected != sorted(set(connected))
            or node["id"] not in connected
        ):
            fail(f"invalid Corosync runtime membership from {node['name']}")
    runtime_config = runtime.get("config")
    if (
        not isinstance(runtime_config, dict)
        or runtime_config.get("cluster_name") != spec["cluster_name"]
        or runtime_config.get("local_node_id") != node["id"]
        or type(runtime_config.get("config_version")) is not int
        or runtime_config["config_version"] < 0
    ):
        fail(f"invalid Corosync cmap identity from {node['name']}")
    cmap_nodes = runtime_config.get("nodes")
    cmap_members = runtime_config.get("members")
    cmap_binds = runtime_config.get("bind_addresses")
    if not all(isinstance(value, dict) and value for value in (cmap_nodes, cmap_members, cmap_binds)):
        fail(f"incomplete Corosync cmap from {node['name']}")
    for name, row in cmap_nodes.items():
        if (
            not isinstance(name, str)
            or not SAFE_NAME.fullmatch(name)
            or not isinstance(row, dict)
            or type(row.get("node_id")) is not int
            or row["node_id"] <= 0
            or not isinstance(row.get("rings"), dict)
            or not row["rings"]
        ):
            fail(f"invalid Corosync cmap nodelist from {node['name']}")
    for raw_id, row in cmap_members.items():
        if (
            not isinstance(raw_id, str)
            or not raw_id.isdigit()
            or not isinstance(row, dict)
            or row.get("status") != "joined"
            or type(row.get("config_version")) is not int
            or not isinstance(row.get("rings"), dict)
            or not row["rings"]
        ):
            fail(f"invalid Corosync cmap member from {node['name']}")
    if any(
        not isinstance(raw_ring, str)
        or not re.fullmatch(r"[0-7]", raw_ring)
        or not isinstance(value, str)
        or not value
        for raw_ring, value in cmap_binds.items()
    ):
        fail(f"invalid Corosync cmap bind addresses from {node['name']}")
    if report.get("network_state") not in ("initial", "desired"):
        fail(f"unsafe topology state reported by {node['name']}")
    activation_mode = activation_report_mode(report.get("activation"))
    if activation_mode == "mixed":
        fail(f"mixed or malformed PVN activation state on {node['name']}")
    if report.get("activation_safe") is not (activation_mode == "inactive"):
        fail(f"inconsistent PVN activation report from {node['name']}")
    active_readiness = report.get("active_readiness")
    if activation_mode == "active":
        readiness_keys = {
            "package_version", "central_restart_pending", "doctor",
            "central_status_ok", "central_status",
        }
        if not isinstance(active_readiness, dict) or set(active_readiness) != readiness_keys:
            fail(f"malformed active PVN readiness report from {node['name']}")
        version = active_readiness.get("package_version")
        marker = active_readiness.get("central_restart_pending")
        if (
            not isinstance(version, str)
            or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,200}", version)
            or (
                marker is not None
                and (
                    not isinstance(marker, str)
                    or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,200}", marker)
                )
            )
            or type(active_readiness.get("doctor")) is not bool
            or type(active_readiness.get("central_status_ok")) is not bool
            or (
                active_readiness.get("central_status") is not None
                and not isinstance(active_readiness.get("central_status"), dict)
            )
        ):
            fail(f"invalid active PVN readiness report from {node['name']}")
    elif active_readiness is not None:
        fail(f"inactive node {node['name']} unexpectedly reported active PVN readiness")
    journal = report.get("journal")
    if journal is not None:
        if (
            not isinstance(journal, dict)
            or journal.get("schema") != 1
            or len(canonical_json(journal)) > 1024 * 1024
        ):
            fail(f"invalid topology journal from {node['name']}")
    ledger_sha = report.get("ledger_sha256")
    if ledger_sha is not None and (not isinstance(ledger_sha, str) or not SHA256.fullmatch(ledger_sha)):
        fail(f"invalid topology ledger hash from {node['name']}")
    ledger_text = report.get("ledger_text")
    if ledger_sha is None:
        if ledger_text is not None:
            fail(f"unexpected topology ledger content from {node['name']}")
    elif (
        not isinstance(ledger_text, str)
        or len(ledger_text) > 1024 * 1024
        or digest_text(ledger_text) != ledger_sha
    ):
        fail(f"invalid topology ledger content from {node['name']}")
    control_ledger_sha = report.get("control_ledger_sha256")
    control_ledger_text = report.get("control_ledger_text")
    if control_ledger_sha is None:
        if control_ledger_text is not None:
            fail(f"unexpected control-plane ledger content from {node['name']}")
    elif (
        not isinstance(control_ledger_sha, str)
        or not SHA256.fullmatch(control_ledger_sha)
        or not isinstance(control_ledger_text, str)
        or len(control_ledger_text) > 1024 * 1024
        or digest_text(control_ledger_text) != control_ledger_sha
    ):
        fail(f"invalid control-plane ledger content from {node['name']}")
    for role, cidr in (("geneve", spec["geneve_cidr"]), ("provider", spec["provider_cidr"])):
        value = report.get(role)
        if not isinstance(value, dict) or not isinstance(value.get("interface"), str):
            fail(f"invalid {role} NIC report from {node['name']}")
        if not SAFE_NAME.fullmatch(value["interface"]):
            fail(f"unsafe {role} NIC name from {node['name']}")
        try:
            address = ipaddress.ip_interface(value.get("address"))
        except ValueError:
            fail(f"invalid {role} address from {node['name']}")
        if address.ip not in ipaddress.ip_network(cidr):
            fail(f"{role} address from {node['name']} is outside {cidr}")
        for mtu_key in ("mtu", "max_mtu"):
            if not isinstance(value.get(mtu_key), int) or value[mtu_key] < 1280:
                fail(f"invalid {role} {mtu_key} from {node['name']}")
        if value["mtu"] > value["max_mtu"]:
            fail(f"live MTU exceeds actual max MTU on {node['name']} {role}")
        if "configured_mtu" not in value:
            fail(f"missing configured MTU on {node['name']} {role}")
        configured = value.get("configured_mtu")
        if configured is not None and (
            type(configured) is not int or configured < 1280 or configured > 65535
        ):
            fail(f"invalid configured MTU on {node['name']} {role}")
    management = report.get("management")
    if not isinstance(management, dict) or not management.get("default_routes"):
        fail(f"invalid management/default-route report from {node['name']}")
    if report["geneve"]["interface"] == report["provider"]["interface"]:
        fail(f"Geneve and provider use the same NIC on {node['name']}")
    return report


NODE_BLOCK = re.compile(r"(?ms)^\s*node\s*\{.*?^\s*\}")


def parse_corosync(text: str, expected_nodes: set[str], cluster_name: str) -> tuple[int, dict[int, dict[str, str]]]:
    cluster_names = re.findall(r"^\s*cluster_name:\s*(\S+)\s*$", text, re.M)
    versions = re.findall(r"^\s*config_version:\s*(\d+)\s*$", text, re.M)
    if len(cluster_names) != 1 or cluster_names[0] != cluster_name or len(versions) != 1:
        fail("corosync.conf has an unexpected cluster name or config_version")
    rings: dict[int, dict[str, str]] = {}
    found_nodes: set[str] = set()
    for match in NODE_BLOCK.finditer(text):
        block = match.group(0)
        names = re.findall(r"^\s*name:\s*(\S+)\s*$", block, re.M)
        if len(names) != 1 or names[0] in found_nodes:
            fail("corosync.conf has malformed or duplicate node blocks")
        name = names[0]
        found_nodes.add(name)
        node_rings: set[int] = set()
        for raw_ring, address in re.findall(r"^\s*ring(\d+)_addr:\s*(\S+)\s*$", block, re.M):
            ring = int(raw_ring)
            if ring < 0 or ring > 7 or ring in node_rings:
                fail(f"corosync.conf node {name} has an invalid or duplicate KNET ring")
            node_rings.add(ring)
            rings.setdefault(ring, {})[name] = address
        if not node_rings:
            fail(f"corosync.conf node {name} has no KNET ring address")
    if found_nodes != expected_nodes:
        fail("corosync.conf members do not exactly match /etc/pve/.members")
    for ring, addresses in rings.items():
        if set(addresses) != expected_nodes:
            fail(f"corosync.conf ring{ring} is not configured on every node")
    return int(versions[0]), rings


def parse_corosync_node_ids(text: str, expected_nodes: set[str]) -> dict[str, int]:
    result: dict[str, int] = {}
    seen_ids: set[int] = set()
    for match in NODE_BLOCK.finditer(text):
        block = match.group(0)
        names = re.findall(r"^\s*name:\s*(\S+)\s*$", block, re.M)
        values = re.findall(r"^\s*nodeid:\s*(\d+)\s*$", block, re.M)
        if len(names) != 1 or len(values) != 1:
            fail("corosync.conf node blocks must have one name and nodeid")
        node_id = int(values[0])
        if node_id <= 0 or node_id in seen_ids or names[0] in result:
            fail("corosync.conf has an invalid or duplicate nodeid")
        result[names[0]] = node_id
        seen_ids.add(node_id)
    if set(result) != expected_nodes:
        fail("corosync.conf node IDs do not exactly match PVE membership")
    return result


def address_matches(value: str, node: dict[str, Any], expected: str) -> bool:
    if value == node["name"]:
        return node["ip"] == expected
    try:
        return str(ipaddress.ip_address(value)) == expected
    except ValueError:
        fail(f"Corosync ring address {value!r} is neither an IP nor its PVE node name")


def addresses_equivalent(left: str, right: str, node: dict[str, Any]) -> bool:
    def normalize(value: str) -> str:
        if value == node["name"]:
            return node["ip"]
        try:
            return str(ipaddress.ip_address(value))
        except ValueError:
            fail(
                f"Corosync address {value!r} is neither an IP nor the expected "
                f"PVE node name {node['name']}"
            )

    return normalize(left) == normalize(right)


def set_config_version(text: str, version: int) -> str:
    matches = list(re.finditer(r"(?m)^(\s*config_version:\s*)\d+(\s*)$", text))
    if len(matches) != 1:
        fail("corosync.conf must contain exactly one config_version")
    match = matches[0]
    return text[: match.start()] + match.group(1) + str(version) + match.group(2) + text[match.end() :]


def replace_ring(text: str, ring: int, addresses: dict[str, str], version: int) -> str:
    seen: set[str] = set()

    def replace_block(match: re.Match[str]) -> str:
        block = match.group(0)
        names = re.findall(r"^\s*name:\s*(\S+)\s*$", block, re.M)
        if len(names) != 1 or names[0] not in addresses:
            return block
        name = names[0]
        pattern = re.compile(r"(?m)^(\s*ring%d_addr:\s*)\S+(\s*)$" % ring)
        if len(list(pattern.finditer(block))) != 1:
            fail(f"Corosync node {name} does not have exactly one ring{ring}_addr")
        seen.add(name)
        return pattern.sub(lambda item: item.group(1) + addresses[name] + item.group(2), block)

    candidate = NODE_BLOCK.sub(replace_block, text)
    if seen != set(addresses):
        fail("not every Corosync node ring could be replaced")
    return set_config_version(candidate, version)


def config_block_span(text: str, name: str) -> tuple[int, int]:
    matches = list(re.finditer(r"(?m)^\s*%s\s*\{" % re.escape(name), text))
    if len(matches) != 1:
        fail(f"corosync.conf must contain exactly one {name} block")
    opening = text.find("{", matches[0].start(), matches[0].end())
    depth = 0
    for index in range(opening, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return matches[0].start(), index + 1
    fail(f"corosync.conf has an unterminated {name} block")


def add_ring(
    text: str, ring: int, addresses: dict[str, str], version: int
) -> str:
    if ring < 0 or ring > 7:
        fail("Corosync KNET link number must be 0..7")
    cluster_names = re.findall(r"(?m)^\s*cluster_name:\s*(\S+)\s*$", text)
    if len(cluster_names) != 1:
        fail("corosync.conf has no unique cluster_name")
    _current_version, rings = parse_corosync(text, set(addresses), cluster_names[0])
    if ring in rings:
        fail(f"Corosync ring{ring} is already configured")

    seen = set()

    def add_node_address(match: re.Match[str]) -> str:
        block = match.group(0)
        names = re.findall(r"(?m)^\s*name:\s*(\S+)\s*$", block)
        if len(names) != 1 or names[0] not in addresses:
            return block
        name = names[0]
        ring_lines = list(re.finditer(r"(?m)^(\s*)ring\d+_addr:\s*\S+\s*$", block))
        if not ring_lines:
            fail(f"Corosync node {name} has no existing ring address")
        insertion = ring_lines[-1].end()
        indent = ring_lines[-1].group(1)
        seen.add(name)
        return (
            block[:insertion]
            + f"\n{indent}ring{ring}_addr: {addresses[name]}"
            + block[insertion:]
        )

    candidate = NODE_BLOCK.sub(add_node_address, text)
    if seen != set(addresses):
        fail("not every Corosync node received the temporary management ring")
    totem_start, totem_end = config_block_span(candidate, "totem")
    totem = candidate[totem_start:totem_end]
    interface_links = []
    for block in re.findall(r"(?ms)^\s*interface\s*\{.*?^\s*\}\s*$", totem):
        values = re.findall(r"(?m)^\s*linknumber:\s*(\d+)\s*$", block)
        if len(values) != 1:
            fail("Corosync interface block has no unique linknumber")
        interface_links.append(int(values[0]))
    if ring in interface_links:
        fail(f"Corosync interface linknumber {ring} already exists")
    closing_line = totem.rfind("}")
    closing_start = totem.rfind("\n", 0, closing_line) + 1
    closing_indent = re.match(r"\s*", totem[closing_start:closing_line]).group(0)
    child_indent = closing_indent + "    "
    interface = (
        f"{child_indent}interface {{\n"
        f"{child_indent}    linknumber: {ring}\n"
        f"{child_indent}}}\n"
    )
    totem = totem[:closing_start] + interface + totem[closing_start:]
    candidate = candidate[:totem_start] + totem + candidate[totem_end:]
    return set_config_version(candidate, version)


def remove_ring(text: str, ring: int, version: int) -> str:
    removed_nodes = set()

    def remove_node_address(match: re.Match[str]) -> str:
        block = match.group(0)
        names = re.findall(r"(?m)^\s*name:\s*(\S+)\s*$", block)
        if len(names) != 1:
            return block
        pattern = re.compile(r"(?m)^\s*ring%d_addr:\s*\S+\s*\n?" % ring)
        matches = list(pattern.finditer(block))
        if len(matches) != 1:
            fail(f"Corosync node {names[0]} does not have exactly one ring{ring}_addr")
        removed_nodes.add(names[0])
        return pattern.sub("", block, count=1)

    candidate = NODE_BLOCK.sub(remove_node_address, text)
    if not removed_nodes:
        fail(f"Corosync ring{ring} is absent")
    totem_start, totem_end = config_block_span(candidate, "totem")
    totem = candidate[totem_start:totem_end]
    interface_matches = []
    for match in re.finditer(r"(?ms)^\s*interface\s*\{.*?^\s*\}\s*\n?", totem):
        values = re.findall(r"(?m)^\s*linknumber:\s*(\d+)\s*$", match.group(0))
        if len(values) != 1:
            fail("Corosync interface block has no unique linknumber")
        if int(values[0]) == ring:
            interface_matches.append(match)
    if len(interface_matches) != 1:
        fail(f"Corosync ring{ring} has no unique interface block")
    match = interface_matches[0]
    totem = totem[:match.start()] + totem[match.end():]
    candidate = candidate[:totem_start] + totem + candidate[totem_end:]
    return set_config_version(candidate, version)


def runtime_link(report: dict[str, Any], ring: int) -> dict[str, Any] | None:
    links = report["corosync_runtime"]["links"]
    return links.get(ring) or links.get(str(ring))


def runtime_config_is_loaded(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    node: dict[str, Any],
    report: dict[str, Any],
    text: str,
) -> bool:
    expected_names = {item["name"] for item in nodes}
    version, rings = parse_corosync(text, expected_names, cluster_name)
    node_ids = parse_corosync_node_ids(text, expected_names)
    runtime = report["corosync_runtime"]
    config = runtime["config"]
    if (
        config.get("cluster_name") != cluster_name
        or config.get("config_version") != version
        or config.get("local_node_id") != node["id"]
        or set(config.get("nodes", {})) != expected_names
        or node_ids != {item["name"]: item["id"] for item in nodes}
    ):
        return False
    expected_ring_ids = {str(ring) for ring in rings}
    for item in nodes:
        row = config["nodes"].get(item["name"], {})
        if row.get("node_id") != item["id"] or set(row.get("rings", {})) != expected_ring_ids:
            return False
        for ring, addresses in rings.items():
            if not addresses_equivalent(
                row["rings"][str(ring)], addresses[item["name"]], item
            ):
                return False
    local_binds = config.get("bind_addresses", {})
    if set(local_binds) != expected_ring_ids:
        return False
    links = runtime.get("links", {})
    if {int(value) for value in links} != set(rings):
        return False
    for ring, addresses in rings.items():
        if not addresses_equivalent(
            local_binds[str(ring)], addresses[node["name"]], node
        ):
            return False
        link = runtime_link(report, ring)
        if not link or not addresses_equivalent(
            link.get("address", ""), addresses[node["name"]], node
        ):
            return False
    return True


def runtime_ring_is_full(
    nodes: list[dict[str, Any]], reports: list[dict[str, Any]], ring: int,
    addresses: dict[str, str],
) -> bool:
    expected_ids = sorted(node["id"] for node in nodes)
    for node, report in zip(nodes, reports):
        link = runtime_link(report, ring)
        if not link or link.get("connected_node_ids") != expected_ids:
            return False
        if not address_matches(link.get("address", ""), node, addresses[node["name"]]):
            return False
    return True


def runtime_matches_config(
    cluster_name: str, nodes: list[dict[str, Any]], reports: list[dict[str, Any]],
    text: str,
) -> bool:
    version, rings = parse_corosync(text, {node["name"] for node in nodes}, cluster_name)
    expected_ids = sorted(node["id"] for node in nodes)
    for node, report in zip(nodes, reports):
        if not runtime_config_is_loaded(cluster_name, nodes, node, report, text):
            return False
        members = report["corosync_runtime"]["config"].get("members", {})
        if set(members) != {str(value) for value in expected_ids}:
            return False
        for member in nodes:
            row = members[str(member["id"])]
            if (
                row.get("status") != "joined"
                or row.get("config_version") != version
                or {int(value) for value in row.get("rings", {})} != set(rings)
            ):
                return False
            for ring, addresses in rings.items():
                if not addresses_equivalent(
                    row["rings"][str(ring)], addresses[member["name"]], member
                ):
                    return False
    return all(
        runtime_ring_is_full(nodes, reports, ring, addresses)
        for ring, addresses in rings.items()
    )


def runtime_topology_matches_config(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    text: str,
) -> bool:
    _version, rings = parse_corosync(
        text, {node["name"] for node in nodes}, cluster_name
    )
    node_ids = parse_corosync_node_ids(text, {node["name"] for node in nodes})
    expected_ring_ids = {str(ring) for ring in rings}
    expected_ids = {node["name"]: node["id"] for node in nodes}
    if node_ids != expected_ids:
        return False
    for node, report in zip(nodes, reports):
        runtime = report["corosync_runtime"]
        config = runtime["config"]
        if (
            config.get("cluster_name") != cluster_name
            or config.get("local_node_id") != node["id"]
            or set(config.get("nodes", {})) != set(expected_ids)
            or {int(value) for value in runtime.get("links", {})} != set(rings)
        ):
            return False
        for item in nodes:
            row = config["nodes"].get(item["name"], {})
            if row.get("node_id") != item["id"] or set(row.get("rings", {})) != expected_ring_ids:
                return False
            for ring, addresses in rings.items():
                if not addresses_equivalent(
                    row["rings"][str(ring)], addresses[item["name"]], item
                ):
                    return False
        binds = config.get("bind_addresses", {})
        if set(binds) != expected_ring_ids:
            return False
        for ring, addresses in rings.items():
            if not addresses_equivalent(
                binds[str(ring)], addresses[node["name"]], node
            ):
                return False
        members = config.get("members", {})
        if set(members) != {str(item["id"]) for item in nodes}:
            return False
        for member in nodes:
            row = members[str(member["id"])]
            if row.get("status") != "joined" or set(row.get("rings", {})) != expected_ring_ids:
                return False
            for ring, addresses in rings.items():
                if not addresses_equivalent(
                    row["rings"][str(ring)], addresses[member["name"]], member
                ):
                    return False
    return all(
        runtime_ring_is_full(nodes, reports, ring, addresses)
        for ring, addresses in rings.items()
    )


def corosync_runtime_versions(reports: list[dict[str, Any]]) -> set[int]:
    versions = {
        report["corosync_runtime"]["config"]["config_version"]
        for report in reports
    }
    versions.update(
        member["config_version"]
        for report in reports
        for member in report["corosync_runtime"]["config"]["members"].values()
    )
    return versions


def corosync_runtime_target(
    cluster_name: str, nodes: list[dict[str, Any]], text: str
) -> dict[str, Any]:
    names = {node["name"] for node in nodes}
    version, rings = parse_corosync(text, names, cluster_name)
    node_ids = parse_corosync_node_ids(text, names)
    target_nodes = {
        node["name"]: {
            "node_id": node_ids[node["name"]],
            "rings": {
                str(ring): addresses[node["name"]]
                for ring, addresses in sorted(rings.items())
            },
        }
        for node in nodes
    }
    bind_addresses = {}
    for node in nodes:
        bind_addresses[node["name"]] = {}
        for ring, addresses in sorted(rings.items()):
            value = addresses[node["name"]]
            bind_addresses[node["name"]][str(ring)] = (
                node["ip"] if value == node["name"] else value
            )
    return {
        "cluster_name": cluster_name,
        "config_version": version,
        "nodes": target_nodes,
        "bind_addresses": bind_addresses,
    }


def corosync_restart_order(
    nodes: list[dict[str, Any]], coordinator: dict[str, Any]
) -> list[dict[str, Any]]:
    ordered = sorted(nodes, key=lambda item: (item["id"], item["name"]))
    return [node for node in ordered if node["name"] != coordinator["name"]] + [
        coordinator
    ]


def validate_corosync_node_count(count: int) -> None:
    if type(count) is not int or count < 3 or count % 2 == 0:
        fail("clustered PVN Corosync migration requires an odd PVE node count of at least 3")


def unused_corosync_ring(rings: dict[int, Any]) -> int:
    candidate = next((ring for ring in range(8) if ring not in rings), None)
    if candidate is None:
        fail("all eight Corosync KNET links are used; no safe transition ring remains")
    return candidate


def build_plan(
    cluster_name: str, nodes: list[dict[str, Any]], reports: list[dict[str, Any]], spec: dict[str, Any]
) -> dict[str, Any]:
    validate_corosync_node_count(len(nodes))
    corosync_package_versions = {
        report["corosync_package_version"] for report in reports
    }
    if len(corosync_package_versions) != 1:
        fail("PVE nodes do not run one exact Corosync package version")
    corosync_package_version = next(iter(corosync_package_versions))
    first_text = reports[0]["corosync_text"]
    first_sha = reports[0]["corosync_sha256"]
    for report in reports[1:]:
        if report["corosync_sha256"] != first_sha or report["corosync_text"] != first_text:
            fail("nodes do not expose one identical shared corosync.conf")
    version, rings = parse_corosync(first_text, {node["name"] for node in nodes}, cluster_name)

    geneve_by_node = {
        node["name"]: report["geneve"]["address"].split("/", 1)[0]
        for node, report in zip(nodes, reports)
    }
    management_by_node = {node["name"]: node["ip"] for node in nodes}
    provider_by_node = {
        node["name"]: report["provider"]["address"].split("/", 1)[0]
        for node, report in zip(nodes, reports)
    }
    geneve_rings = []
    management_rings = []
    for ring, addresses in rings.items():
        provider_matches = []
        for node in nodes:
            value = addresses.get(node["name"])
            provider_matches.append(
                value is not None
                and address_matches(value, node, provider_by_node[node["name"]])
            )
        if any(provider_matches):
            fail(
                f"Corosync ring{ring} uses a provider NIC; refusing to remove its L3 configuration"
            )
        matches = []
        for node in nodes:
            value = addresses.get(node["name"])
            matches.append(value is not None and address_matches(value, node, geneve_by_node[node["name"]]))
        if any(matches):
            if not all(matches):
                fail(f"Corosync ring{ring} only partially uses the Geneve NICs")
            geneve_rings.append(ring)
        management_matches = []
        for node in nodes:
            value = addresses.get(node["name"])
            management_matches.append(
                value is not None
                and address_matches(value, node, management_by_node[node["name"]])
            )
        if any(management_matches):
            if not all(management_matches):
                fail(f"Corosync ring{ring} only partially uses the management NICs")
            management_rings.append(ring)
    if len(geneve_rings) > 1:
        fail("multiple Corosync rings use Geneve; refusing to collapse redundant links")
    if len(management_rings) > 1:
        fail("multiple Corosync rings use management; refusing an ambiguous migration")

    corosync = None
    stages: list[dict[str, Any]] = []
    if geneve_rings and not management_rings:
        geneve_ring = geneve_rings[0]
        unused = unused_corosync_ring(rings)
        dual = add_ring(first_text, unused, management_by_node, version + 1)
        final = remove_ring(dual, geneve_ring, version + 2)
        dual_rollback = remove_ring(dual, unused, version + 2)
        stages = [
            {
                "name": "dual",
                "candidate": dual,
                "bridge_ring": geneve_ring,
                "bridge_addresses": geneve_by_node,
                "rollback": dual_rollback,
                "rollback_bridge_ring": geneve_ring,
                "rollback_bridge_addresses": geneve_by_node,
            },
            {
                "name": "final",
                "candidate": final,
                "bridge_ring": unused,
                "bridge_addresses": management_by_node,
                "rollback": set_config_version(dual, version + 3),
                "rollback_bridge_ring": unused,
                "rollback_bridge_addresses": management_by_node,
            },
        ]
    elif geneve_rings and management_rings:
        geneve_ring = geneve_rings[0]
        management_ring = management_rings[0]
        if not runtime_ring_is_full(
            nodes, reports, geneve_ring, geneve_by_node
        ):
            fail("saved dual-ring Corosync state has no fully connected Geneve safety ring")
        final = remove_ring(first_text, geneve_ring, version + 1)
        stages = [
            {
                "name": "dual",
                "candidate": first_text,
                "bridge_ring": geneve_ring,
                "bridge_addresses": geneve_by_node,
                "rollback": None,
            },
            {
                "name": "final",
                "candidate": final,
                "bridge_ring": management_ring,
                "bridge_addresses": management_by_node,
                "rollback": set_config_version(first_text, version + 2),
                "rollback_bridge_ring": management_ring,
                "rollback_bridge_addresses": management_by_node,
            },
        ]
    elif management_rings:
        management_ring = management_rings[0]
        if runtime_matches_config(cluster_name, nodes, reports, first_text):
            stages = []
        elif runtime_ring_is_full(
            nodes, reports, management_ring, management_by_node
        ):
            # A crash after the final shared write can leave some daemons on
            # the dual config.  The already-full management ring is the safe
            # bridge while those nodes are restarted one at a time.
            stages = [
                {
                    "name": "final",
                    "candidate": first_text,
                    "bridge_ring": management_ring,
                    "bridge_addresses": management_by_node,
                    "rollback": None,
                }
            ]
        elif runtime_ring_is_full(
            nodes, reports, management_ring, geneve_by_node
        ):
            # v0.2.13 could persist a direct address replacement while every
            # daemon still ran the old Geneve ring.  Reconstruct that old
            # topology only in memory, add management on a new KNET link,
            # and persist the resulting dual candidate in one write.
            recovery_base = replace_ring(
                first_text, management_ring, geneve_by_node, version + 1
            )
            if not runtime_topology_matches_config(
                cluster_name, nodes, reports, recovery_base
            ):
                fail("persisted-final/runtime-stale Corosync state is not uniform")
            runtime_versions = corosync_runtime_versions(reports)
            if (
                version == 0
                or runtime_versions != {version - 1}
            ):
                fail("stale Corosync runtime config versions are not one older safe boundary")
            recovery_rings = parse_corosync(
                recovery_base, {node["name"] for node in nodes}, cluster_name
            )[1]
            unused = unused_corosync_ring(recovery_rings)
            # Persist only the dual candidate: ringY remains the already-live
            # Geneve safety ring while unused ringX adds management.  Never
            # publish/reload an intermediate single-ring address replacement.
            dual = add_ring(recovery_base, unused, management_by_node, version + 1)
            final = remove_ring(dual, management_ring, version + 2)
            stages = [
                {
                    "name": "dual",
                    "candidate": dual,
                    "bridge_ring": management_ring,
                    "bridge_addresses": geneve_by_node,
                    "stale_runtime_topology": recovery_base,
                    "stale_runtime_version": version - 1,
                    "rollback": None,
                },
                {
                    "name": "final",
                    "candidate": final,
                    "bridge_ring": unused,
                    "bridge_addresses": management_by_node,
                    "rollback": set_config_version(dual, version + 3),
                    "rollback_bridge_ring": unused,
                    "rollback_bridge_addresses": management_by_node,
                },
            ]
        else:
            fail(
                "persisted Corosync management config and runtime have no common "
                "fully connected safety ring"
            )
    elif not runtime_matches_config(cluster_name, nodes, reports, first_text):
        fail("persisted and runtime Corosync state differ outside a PVN migration")

    if stages:
        from_sha256 = first_sha
        from_text = first_text
        for stage in stages:
            stage["from_sha256"] = from_sha256
            stage["from"] = from_text
            stage["candidate_sha256"] = digest_text(stage["candidate"])
            if stage.get("rollback") is not None:
                stage["rollback_sha256"] = digest_text(stage["rollback"])
            from_sha256 = stage["candidate_sha256"]
            from_text = stage["candidate"]
        corosync = {
            "original": first_text,
            "original_sha256": first_sha,
            "stages": stages,
        }

    # A device's max_mtu is only a driver/hardware ceiling.  It says nothing
    # about the configured OpenStack path and is commonly 65535 on virtio.
    # Never raise a NIC above the live MTU that the provider already supplied.
    for report in reports:
        for role in ("geneve", "provider"):
            value = report[role]
            configured = value.get("configured_mtu")
            restorable = min(value["mtu"], value["max_mtu"])
            if configured is not None and configured > restorable:
                fail(
                    f"configured MTU {configured} on {report['node']} {role} NIC "
                    f"{value['interface']} exceeds its live-restorable MTU {restorable}; "
                    "normalize the original PVE interface MTU before apply"
                )
    effective = min(value[role]["mtu"] for value in reports for role in ("geneve", "provider"))
    requested_effective = spec.get("effective_underlay_mtu")
    if requested_effective is not None and requested_effective != effective:
        fail(
            f"effective underlay MTU changed from {requested_effective} to {effective} "
            "after preflight"
        )
    ceiling = effective - 100
    default_guest = (ceiling // 100) * 100
    if default_guest < 1280:
        fail(f"effective underlay MTU {effective} cannot support a safe overlay guest MTU")
    return {
        "corosync": corosync,
        "corosync_package_version": corosync_package_version,
        "effective_underlay_mtu": effective,
        "guest_mtu_ceiling": ceiling,
        "default_guest_mtu": default_guest,
    }


def topology_ledger_base(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    spec: dict[str, Any],
) -> dict[str, Any]:
    membership = {
        "cluster_name": cluster_name,
        "nodes": [
            {
                "name": node["name"],
                "node_id": node["id"],
                "management_ip": node["ip"],
            }
            for node in nodes
        ],
    }
    return {
        "schema": 1,
        "phase": "complete",
        "cluster_name": cluster_name,
        "membership_snapshot": membership,
        "membership_hash": digest_text(canonical_json(membership)),
        "nodes": [
            {
                "name": node["name"],
                "node_id": node["id"],
                "management_ip": node["ip"],
                "control_ip": node["ip"],
                "geneve_ip": report["geneve"]["address"].split("/", 1)[0],
                "geneve_interface": report["geneve"]["interface"],
                "provider_interface": report["provider"]["interface"],
            }
            for node, report in zip(nodes, reports)
        ],
        "guest_mtu": spec["guest_mtu"],
        "effective_underlay_mtu": spec["effective_underlay_mtu"],
        "provider_bridge": "br-provider",
        "physnet": "provider",
        "provider_readiness": {
            "operator_ack": True,
            "ack_phrase": PROVIDER_ACK,
            "live_arbitrary_mac_l2_verified": False,
            "basis": "operator-ack-only",
        },
    }


def topology_corosync_pin(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
) -> dict[str, Any]:
    text = reports[0]["corosync_text"]
    sha256 = reports[0]["corosync_sha256"]
    if any(
        report["corosync_text"] != text
        or report["corosync_sha256"] != sha256
        for report in reports[1:]
    ):
        fail("active nodes do not expose one identical shared corosync.conf")
    if not runtime_matches_config(cluster_name, nodes, reports, text):
        fail("active Corosync persisted/runtime state is not exact")
    version, rings = parse_corosync(
        text, {node["name"] for node in nodes}, cluster_name
    )
    management = {node["name"]: node["ip"] for node in nodes}
    geneve = {
        node["name"]: report["geneve"]["address"].split("/", 1)[0]
        for node, report in zip(nodes, reports)
    }
    provider = {
        node["name"]: report["provider"]["address"].split("/", 1)[0]
        for node, report in zip(nodes, reports)
    }
    management_rings = 0
    for ring, addresses in rings.items():
        for label, expected in (("Geneve", geneve), ("provider", provider)):
            matches = [
                address_matches(addresses[node["name"]], node, expected[node["name"]])
                for node in nodes
            ]
            if any(matches):
                fail(f"active Corosync ring{ring} still uses a {label} NIC")
        matches = [
            address_matches(
                addresses[node["name"]], node, management[node["name"]]
            )
            for node in nodes
        ]
        if any(matches) and not all(matches):
            fail(f"active Corosync ring{ring} only partially uses management")
        if all(matches):
            management_rings += 1
    if management_rings != 1:
        fail("active Corosync must have exactly one management ring")
    return {
        "sha256": sha256,
        "config_version": version,
        "rings": {
            str(ring): dict(sorted(addresses.items()))
            for ring, addresses in sorted(rings.items())
        },
    }


def report_ledger_upgrade_proof_sha256(report: dict[str, Any]) -> str:
    proof = {key: report.get(key) for key in LEDGER_UPGRADE_PROOF_KEYS}
    return digest_text(canonical_json(proof))


def active_journal_bridge_exact(
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    corosync: dict[str, Any],
) -> bool:
    if len(nodes) != len(reports) or corosync.get("sha256") is None:
        return False
    for node, report in zip(nodes, reports):
        journal = report.get("journal")
        if (
            not isinstance(journal, dict)
            or journal.get("schema") != 1
            or journal.get("phase") != "complete"
            or journal.get("transaction") != transaction
            or journal.get("spec") != spec
            or journal.get("node") != node["name"]
            or journal.get("before_corosync_sha256") != corosync["sha256"]
            or report.get("corosync_sha256") != corosync["sha256"]
            or journal.get("desired_interfaces_sha256")
            != report.get("interfaces_sha256")
            or report.get("pending_interfaces_sha256") is not None
            or report.get("network_state") != "desired"
        ):
            return False
    return True


def validate_active_control_ledger(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    membership_guard: dict[str, Any],
    topology_schema: int,
    corosync: dict[str, Any],
    journal_bridge_exact: bool,
    candidate_corosync_exact: bool,
    expected_legacy: dict[str, Any],
    legacy_sha256: str,
    candidate_sha256: str,
) -> dict[str, Any]:
    states = {
        (report.get("control_ledger_sha256"), report.get("control_ledger_text"))
        for report in reports
    }
    if len(states) != 1:
        fail("active nodes do not expose one identical control-plane ledger")
    _sha256, text = next(iter(states))
    if text is None:
        fail("active PVN has no shared control-plane ledger")
    try:
        ledger = json.loads(text)
    except json.JSONDecodeError as exc:
        fail(f"active control-plane ledger is invalid: {exc}")
    required = {
        "version", "cluster_uuid", "snapshot", "phase", "central_complete",
        "nodes_complete", "cert_fingerprints", "control_db_cluster_id",
        "db_cluster_ids",
    }
    count = len(nodes)
    if (
        not isinstance(ledger, dict)
        or set(ledger) != required
        or ledger.get("version") != 1
        or not canonical_uuid(ledger.get("cluster_uuid"))
        or ledger.get("phase") != "complete"
        or ledger.get("central_complete") != count
        or ledger.get("nodes_complete") != count
    ):
        fail("active control-plane ledger is not at its exact complete N/N boundary")
    fingerprints = ledger.get("cert_fingerprints")
    node_fingerprints = fingerprints.get("nodes") if isinstance(fingerprints, dict) else None
    if (
        not isinstance(fingerprints, dict)
        or set(fingerprints) != {"ca_certificate_sha256", "nodes"}
        or not isinstance(fingerprints.get("ca_certificate_sha256"), str)
        or not SHA256.fullmatch(fingerprints["ca_certificate_sha256"])
        or not isinstance(node_fingerprints, dict)
        or set(node_fingerprints) != {node["name"] for node in nodes}
    ):
        fail("active control-plane certificate pins are incomplete")
    for pins in node_fingerprints.values():
        if (
            not isinstance(pins, dict)
            or set(pins) != {"certificate_sha256", "public_key_sha256"}
            or any(not isinstance(value, str) or not SHA256.fullmatch(value) for value in pins.values())
        ):
            fail("active control-plane certificate pins are malformed")
    control_id = ledger.get("control_db_cluster_id")
    db_ids = ledger.get("db_cluster_ids")
    expected_dbs = {"PVN_Control", "OVN_Northbound", "OVN_Southbound"}
    if (
        not canonical_uuid(control_id)
        or not isinstance(db_ids, dict)
        or set(db_ids) != expected_dbs
        or db_ids.get("PVN_Control") != control_id
        or any(not canonical_uuid(value) for value in db_ids.values())
    ):
        fail("active control-plane database identities are incomplete")
    snapshot = ledger.get("snapshot")
    snapshot_keys = {
        "mode", "confirmation", "cluster_name", "members_version",
        "cluster_version", "topology_sha256", "guest_mtu", "physnet", "nodes",
    }
    if not isinstance(snapshot, dict) or set(snapshot) != snapshot_keys:
        fail("active control-plane snapshot is missing")
    live_cluster_version = membership_guard.get("cluster_version")
    pinned_cluster_version = snapshot.get("cluster_version")
    legacy_version_bridge = (
        topology_schema in {1, 2}
        and snapshot.get("topology_sha256") == legacy_sha256
        and type(pinned_cluster_version) is int
        and pinned_cluster_version >= 0
        and type(live_cluster_version) is int
        and live_cluster_version == pinned_cluster_version + 1
        and corosync.get("config_version") == live_cluster_version
        and journal_bridge_exact
        and candidate_corosync_exact
    )
    if (
        membership_guard.get("mode") != "cluster"
        or snapshot.get("mode") != "raft"
        or snapshot.get("confirmation") != cluster_name
        or snapshot.get("cluster_name") != cluster_name
        or type(snapshot.get("members_version")) is not int
        or snapshot["members_version"] < 0
        or (
            pinned_cluster_version != live_cluster_version
            and not legacy_version_bridge
        )
        or snapshot.get("guest_mtu") != expected_legacy["guest_mtu"]
        or snapshot.get("physnet") != expected_legacy["physnet"]
    ):
        fail("active control-plane snapshot differs from the topology identity")
    if snapshot.get("topology_sha256") not in {legacy_sha256, candidate_sha256}:
        fail("active control-plane snapshot does not pin the legacy/candidate topology")
    snapshot_nodes = snapshot.get("nodes")
    expected_rows = {row["name"]: row for row in expected_legacy["nodes"]}
    node_keys = {
        "name", "node_id", "control_ip", "geneve_ip", "geneve_interface",
        "provider_interface", "provider_bridge", "package_version", "geneve_mtu",
    }
    if (
        not isinstance(snapshot_nodes, list)
        or len(snapshot_nodes) != count
        or any(not isinstance(row, dict) for row in snapshot_nodes)
        or any(set(row) != node_keys for row in snapshot_nodes)
        or {row.get("name") for row in snapshot_nodes} != set(expected_rows)
        or [row.get("name") for row in snapshot_nodes]
        != [node["name"] for node in nodes]
    ):
        fail("active control-plane snapshot node set is not N/N")
    package_versions = set()
    for row in snapshot_nodes:
        expected = expected_rows[row["name"]]
        if (
            row.get("node_id") != expected["node_id"]
            or row.get("control_ip") != expected["control_ip"]
            or row.get("geneve_ip") != expected["geneve_ip"]
            or row.get("geneve_interface") != expected["geneve_interface"]
            or row.get("provider_interface") != expected["provider_interface"]
            or row.get("provider_bridge") != expected_legacy["provider_bridge"]
            or type(row.get("geneve_mtu")) is not int
            or row["geneve_mtu"] < expected_legacy["guest_mtu"] + 100
            or not isinstance(row.get("package_version"), str)
            or not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,200}", row["package_version"])
        ):
            fail(f"active control-plane snapshot node {row.get('name')} drifted")
        package_versions.add(row["package_version"])
    if len(package_versions) != 1:
        fail("active control-plane snapshot package versions are not uniform")
    return {
        "topology_pin": (
            "legacy"
            if snapshot["topology_sha256"] == legacy_sha256
            else "candidate"
        ),
        "package_version": next(iter(package_versions)),
        "db_cluster_ids": dict(db_ids),
        "legacy_cluster_version_bridge": legacy_version_bridge,
    }


def debian_version_greater(candidate: str, pinned: str) -> bool:
    compared = run_bounded_process(
        ["/usr/bin/dpkg", "--compare-versions", candidate, "gt", pinned],
        "", 10, 64 * 1024,
    )
    if compared.returncode not in {0, 1}:
        detail = compared.stderr.strip().replace("\n", "; ")
        fail(f"cannot compare pvn-node package versions: {detail[:500]}")
    return compared.returncode == 0


ACTIVE_DATABASE_PORTS = {
    "PVN_Control": 6646,
    "OVN_Northbound": 6643,
    "OVN_Southbound": 6644,
}


def active_upgrade_readiness_issues(
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    topology_schema: int,
    control_state: dict[str, Any],
) -> list[str]:
    issues: list[str] = []
    readiness = [report["active_readiness"] for report in reports]
    observed_rows: dict[str, list[tuple[dict[str, Any], dict[str, Any]]]] = {
        database: [] for database in ACTIVE_DATABASE_PORTS
    }
    live_versions = {item["package_version"] for item in readiness}
    live_version = next(iter(live_versions)) if len(live_versions) == 1 else None
    if live_version is None:
        issues.append("installed pvn-node versions are not uniform across every node")

    for node, item in zip(nodes, readiness):
        if item["doctor"] is not True:
            issues.append(f"fresh pvnctl doctor failed on {node['name']}")
        status = item["central_status"]
        if (
            item["central_status_ok"] is not True
            or not isinstance(status, dict)
            or set(status) != {"healthy", "databases"}
            or status.get("healthy") is not True
        ):
            issues.append(f"fresh pvnctl central status is unhealthy on {node['name']}")
            continue
        rows = status.get("databases")
        if (
            not isinstance(rows, list)
            or len(rows) != len(ACTIVE_DATABASE_PORTS)
            or any(not isinstance(row, dict) for row in rows)
        ):
            issues.append(f"central status does not contain three database rows on {node['name']}")
            continue
        names = [row.get("database") for row in rows]
        if len(set(names)) != len(names) or set(names) != set(ACTIVE_DATABASE_PORTS):
            issues.append(f"central status database names drifted on {node['name']}")
            continue
        by_name = {row["database"]: row for row in rows}
        for database, port in ACTIVE_DATABASE_PORTS.items():
            row = by_name[database]
            observed_rows[database].append((node, row))
            required = {
                "database", "name", "available", "healthy", "cluster_id",
                "server_id", "address", "member_count", "connected_members",
                "quorum_size", "membership_change", "membership_status",
                "role", "term", "leader",
            }
            if not required.issubset(row):
                issues.append(
                    f"{database} status is incomplete on {node['name']}"
                )
                continue
            count = len(nodes)
            if (
                row.get("database") != database
                or row.get("name") != database
                or row.get("available") is not True
                or row.get("healthy") is not True
                or row.get("membership_change") is not False
                or row.get("membership_status") != "cluster member"
                or row.get("role") not in {"leader", "follower"}
                or type(row.get("term")) is not int
                or row["term"] <= 0
                or not isinstance(row.get("leader"), str)
                or row["leader"] in {"", "unknown"}
                or type(row.get("member_count")) is not int
                or row["member_count"] != count
                or type(row.get("connected_members")) is not int
                or row["connected_members"] != count
                or type(row.get("quorum_size")) is not int
                or row["quorum_size"] != count // 2 + 1
                or row.get("cluster_id")
                != control_state["db_cluster_ids"][database]
                or not canonical_uuid(row.get("server_id"))
                or row.get("address") != f"ssl:{node['ip']}:{port}"
            ):
                issues.append(
                    f"{database} is not exact healthy {count}/{count} on {node['name']}"
                )

    for database, rows in observed_rows.items():
        if len(rows) != len(nodes):
            continue
        server_ids = [row.get("server_id") for _node, row in rows]
        if all(canonical_uuid(value) for value in server_ids) and \
                len(set(server_ids)) != len(nodes):
            issues.append(f"{database} repeats a Raft server ID across nodes")
        terms = [row.get("term") for _node, row in rows]
        if all(type(term) is int and term > 0 for term in terms) and len(set(terms)) != 1:
            issues.append(f"{database} voters do not report one identical Raft term")
        leaders = [(node, row) for node, row in rows if row.get("role") == "leader"]
        followers = [(node, row) for node, row in rows if row.get("role") == "follower"]
        if len(leaders) != 1 or len(followers) != len(nodes) - 1:
            issues.append(f"{database} does not have exactly one leader and N-1 followers")
            continue
        leader_node, leader_row = leaders[0]
        leader_server_id = leader_row.get("server_id")
        if not canonical_uuid(leader_server_id) or leader_row.get("leader") != "self":
            issues.append(f"{database} leader identity is inconsistent on {leader_node['name']}")
            continue
        leader_nickname = leader_server_id[:4]
        for follower_node, follower_row in followers:
            if follower_row.get("leader") != leader_nickname:
                issues.append(
                    f"{database} follower {follower_node['name']} reports a different leader"
                )

    pinned_version = control_state["package_version"]
    topology_pin = control_state["topology_pin"]
    markers = [item["central_restart_pending"] for item in readiness]
    markers_pending = live_version is not None and all(
        marker == live_version for marker in markers
    )
    markers_consumed = all(marker is None for marker in markers)
    live_is_newer = (
        live_version is not None
        and debian_version_greater(live_version, pinned_version)
    )
    if topology_schema == 1:
        if topology_pin != "legacy":
            issues.append("schema 1 topology is not pinned as the legacy control snapshot")
        if not live_is_newer:
            issues.append("installed pvn-node is not uniformly newer than the control snapshot")
        if not markers_pending:
            issues.append("every central restart marker must pin the installed newer package")
    elif live_is_newer:
        if not markers_pending:
            issues.append("schema 2 package rollout requires every central restart marker")
    elif live_version == pinned_version:
        if topology_pin != "candidate":
            issues.append("equal-package schema 2 requires the candidate control snapshot pin")
        if not (markers_pending or markers_consumed):
            issues.append("post-repin restart markers are neither all pending nor all consumed")
    else:
        issues.append("schema 2 installed package is mixed, older, or unrelated to its control pin")
    return issues


def build_active_ledger_upgrade_plan(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    reports: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    topology_plan: dict[str, Any],
    membership_guard: dict[str, Any],
) -> dict[str, Any]:
    if any(activation_report_mode(report.get("activation")) != "active" for report in reports):
        fail("ledger-only upgrade requires exact active PVN state on every node")
    if topology_plan.get("corosync") is not None:
        fail("active PVN requires Corosync migration; deactivate it before topology repair")
    expected_package = topology_plan["corosync_package_version"]
    if {report["corosync_package_version"] for report in reports} != {expected_package}:
        fail("active Corosync package versions are not one exact value")
    corosync = topology_corosync_pin(cluster_name, nodes, reports)
    for node, report in zip(nodes, reports):
        journal = report.get("journal")
        if not isinstance(journal, dict):
            fail(f"active node {node['name']} has no topology journal")
        if (
            journal.get("schema") != 1
            or journal.get("phase") != "complete"
            or journal.get("transaction") != transaction
            or journal.get("spec") != spec
            or journal.get("node") != node["name"]
            or journal.get("effective_underlay_mtu") != spec["effective_underlay_mtu"]
            or journal.get("management") != report["management"]
            or journal.get("geneve") != report["geneve"]
            or journal.get("provider") != report["provider"]
            or journal.get("before_corosync_sha256") != report["corosync_sha256"]
            or journal.get("desired_interfaces_sha256") != report["interfaces_sha256"]
            or report.get("pending_interfaces_sha256") is not None
            or report.get("network_state") != "desired"
        ):
            fail(f"active node {node['name']} is not at its exact completed topology boundary")
        before = journal.get("before_interfaces_sha256")
        if not isinstance(before, str) or not SHA256.fullmatch(before):
            fail(f"active node {node['name']} has an invalid topology journal hash")

    ledger_states = {
        (report.get("ledger_sha256"), report.get("ledger_text"))
        for report in reports
    }
    if len(ledger_states) != 1:
        fail("active nodes do not expose one identical shared topology ledger")
    previous_sha256, previous_text = next(iter(ledger_states))
    if previous_sha256 is None or previous_text is None:
        fail("active PVN has no shared topology ledger")
    try:
        previous = json.loads(previous_text)
    except json.JSONDecodeError as exc:
        fail(f"active shared topology ledger is invalid: {exc}")
    expected_legacy = topology_ledger_base(cluster_name, nodes, reports, spec)
    legacy_text = json.dumps(expected_legacy, sort_keys=True, indent=2) + "\n"
    legacy_sha256 = digest_text(legacy_text)
    schema = previous.get("schema") if isinstance(previous, dict) else None
    if schema == 1:
        if previous != expected_legacy or previous_text != legacy_text:
            fail("schema 1 topology ledger is not the exact canonical legacy file")
        candidate = copy.deepcopy(previous)
        candidate["schema"] = 2
        candidate["corosync"] = corosync
        upgrade_required = True
    elif schema == 2:
        projection = copy.deepcopy(previous)
        pinned = projection.pop("corosync", None)
        projection["schema"] = 1
        if projection != expected_legacy or pinned != corosync:
            fail("schema 2 topology ledger does not exactly pin the live topology")
        candidate = previous
        upgrade_required = False
    else:
        fail("active topology ledger must be schema 1 or schema 2")
    candidate_text = json.dumps(candidate, sort_keys=True, indent=2) + "\n"
    candidate_sha256 = digest_text(candidate_text)
    if not upgrade_required and (
        previous_text != candidate_text or previous_sha256 != candidate_sha256
    ):
        fail("schema 2 topology ledger is not the exact canonical candidate")
    journal_bridge_exact = active_journal_bridge_exact(
        nodes, reports, spec, transaction, corosync,
    )
    control_state = validate_active_control_ledger(
        cluster_name, nodes, reports, membership_guard, schema, corosync,
        journal_bridge_exact, candidate.get("corosync") == corosync,
        expected_legacy, legacy_sha256, candidate_sha256,
    )
    prerequisite_errors = active_upgrade_readiness_issues(
        nodes, reports, schema, control_state,
    )
    return {
        "upgrade_required": upgrade_required,
        "previous_text": previous_text,
        "previous_sha256": previous_sha256,
        "candidate_text": candidate_text,
        "candidate_sha256": candidate_sha256,
        "corosync": corosync,
        "legacy_cluster_version_bridge": control_state[
            "legacy_cluster_version_bridge"
        ],
        "prerequisite_errors": prerequisite_errors,
        "proofs": {
            report["node"]: report_ledger_upgrade_proof_sha256(report)
            for report in reports
        },
    }


def probe_all(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    membership_snapshot: dict[str, Any],
) -> list[dict[str, Any]]:
    reports = []
    for node in nodes:
        print(f"[{node['name']}] read-only topology probe")
        request = common_request(
            node, cluster_name, nodes, spec, transaction, membership_snapshot
        )
        response = ssh_request(node, "probe", request)
        reports.append(validate_report(response.get("report"), node, spec))
    return reports


def print_plan(
    cluster_name: str, nodes: list[dict[str, Any]], reports: list[dict[str, Any]], plan: dict[str, Any], guest_mtu: int
) -> None:
    print(f"PVN topology plan for cluster {cluster_name} ({len(nodes)} online nodes)")
    for node, report in zip(nodes, reports):
        print(
            f"  {node['name']}: management={node['ip']} "
            f"geneve={report['geneve']['interface']}:{report['geneve']['address']} "
            f"provider={report['provider']['interface']}:{report['provider']['address']} "
            f"live-mtu={min(report['geneve']['mtu'], report['provider']['mtu'])} "
            f"hardware-max-mtu={min(report['geneve']['max_mtu'], report['provider']['max_mtu'])} "
            f"state={report['network_state']}"
        )
    if plan["corosync"]:
        stages = plan["corosync"]["stages"]
        names = " -> ".join(stage["name"] for stage in stages)
        print(
            "  Corosync: " + names
            + " (add management ring, verify all runtimes, remove Geneve ring)"
        )
    else:
        print("  Corosync: already independent of the Geneve NICs")
    print(
        f"  effective-underlay-mtu={plan['effective_underlay_mtu']} "
        f"guest-mtu={guest_mtu} ceiling={plan['guest_mtu_ceiling']}"
    )


def apply_active_ledger_upgrade(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    membership_guard: dict[str, Any],
    initial_upgrade: dict[str, Any],
) -> None:
    assert_membership_unchanged(
        membership_guard, "before active ledger-only verification"
    )
    reports = probe_all(
        cluster_name, nodes, spec, transaction, membership_guard
    )
    topology_plan = build_plan(cluster_name, nodes, reports, spec)
    upgrade = build_active_ledger_upgrade_plan(
        cluster_name, nodes, reports, spec, transaction, topology_plan,
        membership_guard,
    )
    if upgrade["prerequisite_errors"]:
        fail(
            "active topology ledger upgrade prerequisites are not ready: "
            + "; ".join(upgrade["prerequisite_errors"])
        )
    if (
        upgrade["candidate_sha256"] != initial_upgrade["candidate_sha256"]
        or upgrade["previous_sha256"] != initial_upgrade["previous_sha256"]
    ):
        fail("active topology or ledger changed between its two exact sweeps")
    if not upgrade["upgrade_required"]:
        print("Active PVN topology ledger is already the exact schema 2 candidate; no-op.")
        return

    coordinator = nodes[0]
    request = common_request(
        coordinator, cluster_name, nodes, spec, transaction, membership_guard
    )
    request.update({
        "ledger_upgrade_only": True,
        "ledger": upgrade["candidate_text"],
        "ledger_sha256": upgrade["candidate_sha256"],
        "expected_ledger_sha256": upgrade["previous_sha256"],
        "upgrade_proof_sha256": upgrade["proofs"][coordinator["name"]],
    })
    print(
        f"[{coordinator['name']}] CAS-publish schema 2 topology ledger only; "
        "network, Corosync, journals, services, and markers remain untouched"
    )
    assert_membership_unchanged(
        membership_guard, "before active topology ledger CAS"
    )
    write_error: TopologyError | None = None
    try:
        ssh_request(coordinator, "write-ledger", request)
    except TopologyError as exc:
        write_error = exc

    try:
        post_reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_guard
        )
        post_topology = build_plan(cluster_name, nodes, post_reports, spec)
        post = build_active_ledger_upgrade_plan(
            cluster_name, nodes, post_reports, spec, transaction, post_topology,
            membership_guard,
        )
        if post["prerequisite_errors"]:
            fail(
                "active topology ledger post-CAS prerequisites are not ready: "
                + "; ".join(post["prerequisite_errors"])
            )
    except TopologyError as post_error:
        fail(
            f"active ledger CAS outcome requires a resumable exact-state recheck: "
            f"{post_error}; no network, Corosync, journal, service, or marker rollback was attempted"
        )
    if (
        not post["upgrade_required"]
        and post["candidate_sha256"] == upgrade["candidate_sha256"]
        and post["previous_sha256"] == upgrade["candidate_sha256"]
    ):
        print(
            f"PVN active topology ledger upgraded and verified on all {len(nodes)} nodes."
        )
        return
    if write_error is not None and post["previous_sha256"] == upgrade["previous_sha256"]:
        raise write_error
    fail(
        "active ledger CAS did not reach the exact candidate; the observed ledger was "
        "preserved and no other state was mutated"
    )


def acquire_lock():
    if not LOCK_FILE.is_absolute():
        fail("PVN_TOPOLOGY_LOCK_FILE must be absolute")
    LOCK_FILE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(LOCK_FILE, flags, 0o600)
    os.fchmod(fd, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        fail("another pvn-topology apply is running on this node")
    return fd


def acquire_global_lock(cluster_name: str, node_name: str, transaction: str) -> str:
    lease_path = Path(LEASE_BIN)
    if not lease_path.is_absolute():
        fail("PVN_TOPOLOGY_LEASE_BIN must be an absolute path")
    try:
        lease_info = lease_path.lstat()
    except OSError as exc:
        fail(f"cannot inspect cluster lease helper {lease_path}: {exc}")
    if stat.S_ISLNK(lease_info.st_mode) or not stat.S_ISREG(lease_info.st_mode):
        fail(f"cluster lease helper must be a regular non-symlink file: {lease_path}")
    if lease_info.st_uid != 0 or lease_info.st_mode & 0o022:
        fail("cluster lease helper must be root-owned and not group/world writable")
    if not lease_info.st_mode & 0o111 or not os.access(lease_path, os.X_OK):
        fail(f"cluster lease helper is not executable: {lease_path}")
    token = secrets.token_hex(24)
    owner = {
        "cluster": cluster_name,
        "domain": LEASE_DOMAIN,
        "node": node_name,
        "pid": os.getpid(),
        "started": int(time.time()),
        "transaction": transaction,
        "token": token,
    }
    try:
        result = subprocess.run(
            [LEASE_BIN, "acquire", LEASE_DOMAIN, token],
            input=canonical_json(owner) + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"cluster-global topology lease helper failed: {exc}")
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().replace("\n", "; ")
        fail(
            f"could not acquire cluster-global topology lease: {detail[:800]}; "
            f"inspect it with '{LEASE_BIN} show {LEASE_DOMAIN}' and release it only if stale"
        )
    return token


def release_global_lock(token: str) -> None:
    try:
        result = subprocess.run(
            [LEASE_BIN, "release", LEASE_DOMAIN, token],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"cluster-global topology lease helper failed during release: {exc}")
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().replace("\n", "; ")
        fail(f"refusing to release cluster-global topology lease: {detail[:800]}")


def wait_cluster_verification(
    nodes: list[dict[str, Any]], base_requests: dict[str, dict[str, Any]], verification: dict[str, Any], seconds: int = 60
) -> None:
    deadline = time.monotonic() + seconds
    last_error = "verification did not run"
    while time.monotonic() < deadline:
        try:
            for node in nodes:
                request = dict(base_requests[node["name"]])
                request.update(verification)
                ssh_request(node, "verify-cluster", request, timeout=30)
            return
        except TopologyError as exc:
            last_error = str(exc)
            time.sleep(2)
    fail(last_error)


def require_shared_corosync_hash(
    reports: list[dict[str, Any]], expected_sha256: str
) -> None:
    hashes = {report["corosync_sha256"] for report in reports}
    if hashes != {expected_sha256}:
        fail("nodes do not expose the expected shared corosync.conf")


def require_corosync_package_version(
    reports: list[dict[str, Any]], expected_version: str
) -> None:
    versions = {report["corosync_package_version"] for report in reports}
    if versions != {expected_version}:
        fail("Corosync package versions differ from the pinned cluster version")


def persist_corosync_text(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    membership_guard: dict[str, Any],
    base: dict[str, dict[str, Any]],
    corosync_package_version: str,
    from_sha256: str,
    from_text: str,
    candidate: str,
    candidate_sha256: str,
    bridge_ring: int,
    bridge_addresses: dict[str, str],
    stale_runtime_topology: str | None = None,
    stale_runtime_version: int | None = None,
    allow_partial_from: bool = False,
) -> list[dict[str, Any]]:
    reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
    require_corosync_package_version(reports, corosync_package_version)
    current_hashes = {report["corosync_sha256"] for report in reports}
    if current_hashes == {candidate_sha256}:
        return reports
    if current_hashes != {from_sha256}:
        fail("shared corosync.conf drifted from the pinned stage boundary")
    if not runtime_ring_is_full(
        nodes, reports, bridge_ring, bridge_addresses
    ):
        fail("Corosync safety ring is not N/N immediately before config CAS")
    if stale_runtime_topology is not None:
        if (
            stale_runtime_version is None
            or not runtime_topology_matches_config(
                cluster_name, nodes, reports, stale_runtime_topology
            )
            or corosync_runtime_versions(reports) != {stale_runtime_version}
        ):
            fail("stale v0.2.13 Corosync recovery boundary changed before config CAS")
    elif not allow_partial_from and not runtime_matches_config(
        cluster_name, nodes, reports, from_text
    ):
        fail("Corosync from-boundary runtime drifted before config CAS")
    coordinator = nodes[0]
    if stale_runtime_topology is not None:
        boundary_mode = "stale-v0.2.13"
        boundary_target = corosync_runtime_target(
            cluster_name, nodes, stale_runtime_topology
        )
        boundary_target["config_version"] = stale_runtime_version
    elif allow_partial_from:
        boundary_mode = "partial-rollback"
        boundary_target = None
    else:
        boundary_mode = "exact"
        boundary_target = corosync_runtime_target(
            cluster_name, nodes, from_text
        )
    request = dict(base[coordinator["name"]])
    request.update({
        "expected_sha256": from_sha256,
        "candidate": candidate,
        "candidate_sha256": candidate_sha256,
        "corosync_package_version": corosync_package_version,
        "bridge_ring": bridge_ring,
        "bridge_addresses": bridge_addresses,
        "runtime_boundary_mode": boundary_mode,
        "runtime_boundary_target": boundary_target,
    })
    write_error = None
    try:
        assert_membership_unchanged(
            membership_guard, "before shared Corosync config write"
        )
        ssh_request(coordinator, "apply-corosync", request)
    except TopologyError as exc:
        write_error = exc
    reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
    require_corosync_package_version(reports, corosync_package_version)
    if {report["corosync_sha256"] for report in reports} == {candidate_sha256}:
        return reports
    if write_error is not None:
        raise write_error
    fail("shared Corosync candidate did not persist on every node")


def converge_corosync_runtime(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    membership_guard: dict[str, Any],
    base: dict[str, dict[str, Any]],
    corosync_package_version: str,
    candidate: str,
    candidate_sha256: str,
    bridge_ring: int,
    bridge_addresses: dict[str, str],
    initial_reports: list[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    coordinator = nodes[0]
    target = corosync_runtime_target(cluster_name, nodes, candidate)
    reports = initial_reports
    if reports is None:
        reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_guard
        )
    require_corosync_package_version(reports, corosync_package_version)
    require_shared_corosync_hash(reports, candidate_sha256)
    if runtime_matches_config(cluster_name, nodes, reports, candidate):
        return reports
    if not runtime_ring_is_full(
        nodes, reports, bridge_ring, bridge_addresses
    ):
        fail("Corosync safety ring is not fully connected before runtime convergence")

    reload_request = dict(base[coordinator["name"]])
    reload_request.update({
        "expected_sha256": candidate_sha256,
        "bridge_ring": bridge_ring,
        "bridge_addresses": bridge_addresses,
        "corosync_package_version": corosync_package_version,
    })
    try:
        ssh_request(coordinator, "reload-corosync", reload_request, timeout=45)
    except TopologyError:
        # A cluster-wide reload response can be lost.  The exact runtime
        # sweep below decides whether it applied and which nodes still need
        # a guarded restart.
        pass

    for _attempt in range(COROSYNC_SETTLE_ATTEMPTS):
        reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
        require_corosync_package_version(reports, corosync_package_version)
        require_shared_corosync_hash(reports, candidate_sha256)
        if runtime_matches_config(cluster_name, nodes, reports, candidate):
            return reports
        if not runtime_ring_is_full(
            nodes, reports, bridge_ring, bridge_addresses
        ):
            fail("Corosync safety ring lost full connectivity after runtime reload")
        if not TEST_FAST:
            time.sleep(1)

    ordered = corosync_restart_order(nodes, coordinator)
    loaded = {
        node["name"]: runtime_config_is_loaded(
            cluster_name, nodes, node, report, candidate
        )
        for node, report in zip(nodes, reports)
    }
    restart_candidates = [
        node for node in ordered if not loaded[node["name"]]
    ]
    restarted: set[str] = set()
    for node in restart_candidates:
        if node["name"] in restarted:
            continue
        reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
        require_corosync_package_version(reports, corosync_package_version)
        require_shared_corosync_hash(reports, candidate_sha256)
        if runtime_matches_config(cluster_name, nodes, reports, candidate):
            return reports
        if not runtime_ring_is_full(
            nodes, reports, bridge_ring, bridge_addresses
        ):
            fail(
                f"Corosync safety ring is not N/N before restarting {node['name']}"
            )
        request = dict(base[node["name"]])
        request.update({
            "expected_sha256": candidate_sha256,
            "bridge_ring": bridge_ring,
            "bridge_addresses": bridge_addresses,
            "runtime_target": target,
            "corosync_package_version": corosync_package_version,
        })
        print(
            f"[{node['name']}] restart Corosync over fully connected "
            f"safety ring{bridge_ring}"
        )
        restart_error = None
        try:
            ssh_request(node, "restart-corosync", request, timeout=120)
        except TopologyError as exc:
            restart_error = exc
        restarted.add(node["name"])
        reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
        require_corosync_package_version(reports, corosync_package_version)
        require_shared_corosync_hash(reports, candidate_sha256)
        local_report = next(
            report for report in reports if report["node"] == node["name"]
        )
        if not (
            runtime_config_is_loaded(
                cluster_name, nodes, node, local_report, candidate
            )
            and runtime_ring_is_full(
                nodes, reports, bridge_ring, bridge_addresses
            )
        ):
            if restart_error is not None:
                raise restart_error
            fail(f"{node['name']} did not safely rejoin on the persisted Corosync target")

    last_reports = reports
    for _attempt in range(COROSYNC_FINAL_ATTEMPTS):
        last_reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_guard
        )
        require_corosync_package_version(last_reports, corosync_package_version)
        require_shared_corosync_hash(last_reports, candidate_sha256)
        if runtime_matches_config(cluster_name, nodes, last_reports, candidate):
            return last_reports
        if not runtime_ring_is_full(
            nodes, last_reports, bridge_ring, bridge_addresses
        ):
            fail("Corosync safety ring lost full connectivity during final convergence")
        if COROSYNC_POLL_SECONDS:
            time.sleep(COROSYNC_POLL_SECONDS)
    fail("Corosync runtime did not exactly converge to the persisted configuration")


def apply_topology(
    cluster_name: str,
    nodes: list[dict[str, Any]],
    spec: dict[str, Any],
    transaction: str,
    reports: list[dict[str, Any]],
    plan: dict[str, Any],
    membership_guard: dict[str, Any],
) -> None:
    base = {
        node["name"]: common_request(
            node, cluster_name, nodes, spec, transaction, membership_guard
        )
        for node in nodes
    }
    for node, report in zip(nodes, reports):
        assert_membership_unchanged(membership_guard, "before journal preparation")
        request = dict(base[node["name"]])
        request["expected"] = {
            "interfaces_sha256": report["interfaces_sha256"],
            "corosync_sha256": report["corosync_sha256"],
        }
        print(f"[{node['name']}] create/verify root:0600 journal and immutable backups")
        ssh_request(node, "prepare", request)

    migration = plan["corosync"]
    if migration:
        validation_candidates: dict[str, str] = {}
        for stage in migration["stages"]:
            validation_candidates[stage["candidate_sha256"]] = stage["candidate"]
            if stage.get("rollback") is not None:
                validation_candidates[stage["rollback_sha256"]] = stage["rollback"]
        for node in nodes:
            for candidate_sha256, candidate in validation_candidates.items():
                request = dict(base[node["name"]])
                request.update({
                    "expected_sha256": migration["original_sha256"],
                    "candidate": candidate,
                    "candidate_sha256": candidate_sha256,
                })
                ssh_request(node, "validate-corosync", request)

        for stage in migration["stages"]:
            print(
                f"[cluster] Corosync {stage['name']} stage over "
                f"safety ring{stage['bridge_ring']}"
            )
            try:
                stage_reports = persist_corosync_text(
                    cluster_name, nodes, spec, transaction, membership_guard,
                    base, plan["corosync_package_version"],
                    stage["from_sha256"], stage["from"],
                    stage["candidate"], stage["candidate_sha256"],
                    stage["bridge_ring"], stage["bridge_addresses"],
                    stage.get("stale_runtime_topology"),
                    stage.get("stale_runtime_version"),
                )
                converge_corosync_runtime(
                    cluster_name, nodes, spec, transaction, membership_guard,
                    base, plan["corosync_package_version"],
                    stage["candidate"], stage["candidate_sha256"],
                    stage["bridge_ring"], stage["bridge_addresses"],
                    initial_reports=stage_reports,
                )
            except TopologyError as migration_error:
                rollback = stage.get("rollback")
                if rollback is None:
                    fail(
                        f"{migration_error}; Corosync remains on a resumable "
                        f"{stage['name']} boundary and no network changes were made"
                    )
                try:
                    current_reports = probe_all(
                        cluster_name, nodes, spec, transaction, membership_guard
                    )
                    current_hashes = {
                        report["corosync_sha256"] for report in current_reports
                    }
                    if current_hashes == {stage["candidate_sha256"]}:
                        rollback_reports = persist_corosync_text(
                            cluster_name, nodes, spec, transaction,
                            membership_guard, base,
                            plan["corosync_package_version"],
                            stage["candidate_sha256"], stage["candidate"],
                            rollback, stage["rollback_sha256"],
                            stage["rollback_bridge_ring"],
                            stage["rollback_bridge_addresses"],
                            allow_partial_from=True,
                        )
                        converge_corosync_runtime(
                            cluster_name, nodes, spec, transaction,
                            membership_guard, base,
                            plan["corosync_package_version"], rollback,
                            stage["rollback_sha256"],
                            stage["rollback_bridge_ring"],
                            stage["rollback_bridge_addresses"],
                            initial_reports=rollback_reports,
                        )
                    elif current_hashes == {stage["from_sha256"]}:
                        if not runtime_matches_config(
                            cluster_name, nodes, current_reports, stage["from"]
                        ):
                            fail(
                                "pinned pre-stage Corosync config is present but "
                                "its runtime is not exact"
                            )
                    else:
                        fail(
                            "shared Corosync state drifted outside the pinned "
                            "pre-stage/candidate rollback boundaries"
                        )
                except TopologyError as rollback_error:
                    fail(
                        f"{migration_error}; Corosync safety rollback also failed: "
                        f"{rollback_error}"
                    )
                fail(
                    f"{migration_error}; Corosync was restored to a fully connected "
                    "safety boundary before network changes"
                )

            if stage["name"] in ("dual", "final"):
                phase = (
                    "corosync-dual-runtime"
                    if stage["name"] == "dual"
                    else "corosync-final-runtime"
                )
                for node in nodes:
                    request = dict(base[node["name"]])
                    request["phase"] = phase
                    ssh_request(node, "record-phase", request)
        for node in nodes:
            request = dict(base[node["name"]])
            request["phase"] = "corosync-migrated"
            ssh_request(node, "record-phase", request)

    reports = probe_all(cluster_name, nodes, spec, transaction, membership_guard)
    require_corosync_package_version(
        reports, plan["corosync_package_version"]
    )
    final_corosync_text = reports[0]["corosync_text"]
    final_corosync_sha256 = reports[0]["corosync_sha256"]
    if any(
        report["corosync_text"] != final_corosync_text
        or report["corosync_sha256"] != final_corosync_sha256
        for report in reports[1:]
    ):
        fail("shared Corosync config drifted before network mutation")
    if not runtime_matches_config(
        cluster_name, nodes, reports, final_corosync_text
    ):
        fail("Corosync persisted/runtime state is not exact before network mutation")
    final_corosync_version, final_corosync_rings = parse_corosync(
        final_corosync_text, {node["name"] for node in nodes}, cluster_name
    )
    final_geneve_addresses = {
        node["name"]: report["geneve"]["address"].split("/", 1)[0]
        for node, report in zip(nodes, reports)
    }
    final_management_addresses = {node["name"]: node["ip"] for node in nodes}
    management_ring_count = 0
    for ring, addresses in final_corosync_rings.items():
        if all(
            address_matches(
                addresses[node["name"]], node,
                final_geneve_addresses[node["name"]],
            )
            for node in nodes
        ):
            fail(f"Corosync ring{ring} still uses Geneve before network mutation")
        if all(
            address_matches(
                addresses[node["name"]], node,
                final_management_addresses[node["name"]],
            )
            for node in nodes
        ):
            management_ring_count += 1
    if migration is not None and management_ring_count != 1:
        fail("Corosync migration did not leave exactly one management ring")
    final_corosync_ledger = {
        "sha256": final_corosync_sha256,
        "config_version": final_corosync_version,
        "rings": {
            str(ring): dict(sorted(addresses.items()))
            for ring, addresses in sorted(final_corosync_rings.items())
        },
    }
    requests: dict[str, dict[str, Any]] = {}
    for node, report in zip(nodes, reports):
        request = dict(base[node["name"]])
        request.update({
            "geneve": report["geneve"],
            "provider": report["provider"],
            "effective_underlay_mtu": plan["effective_underlay_mtu"],
        })
        requests[node["name"]] = request

    prepared_nodes = list(nodes)
    rollback_nodes: list[dict[str, Any]] = [
        node
        for node, report in zip(nodes, reports)
        if report["network_state"] == "desired" and report.get("journal_phase") != "complete"
    ]
    ledger_write_attempted = False
    ledger_restore_node = None
    ledger_restore_request = None

    def unwind_network(error: TopologyError) -> None:
        rollback_errors = []
        rollback_names = {node["name"] for node in rollback_nodes}
        for changed_node in reversed(rollback_nodes):
            try:
                print(f"[{changed_node['name']}] rollback transaction-owned network state")
                ssh_request(
                    changed_node, "rollback-network", requests[changed_node["name"]], timeout=150
                )
            except TopologyError as rollback_error:
                rollback_errors.append(f"{changed_node['name']}: {rollback_error}")
        for prepared_node in reversed(prepared_nodes):
            if prepared_node["name"] in rollback_names:
                continue
            try:
                print(f"[{prepared_node['name']}] discard transaction-owned pending network state")
                ssh_request(
                    prepared_node, "discard-stage", requests[prepared_node["name"]]
                )
            except TopologyError as discard_error:
                rollback_errors.append(f"{prepared_node['name']} pending: {discard_error}")
        if rollback_errors:
            fail(f"{error}; transaction rollback was incomplete: {'; '.join(rollback_errors)}")
        fail(f"{error}; all transaction-owned network changes were rolled back")

    try:
        for node, report in zip(nodes, reports):
            if report["network_state"] == "desired":
                continue
            assert_membership_unchanged(membership_guard, "before network staging")
            print(f"[{node['name']}] stage and validate PVE network API candidate")
            ssh_request(node, "stage-network", requests[node["name"]])

        for index, node in enumerate(nodes):
            report = reports[index]
            request = requests[node["name"]]
            if report["network_state"] == "desired":
                print(f"[{node['name']}] exact network state already present; no-op")
                continue
            if node["name"] not in {item["name"] for item in rollback_nodes}:
                # Include the current node before apply: a lost SSH response can
                # mean the atomic rename happened even though the caller saw a failure.
                rollback_nodes.append(node)
            assert_membership_unchanged(membership_guard, "before network apply")
            print(f"[{node['name']}] atomically apply staged network and run ifreload")
            ssh_request(node, "apply-network", request, timeout=150)
            verify_request = dict(request)
            verify_request["geneve_peers"] = [
                other["geneve"]["address"].split("/", 1)[0]
                for other in reports if other["node"] != node["name"]
            ]
            ssh_request(node, "verify-network", verify_request, timeout=60)
        final_reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_guard
        )
        require_corosync_package_version(
            final_reports, plan["corosync_package_version"]
        )
        incomplete = [report["node"] for report in final_reports if report["network_state"] != "desired"]
        if incomplete:
            fail("final exact-state sweep failed on: " + ", ".join(incomplete))
        if any(
            report["corosync_sha256"] != final_corosync_sha256
            or report["corosync_text"] != final_corosync_text
            for report in final_reports
        ) or not runtime_matches_config(
            cluster_name, nodes, final_reports, final_corosync_text
        ):
            fail("Corosync drifted before topology ledger publication")

        existing_ledger_states = {
            (report.get("ledger_sha256"), report.get("ledger_text"))
            for report in final_reports
        }
        if len(existing_ledger_states) != 1:
            fail("nodes do not expose one identical shared topology ledger state")
        previous_ledger_sha, previous_ledger_text = next(iter(existing_ledger_states))
        ledger = topology_ledger_base(
            cluster_name, nodes, final_reports, spec
        )
        ledger["schema"] = 2
        ledger["corosync"] = final_corosync_ledger
        ledger_text = json.dumps(ledger, sort_keys=True, indent=2) + "\n"
        ledger_sha = digest_text(ledger_text)
        coordinator = nodes[0]
        ledger_request = dict(base[coordinator["name"]])
        ledger_request.update({
            "ledger": ledger_text,
            "ledger_sha256": ledger_sha,
            "expected_ledger_sha256": previous_ledger_sha,
        })
        ledger_restore_node = coordinator
        ledger_restore_request = dict(base[coordinator["name"]])
        ledger_restore_request.update({
            "original_ledger": previous_ledger_text,
            "original_ledger_sha256": previous_ledger_sha,
            "failed_ledger_sha256": ledger_sha,
        })
        print(f"[{coordinator['name']}] atomically publish root-private shared topology ledger")
        assert_membership_unchanged(membership_guard, "before final ledger publication")
        ledger_write_attempted = True
        ssh_request(coordinator, "write-ledger", ledger_request)
        for node in nodes:
            verify_request = dict(base[node["name"]])
            verify_request["ledger_sha256"] = ledger_sha
            ssh_request(node, "verify-ledger", verify_request)
        for node in nodes:
            request = dict(base[node["name"]])
            request["phase"] = "complete"
            ssh_request(node, "record-phase", request)
    except TopologyError as topology_error:
        if ledger_write_attempted and ledger_restore_node and ledger_restore_request:
            try:
                ssh_request(ledger_restore_node, "restore-ledger", ledger_restore_request)
            except TopologyError as ledger_error:
                topology_error = TopologyError(
                    f"{topology_error}; shared ledger rollback also failed: {ledger_error}"
                )
        unwind_network(topology_error)
    print(f"PVN topology applied and verified on all {len(nodes)} nodes in cluster {cluster_name}.")
    print("PVN activation markers and central/node targets remain untouched and inactive.")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Plan (default) or apply the inert PVN three-NIC topology.",
    )
    parser.add_argument("operation", nargs="?", choices=("plan", "apply"), default="plan")
    parser.add_argument("--geneve-cidr", required=True, help="dedicated Geneve IPv4 network")
    parser.add_argument("--provider-cidr", required=True, help="provider-uplink IPv4 network")
    parser.add_argument("--guest-mtu", type=int, help="guest MTU; defaults to floor((underlay-100)/100)*100")
    parser.add_argument(
        "--provider-port-ready", metavar="PHRASE",
        help=f"exact operator acknowledgement phrase: {PROVIDER_ACK}",
    )
    parser.add_argument("--confirm", help="exact PVE cluster name required for apply")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if os.geteuid() != 0:
        fail("must run as root on a PVE cluster node")
    geneve = parse_cidr(args.geneve_cidr, "--geneve-cidr")
    provider = parse_cidr(args.provider_cidr, "--provider-cidr")
    if geneve.overlaps(provider):
        fail("Geneve and provider CIDRs must not overlap")
    cluster_name, local_name, nodes, membership_snapshot = discover_members()
    if args.operation == "apply":
        if args.provider_port_ready != PROVIDER_ACK:
            fail(f"apply requires --provider-port-ready {PROVIDER_ACK}")
        if args.confirm != cluster_name:
            fail(f"apply requires exact --confirm {cluster_name}")
    elif args.provider_port_ready or args.confirm is not None:
        fail("--provider-port-ready and --confirm are apply-only")
    validate_ssh_files(nodes)

    spec = {
        "cluster_name": cluster_name,
        "geneve_cidr": str(geneve),
        "provider_cidr": str(provider),
    }
    transaction = digest_text(canonical_json(spec))[:24]
    lock_fd = None
    global_lock_token = None
    if args.operation == "apply":
        lock_fd = acquire_lock()
        try:
            global_lock_token = acquire_global_lock(cluster_name, local_name, transaction)
        except Exception:
            os.close(lock_fd)
            lock_fd = None
            raise
    try:
        assert_membership_unchanged(membership_snapshot, "before topology probing")
        reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_snapshot
        )
        activation_modes = {
            activation_report_mode(report.get("activation")) for report in reports
        }
        if len(activation_modes) != 1:
            fail("PVN activation is not uniform across every PVE node")
        activation_mode = next(iter(activation_modes))
        plan = build_plan(cluster_name, nodes, reports, spec)
        spec["effective_underlay_mtu"] = plan["effective_underlay_mtu"]
        guest_mtu = args.guest_mtu if args.guest_mtu is not None else plan["default_guest_mtu"]
        if guest_mtu < 1280 or guest_mtu > plan["guest_mtu_ceiling"]:
            fail(
                f"guest MTU must be 1280..{plan['guest_mtu_ceiling']} for effective underlay "
                f"MTU {plan['effective_underlay_mtu']}"
            )
        spec["guest_mtu"] = guest_mtu
        print_plan(cluster_name, nodes, reports, plan, guest_mtu)
        active_upgrade = None
        if activation_mode == "active":
            active_upgrade = build_active_ledger_upgrade_plan(
                cluster_name, nodes, reports, spec, transaction, plan,
                membership_snapshot,
            )
            state = "required" if active_upgrade["upgrade_required"] else "already complete"
            print(
                "  Active PVN: schema 1 -> schema 2 ledger-only upgrade " + state
            )
            print(
                "  Mutations allowed: one shared topology-ledger CAS only; "
                "network, Corosync, journals, services, and markers stay untouched"
            )
            if active_upgrade["prerequisite_errors"]:
                print("  Upgrade readiness: NOT READY")
                for error in active_upgrade["prerequisite_errors"]:
                    print(f"    - {error}")
            else:
                print("  Upgrade readiness: READY (package, restart marker, doctor, and Raft N/N)")
            if active_upgrade["legacy_cluster_version_bridge"]:
                print(
                    "  Recovery bridge: control snapshot cluster_version is exactly one "
                    "behind the journal-proven live Corosync version"
                )
        elif activation_mode != "inactive":
            fail("PVN activation state is neither uniformly inactive nor active")
        if args.operation == "plan":
            print("Read-only plan complete; no journal, backup, pending config, or network change was created.")
            if activation_mode == "inactive":
                print("WARNING: this plan cannot live-test arbitrary inner MAC/IP forwarding on the outer OpenStack port.")
                print(
                    f"Apply only after independent provider-port verification: {PROGRAM} apply ... "
                    f"--provider-port-ready {PROVIDER_ACK} --confirm {cluster_name}"
                )
            return 0
        if activation_mode == "active":
            apply_active_ledger_upgrade(
                cluster_name, nodes, spec, transaction,
                membership_snapshot, active_upgrade,
            )
            return 0
        # Re-probe with the final transaction/spec so existing journals are
        # accepted only for the exact guest-MTU-aware request.
        assert_membership_unchanged(membership_snapshot, "before topology mutation")
        reports = probe_all(
            cluster_name, nodes, spec, transaction, membership_snapshot
        )
        if any(
            activation_report_mode(report.get("activation")) != "inactive"
            for report in reports
        ):
            fail("normal topology apply requires every PVN node to remain inactive")
        plan = build_plan(cluster_name, nodes, reports, spec)
        apply_topology(
            cluster_name, nodes, spec, transaction, reports, plan, membership_snapshot
        )
        return 0
    finally:
        if global_lock_token is not None:
            try:
                release_global_lock(global_lock_token)
            except TopologyError as exc:
                print(f"{PROGRAM}: warning: {exc}", file=sys.stderr)
        if lock_fd is not None:
            os.close(lock_fd)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except TopologyError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        raise SystemExit(1)
