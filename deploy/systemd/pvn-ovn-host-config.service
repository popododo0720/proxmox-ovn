[Unit]
Description=Configure node-local OVS settings for PVN
Documentation=file:/usr/share/doc/pvn-node/operations.md
Requires=openvswitch-switch.service pve-cluster.service
After=openvswitch-switch.service pve-cluster.service network-online.target
Before=ovn-controller.service pvn-agent.service
PartOf=pvn-node.target
ConditionPathExists=/etc/pvn/node-enabled
ConditionPathExists=/etc/pve/pvn/config.json

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pvn/node.env
EnvironmentFile=/etc/pvn/ovn-host.env
ExecStartPre=/usr/lib/pvn/pvn-ovn-host-preflight
ExecStart=/usr/sbin/pvnctl node configure-ovn --config /etc/pve/pvn/config.json
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/openvswitch /var/run/openvswitch
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=pvn-node.target
