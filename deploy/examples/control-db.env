# Written to /etc/pvn/central/control-db.env on selected central voters.
PVN_CONTROL_MODE=raft
PVN_CONTROL_LISTEN=10.0.0.11
PVN_CONTROL_PORT=6645
PVN_CONTROL_DB_FILE=/var/lib/pvn/control-db/pvn_control.db
PVN_CONTROL_TLS_CA=/etc/pvn/pki/ca.pem
PVN_CONTROL_TLS_CERT=/etc/pvn/pki/node.pem
PVN_CONTROL_TLS_KEY=/etc/pvn/pki/node-key.pem
