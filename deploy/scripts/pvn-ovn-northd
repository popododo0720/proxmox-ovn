#!/usr/bin/python3
"""Start and verify ovn-northd against every configured PVN DB endpoint."""

from __future__ import annotations

import ipaddress
import json
import os
import pathlib
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from typing import Any


MAX_CONFIG_BYTES = 1024 * 1024
MAX_MARKER_BYTES = 256
MAX_COMMAND_OUTPUT = 64 * 1024
COMMAND_TIMEOUT_SECONDS = 10
WAIT_SECONDS = 120
WAIT_INTERVAL_SECONDS = 1
MAX_ENDPOINTS = 31
MAX_CFG = (1 << 63) - 1

CONFIG = pathlib.Path(
    os.environ.get("PVN_NORTHD_CONFIG", "/etc/pve/pvn/config.json")
)
OVN_CTL = os.environ.get(
    "PVN_NORTHD_OVN_CTL", "/usr/share/ovn/scripts/ovn-ctl"
)
OVN_APPCTL = os.environ.get("PVN_NORTHD_OVN_APPCTL", "/usr/bin/ovn-appctl")
OVN_NBCTL = os.environ.get("PVN_NORTHD_OVN_NBCTL", "/usr/bin/ovn-nbctl")
OVN_SBCTL = os.environ.get("PVN_NORTHD_OVN_SBCTL", "/usr/bin/ovn-sbctl")
SYSTEMCTL = os.environ.get("PVN_NORTHD_SYSTEMCTL", "/usr/bin/systemctl")
DPKG_QUERY = os.environ.get("PVN_NORTHD_DPKG_QUERY", "/usr/bin/dpkg-query")
RESTART_STATE_DIRECTORY = pathlib.Path(
    os.environ.get("PVN_NORTHD_RESTART_STATE_DIR", "/var/lib/pvn-node")
)
RESTART_MARKER = RESTART_STATE_DIRECTORY / "central-restart-pending"
NORTHD_DB_PARAMS = pathlib.Path(
    os.environ.get(
        "PVN_NORTHD_DB_PARAMS", "/etc/ovn/ovn-northd-db-params.conf"
    )
)


class NorthdError(RuntimeError):
    pass


class FatalNorthdError(NorthdError):
    pass


def fail(message: str) -> "NoReturn":
    raise NorthdError(message)


def fatal(message: str) -> "NoReturn":
    raise FatalNorthdError(message)


def duplicate_safe_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            fail(f"duplicate JSON key in {CONFIG}: {key}")
        result[key] = value
    return result


def safe_regular_file(
    path: pathlib.Path,
    label: str,
    *,
    size_limit: int | None = None,
) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        fail(f"cannot inspect {label} {path}: {error}")
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        fail(f"{label} must be a regular non-symlink file: {path}")
    if metadata.st_nlink != 1:
        fail(f"{label} must have exactly one hard link: {path}")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        fail(f"{label} must be root-owned and not group/world writable: {path}")
    if size_limit is not None and metadata.st_size > size_limit:
        fail(f"{label} exceeds {size_limit} bytes: {path}")
    return metadata


def read_config() -> dict[str, Any]:
    before = safe_regular_file(CONFIG, "PVN configuration", size_limit=MAX_CONFIG_BYTES)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(CONFIG, flags)
    except OSError as error:
        fail(f"cannot open PVN configuration {CONFIG}: {error}")
    try:
        opened = os.fstat(descriptor)
        identity = (before.st_dev, before.st_ino)
        if (
            (opened.st_dev, opened.st_ino) != identity
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_nlink != 1
            or opened.st_uid != 0
            or opened.st_mode & 0o022
        ):
            fail(f"PVN configuration changed identity or safety metadata: {CONFIG}")
        chunks: list[bytes] = []
        size = 0
        while True:
            chunk = os.read(descriptor, min(65536, MAX_CONFIG_BYTES + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > MAX_CONFIG_BYTES:
                fail(f"PVN configuration exceeds {MAX_CONFIG_BYTES} bytes: {CONFIG}")
        after = CONFIG.lstat()
        if (
            (after.st_dev, after.st_ino) != identity
            or stat.S_ISLNK(after.st_mode)
            or not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or after.st_uid != 0
            or after.st_mode & 0o022
        ):
            fail(f"PVN configuration changed while being read: {CONFIG}")
    except OSError as error:
        fail(f"cannot read PVN configuration {CONFIG}: {error}")
    finally:
        os.close(descriptor)
    try:
        value = json.loads(
            b"".join(chunks).decode("utf-8"),
            object_pairs_hook=duplicate_safe_object,
        )
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"cannot parse PVN configuration {CONFIG}: {error}")
    if not isinstance(value, dict):
        fail("PVN configuration root must be an object")
    return value


def tls_path(value: Any, label: str) -> pathlib.Path:
    if not isinstance(value, str) or not value or "\x00" in value or "\n" in value:
        fail(f"ovn.{label} must be a non-empty absolute path")
    path = pathlib.Path(value)
    if not path.is_absolute() or path != pathlib.Path(os.path.normpath(value)):
        fail(f"ovn.{label} must be a normalized absolute path")
    safe_regular_file(path, f"ovn.{label}")
    return path


def endpoint_list(value: Any, label: str, expected_port: int) -> tuple[str, ...]:
    if not isinstance(value, list):
        fail(f"ovn.{label} must be an endpoint array")
    count = len(value)
    if count != 1 and (count < 3 or count > MAX_ENDPOINTS or count % 2 == 0):
        fail(f"ovn.{label} must contain one standalone or 3..{MAX_ENDPOINTS} odd Raft endpoints")
    result: list[str] = []
    seen: set[str] = set()
    pattern = re.compile(r"ssl:([^,:]+):([0-9]+)")
    for index, raw in enumerate(value):
        if not isinstance(raw, str):
            fail(f"ovn.{label}[{index}] must be a TLS endpoint string")
        match = pattern.fullmatch(raw)
        if match is None:
            fail(f"ovn.{label}[{index}] must use ssl:canonical-IPv4:{expected_port}")
        host, raw_port = match.groups()
        try:
            address = ipaddress.IPv4Address(host)
        except ipaddress.AddressValueError:
            fail(f"ovn.{label}[{index}] must use canonical IPv4")
        if (
            str(address) != host
            or address.is_unspecified
            or address.is_multicast
            or address.is_loopback
        ):
            fail(f"ovn.{label}[{index}] contains an unusable or non-canonical IPv4 address")
        if raw_port != str(expected_port):
            fail(f"ovn.{label}[{index}] must use TLS port {expected_port}")
        if raw in seen:
            fail(f"ovn.{label} contains a duplicate endpoint: {raw}")
        seen.add(raw)
        result.append(raw)
    return tuple(result)


@dataclass(frozen=True)
class Connections:
    northbound: tuple[str, ...]
    southbound: tuple[str, ...]
    ca: pathlib.Path
    cert: pathlib.Path
    key: pathlib.Path

    @property
    def northbound_db(self) -> str:
        return ",".join(self.northbound)

    @property
    def southbound_db(self) -> str:
        return ",".join(self.southbound)

    @property
    def tls_options(self) -> tuple[str, ...]:
        return (
            f"--private-key={self.key}",
            f"--certificate={self.cert}",
            f"--ca-cert={self.ca}",
            "--ssl-protocols=TLSv1.2,TLSv1.3",
        )


def connections() -> Connections:
    config = read_config()
    ovn = config.get("ovn")
    expected = {
        "control_db",
        "northbound",
        "southbound",
        "tls_ca",
        "tls_cert",
        "tls_key",
    }
    if not isinstance(ovn, dict) or set(ovn) != expected:
        fail("ovn configuration must contain exactly control_db, northbound, southbound, tls_ca, tls_cert, and tls_key")
    control = endpoint_list(ovn.get("control_db"), "control_db", 6645)
    northbound = endpoint_list(ovn.get("northbound"), "northbound", 6641)
    southbound = endpoint_list(ovn.get("southbound"), "southbound", 6642)
    if len(control) != len(northbound) or len(northbound) != len(southbound):
        fail("ovn.control_db, ovn.northbound, and ovn.southbound endpoint counts differ")
    control_hosts = tuple(item.removeprefix("ssl:").rsplit(":", 1)[0] for item in control)
    northbound_hosts = tuple(item.removeprefix("ssl:").rsplit(":", 1)[0] for item in northbound)
    southbound_hosts = tuple(item.removeprefix("ssl:").rsplit(":", 1)[0] for item in southbound)
    if control_hosts != northbound_hosts or northbound_hosts != southbound_hosts:
        fail("ovn.control_db, ovn.northbound, and ovn.southbound must use the same ordered voter set")
    return Connections(
        northbound=northbound,
        southbound=southbound,
        ca=tls_path(ovn.get("tls_ca"), "tls_ca"),
        cert=tls_path(ovn.get("tls_cert"), "tls_cert"),
        key=tls_path(ovn.get("tls_key"), "tls_key"),
    )


def terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def run_bounded(
    arguments: list[str], timeout: float = COMMAND_TIMEOUT_SECONDS
) -> str:
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    for key in (
        "OVN_NB_DB",
        "OVN_NBCTL_OPTIONS",
        "OVN_NB_DAEMON",
        "OVN_SB_DB",
        "OVN_SBCTL_OPTIONS",
        "OVN_SB_DAEMON",
        "DPKG_ROOT",
        "DPKG_ADMINDIR",
    ):
        environment.pop(key, None)
    try:
        process = subprocess.Popen(
            arguments,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            start_new_session=True,
        )
    except OSError as error:
        fail(f"cannot execute {arguments[0]}: {error}")
    assert process.stdout is not None
    assert process.stderr is not None
    selector = selectors.DefaultSelector()
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    deadline = time.monotonic() + timeout
    try:
        for label, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, label)
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail(f"command timed out after {timeout}s: {arguments[0]}")
            for key, _events in selector.select(min(remaining, 0.25)):
                label = key.data
                try:
                    chunk = os.read(key.fileobj.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    key.fileobj.close()
                    continue
                buffers[label].extend(chunk)
                if len(buffers["stdout"]) + len(buffers["stderr"]) > MAX_COMMAND_OUTPUT:
                    fail(f"command output exceeds {MAX_COMMAND_OUTPUT} bytes: {arguments[0]}")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail(f"command timed out after {timeout}s: {arguments[0]}")
        returncode = process.wait(timeout=remaining)
        try:
            stdout = buffers["stdout"].decode("utf-8")
            stderr = buffers["stderr"].decode("utf-8")
        except UnicodeError:
            fail(f"command returned invalid UTF-8: {arguments[0]}")
        if returncode != 0:
            detail = stderr.strip() or stdout.strip() or f"exit {returncode}"
            fail(f"command failed: {arguments[0]}: {detail}")
        return stdout
    except subprocess.TimeoutExpired:
        fail(f"command timed out after {timeout}s: {arguments[0]}")
    finally:
        terminate(process)
        selector.close()


def command_timeout(deadline: float | None) -> float:
    if deadline is None:
        return COMMAND_TIMEOUT_SECONDS
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        fail("northd readiness deadline expired")
    return min(COMMAND_TIMEOUT_SECONDS, remaining)


def one_line(
    arguments: list[str], label: str, deadline: float | None = None
) -> str:
    output = run_bounded(arguments, command_timeout(deadline))
    lines = output.splitlines()
    if len(lines) != 1 or output != lines[0] + "\n":
        fail(f"{label} returned a malformed response")
    return lines[0]


def cfg_value(
    arguments: list[str], label: str, deadline: float | None = None
) -> int:
    value = one_line(arguments, label, deadline)
    if not re.fullmatch(r"0|[1-9][0-9]*", value):
        fail(f"{label} is not a canonical non-negative integer")
    parsed = int(value)
    if parsed > MAX_CFG:
        fail(f"{label} exceeds signed 64-bit range")
    return parsed


@dataclass(frozen=True)
class Status:
    role: str
    nb_cfg: int
    nb_sb_cfg: int
    sb_nb_cfg: int

    @property
    def synchronized(self) -> bool:
        return self.nb_cfg == self.nb_sb_cfg and self.nb_cfg == self.sb_nb_cfg


def check_local_status(deadline: float | None = None) -> str:
    run_bounded(
        [SYSTEMCTL, "is-active", "--quiet", "ovn-northd.service"],
        command_timeout(deadline),
    )
    nb_connection = one_line(
        [OVN_APPCTL, "-t", "ovn-northd", "nb-connection-status"],
        "northd NB connection status",
        deadline,
    )
    sb_connection = one_line(
        [OVN_APPCTL, "-t", "ovn-northd", "sb-connection-status"],
        "northd SB connection status",
        deadline,
    )
    if nb_connection != "connected" or sb_connection != "connected":
        fail(
            "northd database connection is incomplete: "
            f"NB={nb_connection!r} SB={sb_connection!r}"
        )
    raw_status = one_line(
        [OVN_APPCTL, "-t", "ovn-northd", "status"],
        "northd role status",
        deadline,
    )
    if raw_status not in {"Status: active", "Status: standby"}:
        fail(f"northd reported an invalid active/standby status: {raw_status!r}")
    return raw_status.removeprefix("Status: ")


def observe_status(
    config: Connections, deadline: float | None = None
) -> Status:
    role = check_local_status(deadline)
    nb_base = [
        OVN_NBCTL,
        "--timeout=10",
        f"--db={config.northbound_db}",
        *config.tls_options,
    ]
    sb_base = [
        OVN_SBCTL,
        "--timeout=10",
        f"--db={config.southbound_db}",
        *config.tls_options,
    ]
    nb_cfg = cfg_value(
        [*nb_base, "get", "NB_Global", ".", "nb_cfg"],
        "NB_Global.nb_cfg",
        deadline,
    )
    nb_sb_cfg = cfg_value(
        [*nb_base, "get", "NB_Global", ".", "sb_cfg"],
        "NB_Global.sb_cfg",
        deadline,
    )
    sb_nb_cfg = cfg_value(
        [*sb_base, "get", "SB_Global", ".", "nb_cfg"],
        "SB_Global.nb_cfg",
        deadline,
    )
    return Status(
        role=role,
        nb_cfg=nb_cfg,
        nb_sb_cfg=nb_sb_cfg,
        sb_nb_cfg=sb_nb_cfg,
    )


def synchronization_error(status: Status) -> str:
    return (
        "northd configuration synchronization is incomplete: "
        f"NB_Global.nb_cfg={status.nb_cfg} "
        f"NB_Global.sb_cfg={status.nb_sb_cfg} "
        f"SB_Global.nb_cfg={status.sb_nb_cfg}"
    )


def check_status(
    config: Connections, deadline: float | None = None
) -> Status:
    status = observe_status(config, deadline)
    if not status.synchronized:
        fail(synchronization_error(status))
    return status


def validate_restart_directory(metadata: os.stat_result) -> None:
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        fatal(f"restart state must be a real directory: {RESTART_STATE_DIRECTORY}")
    if (
        metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        fatal(
            "restart state must be root:root mode 0700: "
            f"{RESTART_STATE_DIRECTORY}"
        )


def validate_restart_marker(metadata: os.stat_result) -> None:
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        fatal(f"restart marker must be a regular non-symlink file: {RESTART_MARKER}")
    if metadata.st_nlink != 1:
        fatal(f"restart marker must have exactly one hard link: {RESTART_MARKER}")
    if (
        metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        fatal(f"restart marker must be root:root mode 0600: {RESTART_MARKER}")
    if metadata.st_size > MAX_MARKER_BYTES:
        fatal(f"restart marker exceeds {MAX_MARKER_BYTES} bytes: {RESTART_MARKER}")


def read_restart_marker() -> str | None:
    try:
        directory_before = RESTART_STATE_DIRECTORY.lstat()
    except FileNotFoundError:
        return None
    except OSError as error:
        fatal(f"cannot inspect restart state {RESTART_STATE_DIRECTORY}: {error}")
    validate_restart_directory(directory_before)
    directory_identity = (directory_before.st_dev, directory_before.st_ino)
    directory_flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_DIRECTORY"):
        directory_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    try:
        directory_descriptor = os.open(RESTART_STATE_DIRECTORY, directory_flags)
    except OSError as error:
        fatal(f"cannot open restart state {RESTART_STATE_DIRECTORY}: {error}")
    try:
        directory_opened = os.fstat(directory_descriptor)
        validate_restart_directory(directory_opened)
        if (directory_opened.st_dev, directory_opened.st_ino) != directory_identity:
            fatal(f"restart state changed identity: {RESTART_STATE_DIRECTORY}")
        try:
            marker_before = os.stat(
                RESTART_MARKER.name,
                dir_fd=directory_descriptor,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            try:
                directory_after_missing = RESTART_STATE_DIRECTORY.lstat()
            except OSError as error:
                fatal(
                    "restart state changed while checking for its marker: "
                    f"{error}"
                )
            validate_restart_directory(directory_after_missing)
            if (
                directory_after_missing.st_dev,
                directory_after_missing.st_ino,
            ) != directory_identity:
                fatal(f"restart state changed identity: {RESTART_STATE_DIRECTORY}")
            return None
        except OSError as error:
            fatal(f"cannot inspect restart marker {RESTART_MARKER}: {error}")
        validate_restart_marker(marker_before)
        marker_identity = (marker_before.st_dev, marker_before.st_ino)
        marker_flags = os.O_RDONLY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            marker_flags |= os.O_NOFOLLOW
        try:
            marker_descriptor = os.open(
                RESTART_MARKER.name,
                marker_flags,
                dir_fd=directory_descriptor,
            )
        except OSError as error:
            fatal(f"cannot open restart marker {RESTART_MARKER}: {error}")
        try:
            marker_opened = os.fstat(marker_descriptor)
            validate_restart_marker(marker_opened)
            if (marker_opened.st_dev, marker_opened.st_ino) != marker_identity:
                fatal(f"restart marker changed identity: {RESTART_MARKER}")
            chunks: list[bytes] = []
            size = 0
            while True:
                chunk = os.read(
                    marker_descriptor,
                    min(4096, MAX_MARKER_BYTES + 1 - size),
                )
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
                if size > MAX_MARKER_BYTES:
                    fatal(
                        f"restart marker exceeds {MAX_MARKER_BYTES} bytes: "
                        f"{RESTART_MARKER}"
                    )
            marker_after = os.stat(
                RESTART_MARKER.name,
                dir_fd=directory_descriptor,
                follow_symlinks=False,
            )
            validate_restart_marker(marker_after)
            if (marker_after.st_dev, marker_after.st_ino) != marker_identity:
                fatal(f"restart marker changed while being read: {RESTART_MARKER}")
        except OSError as error:
            fatal(f"cannot read restart marker {RESTART_MARKER}: {error}")
        finally:
            os.close(marker_descriptor)
        try:
            path_after = RESTART_MARKER.lstat()
            directory_after = RESTART_STATE_DIRECTORY.lstat()
        except OSError as error:
            fatal(f"restart marker path changed while being read: {error}")
        validate_restart_marker(path_after)
        validate_restart_directory(directory_after)
        if (path_after.st_dev, path_after.st_ino) != marker_identity:
            fatal(f"restart marker path changed identity: {RESTART_MARKER}")
        if (directory_after.st_dev, directory_after.st_ino) != directory_identity:
            fatal(f"restart state changed identity: {RESTART_STATE_DIRECTORY}")
    finally:
        os.close(directory_descriptor)
    try:
        raw = b"".join(chunks).decode("ascii")
    except UnicodeError as error:
        fatal(f"restart marker is not ASCII: {RESTART_MARKER}: {error}")
    lines = raw.splitlines()
    if len(lines) != 1 or raw != lines[0] + "\n":
        fatal(f"restart marker must contain exactly one version line: {RESTART_MARKER}")
    version = lines[0]
    if not re.fullmatch(r"[A-Za-z0-9.+:~_-]{1,128}", version):
        fatal(f"restart marker contains an unsafe version: {RESTART_MARKER}")
    return version


def installed_package_version(deadline: float | None = None) -> str:
    try:
        output = run_bounded(
            [
                DPKG_QUERY,
                "-W",
                "-f=${Status}\\t${Version}\\n",
                "pvn-node",
            ],
            command_timeout(deadline),
        )
    except NorthdError as error:
        fatal(f"cannot verify the installed pvn-node version: {error}")
    match = re.fullmatch(
        r"install ok installed\t([A-Za-z0-9.+:~_-]{1,128})\n",
        output,
    )
    if match is None:
        fatal("dpkg-query returned an invalid installed pvn-node record")
    return match.group(1)


def transition_marker_matches(deadline: float | None = None) -> bool:
    marker_version = read_restart_marker()
    if marker_version is None:
        return False
    installed_version = installed_package_version(deadline)
    if marker_version != installed_version:
        fatal(
            "restart marker does not match installed pvn-node: "
            f"marker={marker_version!r} installed={installed_version!r}"
        )
    return True


def transition_standby_ready(
    config: Connections,
    status: Status,
    deadline: float | None = None,
) -> bool:
    if len(config.northbound) < 3 or status.role != "standby":
        return False
    if not transition_marker_matches(deadline):
        return False
    # Close the useful race window between observing a standby and accepting
    # transition-only readiness.  A role change to active returns to the
    # strict cfg gate on the next wait iteration.
    if check_local_status(deadline) != "standby":
        return False
    if not transition_marker_matches(deadline):
        return False
    return check_local_status(deadline) == "standby"


def start(config: Connections) -> "NoReturn":
    if NORTHD_DB_PARAMS.exists() or NORTHD_DB_PARAMS.is_symlink():
        fail(
            f"unsupported ovn-northd DB parameter override exists: {NORTHD_DB_PARAMS}"
        )
    arguments = [
        OVN_CTL,
        "start_northd",
        "--ovn-manage-ovsdb=no",
        "--no-monitor",
        f"--ovn-northd-nb-db={config.northbound_db}",
        f"--ovn-northd-sb-db={config.southbound_db}",
        f"--ovn-northd-ssl-key={config.key}",
        f"--ovn-northd-ssl-cert={config.cert}",
        f"--ovn-northd-ssl-ca-cert={config.ca}",
        "--ovn-northd-ssl-protocols=TLSv1.2,TLSv1.3",
    ]
    try:
        os.execv(OVN_CTL, arguments)
    except OSError as error:
        fail(f"cannot execute {OVN_CTL}: {error}")


def emit_status(status: Status) -> None:
    print(
        "PVN_NORTHD "
        f"role={status.role} nb=connected sb=connected cfg={status.nb_cfg}"
    )


def emit_transition_status(status: Status) -> None:
    print(
        "PVN_NORTHD "
        f"role={status.role} nb=connected sb=connected "
        "cfg=pending transition=central-restart-pending"
    )


def wait_ready(config: Connections) -> None:
    deadline = time.monotonic() + WAIT_SECONDS
    last_error = "northd readiness has not been checked"
    while True:
        try:
            status = observe_status(config, deadline)
            if status.synchronized:
                emit_status(status)
                return
            if transition_standby_ready(config, status, deadline):
                emit_transition_status(status)
                return
            fail(synchronization_error(status))
        except FatalNorthdError:
            raise
        except NorthdError as error:
            last_error = str(error)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail(f"northd did not converge within {WAIT_SECONDS}s: {last_error}")
        time.sleep(min(WAIT_INTERVAL_SECONDS, remaining))


def main(arguments: list[str]) -> int:
    if os.geteuid() != 0:
        fail("pvn-ovn-northd must run as root")
    if len(arguments) != 1 or arguments[0] not in {"start", "status", "wait"}:
        fail("usage: pvn-ovn-northd {start|status|wait}")
    config = connections()
    if arguments[0] == "start":
        start(config)
    if arguments[0] == "status":
        emit_status(check_status(config))
        return 0
    wait_ready(config)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except NorthdError as error:
        print(f"pvn-ovn-northd: {error}", file=sys.stderr)
        raise SystemExit(1)
