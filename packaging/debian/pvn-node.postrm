#!/bin/sh
set -eu

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -x /usr/lib/pvn/pvn-ui-inject ]; then
        /usr/lib/pvn/pvn-ui-inject remove || true
    fi
    systemctl unmask ovn-host.service ovn-central.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
